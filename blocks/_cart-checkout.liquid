{% assign bl_stts = block.settings %}

<div
  class="cart-checkout cart-checkout--3d spacing-style {{ bl_stts.alignment }}"
  style="{% render 'spacing-style', settings: bl_stts %}"
  {{ block.shopify_attributes }}
>
  {% render 'cart-checkout' %}
</div>

<style>
  /* =========================================================
     UNIVERSes RAW
     PRIMARY 3D LUXURY CHECKOUT CTA
     ========================================================= */

  .cart-checkout--3d {
    --cta-front: #2b2723;
    --cta-front-hover: #332e29;
    --cta-depth: #171411;
    --cta-text: #f7f3ec;
    --cta-accent: #b89a6a;
  }

  /* =========================================================
     PRIMARY BUTTON
     ========================================================= */

  .cart-checkout--3d .cart__checkout-button,
  .cart-checkout--3d .cart__checkout,
  .cart-checkout--3d button[name="checkout"],
  .cart-checkout--3d input[name="checkout"],
  .cart-checkout--3d .checkout-button {

    position: relative;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    width: 100% !important;

    min-height: 56px !important;
    height: 56px !important;

    padding: 0 30px !important;
    margin: 0 0 5px 0 !important;

    background: var(--cta-front) !important;

    color: var(--cta-text) !important;

    border: 1px solid rgba(184,154,106,.42) !important;

    border-radius: 3px !important;

    font-family: inherit !important;
    font-size: 10px !important;
    font-weight: 600 !important;

    line-height: 1 !important;

    letter-spacing: .19em !important;
    text-transform: uppercase !important;

    text-decoration: none !important;

    cursor: pointer !important;

    overflow: visible !important;

    transform: translateY(0);

    box-shadow:
      0 5px 0 var(--cta-depth),
      0 8px 18px rgba(0,0,0,.13),
      inset 0 1px 0 rgba(255,255,255,.09),
      inset 0 -1px 0 rgba(0,0,0,.35) !important;

    transition:
      transform .18s cubic-bezier(.22,1,.36,1),
      background-color .22s ease,
      border-color .22s ease,
      box-shadow .22s ease !important;
  }


  /* =========================================================
     TOP EDGE — SUBTLE METALLIC DETAIL
     ========================================================= */

  .cart-checkout--3d .cart__checkout-button::before,
  .cart-checkout--3d .cart__checkout::before,
  .cart-checkout--3d button[name="checkout"]::before,
  .cart-checkout--3d input[name="checkout"]::before,
  .cart-checkout--3d .checkout-button::before {

    content: "";

    position: absolute;

    top: 0;
    left: 10px;
    right: 10px;

    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(184,154,106,.7),
        transparent
      );

    opacity: .8;

    pointer-events: none;
  }


  /* =========================================================
     INNER HIGHLIGHT
     ========================================================= */

  .cart-checkout--3d .cart__checkout-button::after,
  .cart-checkout--3d .cart__checkout::after,
  .cart-checkout--3d button[name="checkout"]::after,
  .cart-checkout--3d input[name="checkout"]::after,
  .cart-checkout--3d .checkout-button::after {

    content: "";

    position: absolute;

    inset: 1px;

    border-radius: 2px;

    border-top: 1px solid rgba(255,255,255,.06);

    pointer-events: none;
  }


  /* =========================================================
     HOVER
     ========================================================= */

  .cart-checkout--3d .cart__checkout-button:hover,
  .cart-checkout--3d .cart__checkout:hover,
  .cart-checkout--3d button[name="checkout"]:hover,
  .cart-checkout--3d input[name="checkout"]:hover,
  .cart-checkout--3d .checkout-button:hover {

    background: var(--cta-front-hover) !important;

    border-color: rgba(184,154,106,.7) !important;

    transform: translateY(-1px) !important;

    box-shadow:
      0 6px 0 var(--cta-depth),
      0 11px 24px rgba(0,0,0,.17),
      inset 0 1px 0 rgba(255,255,255,.11),
      inset 0 -1px 0 rgba(0,0,0,.35) !important;
  }


  /* =========================================================
     PRESS / CLICK
     ========================================================= */

  .cart-checkout--3d .cart__checkout-button:active,
  .cart-checkout--3d .cart__checkout:active,
  .cart-checkout--3d button[name="checkout"]:active,
  .cart-checkout--3d input[name="checkout"]:active,
  .cart-checkout--3d .checkout-button:active {

    transform: translateY(4px) !important;

    box-shadow:
      0 1px 0 var(--cta-depth),
      0 3px 8px rgba(0,0,0,.12),
      inset 0 1px 2px rgba(0,0,0,.22) !important;
  }


  /* =========================================================
     BUTTON TEXT
     ========================================================= */

  .cart-checkout--3d .cart__checkout-button span,
  .cart-checkout--3d .cart__checkout span,
  .cart-checkout--3d button[name="checkout"] span,
  .cart-checkout--3d .checkout-button span {

    position: relative;

    z-index: 3;
  }


  /* =========================================================
     FOCUS
     ========================================================= */

  .cart-checkout--3d .cart__checkout-button:focus-visible,
  .cart-checkout--3d .cart__checkout:focus-visible,
  .cart-checkout--3d button[name="checkout"]:focus-visible,
  .cart-checkout--3d input[name="checkout"]:focus-visible,
  .cart-checkout--3d .checkout-button:focus-visible {

    outline: 1px solid var(--cta-accent) !important;

    outline-offset: 4px !important;
  }


  /* =========================================================
     DISABLED
     ========================================================= */

  .cart-checkout--3d .cart__checkout-button:disabled,
  .cart-checkout--3d .cart__checkout:disabled,
  .cart-checkout--3d button[name="checkout"]:disabled,
  .cart-checkout--3d input[name="checkout"]:disabled,
  .cart-checkout--3d .checkout-button[disabled] {

    opacity: .45 !important;

    cursor: not-allowed !important;

    transform: none !important;

    box-shadow:
      0 2px 0 var(--cta-depth) !important;
  }


  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 749px) {

    .cart-checkout--3d .cart__checkout-button,
    .cart-checkout--3d .cart__checkout,
    .cart-checkout--3d button[name="checkout"],
    .cart-checkout--3d input[name="checkout"],
    .cart-checkout--3d .checkout-button {

      min-height: 54px !important;
      height: 54px !important;

      margin-bottom: 5px !important;

      padding: 0 22px !important;

      font-size: 9px !important;

      letter-spacing: .17em !important;
    }
  }


  /* =========================================================
     SMALL MOBILE
     ========================================================= */

  @media screen and (max-width: 380px) {

    .cart-checkout--3d .cart__checkout-button,
    .cart-checkout--3d .cart__checkout,
    .cart-checkout--3d button[name="checkout"],
    .cart-checkout--3d input[name="checkout"],
    .cart-checkout--3d .checkout-button {

      min-height: 52px !important;
      height: 52px !important;

      padding-left: 18px !important;
      padding-right: 18px !important;

      font-size: 8.5px !important;
    }
  }


  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    .cart-checkout--3d .cart__checkout-button,
    .cart-checkout--3d .cart__checkout,
    .cart-checkout--3d button[name="checkout"],
    .cart-checkout--3d input[name="checkout"],
    .cart-checkout--3d .checkout-button {

      transition: none !important;
    }
  }
</style>


{% schema %}
{
  "name": "t:names.cart_checkout",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.cart_checkout"
    }
  ]
}
{% endschema %}