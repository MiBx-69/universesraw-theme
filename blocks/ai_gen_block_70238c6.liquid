{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-badges-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background: {{ block.settings.background_color }};
  }

  .ai-trust-badges-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-trust-badges-list-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    gap: {{ block.settings.gap_desktop }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-trust-badge-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    background: {{ block.settings.badge_background }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    order: 0;
  }

  .ai-trust-badge-item-{{ ai_gen_id }}[data-badge="5"] {
    order: 3;
  }

  .ai-trust-badge-item-{{ ai_gen_id }}[data-badge="1"] {
    order: {{ block.settings.badge_1_order }};
  }

  .ai-trust-badge-item-{{ ai_gen_id }}[data-badge="2"] {
    order: {{ block.settings.badge_2_order }};
  }

  .ai-trust-badge-item-{{ ai_gen_id }}[data-badge="3"] {
    order: {{ block.settings.badge_3_order }};
  }

  .ai-trust-badge-item-{{ ai_gen_id }}[data-badge="4"] {
    order: {{ block.settings.badge_4_order }};
  }

  {% if block.settings.enable_hover_effect %}
    .ai-trust-badge-item-{{ ai_gen_id }}::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0) 100%);
      opacity: 0;
      transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .ai-trust-badge-item-{{ ai_gen_id }}:hover::before {
      opacity: 1;
    }

    .ai-trust-badge-item-{{ ai_gen_id }}:hover {
      transform: translateY(-1px);
      border-color: {{ block.settings.border_hover_color }};
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    }
  {% endif %}

  .ai-trust-badge-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    position: relative;
    z-index: 1;
  }

  .ai-trust-badge-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke-width: {{ block.settings.icon_stroke_width }};
  }

  .ai-trust-badge-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    color: {{ block.settings.text_color }};
    line-height: 1.4;
    white-space: nowrap;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-badges-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-trust-badges-list-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'grid' %}
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: {{ block.settings.gap_mobile }}px;
      {% elsif block.settings.mobile_layout == 'scroll' %}
        flex-wrap: nowrap;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        gap: {{ block.settings.gap_mobile }}px;
        padding-bottom: 4px;
      {% else %}
        gap: {{ block.settings.gap_mobile }}px;
      {% endif %}
    }

    {% if block.settings.mobile_layout == 'scroll' %}
      .ai-trust-badges-list-{{ ai_gen_id }}::-webkit-scrollbar {
        display: none;
      }

      .ai-trust-badge-item-{{ ai_gen_id }} {
        flex-shrink: 0;
      }
    {% endif %}

    .ai-trust-badge-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .ai-trust-badge-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .ai-trust-badge-item-{{ ai_gen_id }} {
      padding: {{ block.settings.badge_padding_vertical_mobile }}px {{ block.settings.badge_padding_horizontal_mobile }}px;
    }
  }
{% endstyle %}

<trust-badges-{{ ai_gen_id }} class="ai-trust-badges-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-badges-container-{{ ai_gen_id }}">
    <ul class="ai-trust-badges-list-{{ ai_gen_id }}" role="list">
      {% if block.settings.badge_1_enabled %}
        <li class="ai-trust-badge-item-{{ ai_gen_id }}" data-badge="1">
          <div class="ai-trust-badge-icon-{{ ai_gen_id }}" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
            </svg>
          </div>
          <span class="ai-trust-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_1_text }}</span>
        </li>
      {% endif %}

      {% if block.settings.badge_2_enabled %}
        <li class="ai-trust-badge-item-{{ ai_gen_id }}" data-badge="2">
          <div class="ai-trust-badge-icon-{{ ai_gen_id }}" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
            </svg>
          </div>
          <span class="ai-trust-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_2_text }}</span>
        </li>
      {% endif %}

      {% if block.settings.badge_5_enabled %}
        <li class="ai-trust-badge-item-{{ ai_gen_id }}" data-badge="5">
          <div class="ai-trust-badge-icon-{{ ai_gen_id }}" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
          </div>
          <span class="ai-trust-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_5_text }}</span>
        </li>
      {% endif %}

      {% if block.settings.badge_3_enabled %}
        <li class="ai-trust-badge-item-{{ ai_gen_id }}" data-badge="3">
          <div class="ai-trust-badge-icon-{{ ai_gen_id }}" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 4.5h7.5m-7.5 0a1.5 1.5 0 00-1.5 1.5v.75m9 0V6a1.5 1.5 0 00-1.5-1.5m0 0h-7.5" />
