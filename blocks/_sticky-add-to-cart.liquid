{% comment %}
  UNIVERSes RAW — Premium Sticky Add To Cart
  Shopify-native product form
  Responsive / mobile optimized
  Premium minimal UI
{% endcomment %}

{% liquid
  assign product_resource = product

  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif

  assign product_form_id = 'product-form-' | append: section.id

  assign color_scheme = section.settings.color_scheme

  assign content_gap = block.settings.content_gap | append: 'px'
  assign action_gap = block.settings.action_gap | append: 'px'

  assign type_preset = block.settings.type_preset

  assign pl = block.settings.padding_left
  assign pr = block.settings.padding_right
  assign pt = block.settings.padding_top
  assign pb = block.settings.padding_bottom

  assign variant_alignment = block.settings.variant_alignment

  assign style_class = block.settings.style_class

  assign sticky_width = block.settings.sticky_width
  assign sticky_pos_bottom = block.settings.sticky_pos_bottom

  assign shadow_horizontal_offset = block.settings.shadow_horizontal_offset
  assign shadow_vertical_offset = block.settings.shadow_vertical_offset
  assign shadow_blur = block.settings.shadow_blur
  assign shadow_spread_radius = block.settings.shadow_spread_radius
  assign shadow_color = block.settings.shadow_color

  assign button_type = block.settings.button_type
  assign icon = block.settings.icon
  assign icon_custom = block.settings.icon_custom
  assign svg_upload = block.settings.svg_upload
  assign image_upload = block.settings.image_upload
  assign width = block.settings.width

  assign icon_block_class = 'icon-block__media icon-block_' | append: icon | append: ' icon-block-' | append: block.id
%}


{%- capture sticky_attr -%}
  style="
    --sticky-width: {{ sticky_width }}%;
    --sticky-pos-bottom: {{ sticky_pos_bottom }}px;
    --shadow-horizontal-offset: {{ shadow_horizontal_offset }}px;
    --shadow-vertical-offset: {{ shadow_vertical_offset }}px;
    --shadow-blur: {{ shadow_blur }}px;
    --shadow-spread-radius: {{ shadow_spread_radius }}px;
    --shadow-color: {{ shadow_color }};

    {% if block.settings.inherit_color_scheme == false %}
      {% render 'color-scheme-style', settings: block.settings %}
    {% endif %}
  "
{%- endcapture -%}


{%- capture attr -%}
  style="
    {% if pl != 0 %}--pl:{{ pl }}px;{% endif %}
    {% if pt != 0 %}--pt:{{ pt }}px;{% endif %}
    {% if pb != 0 %}--pb:{{ pb }}px;{% endif %}
    {% if pr != 0 %}--pr:{{ pr }}px;{% endif %}
  "
{%- endcapture -%}


<style>

/* ============================================================
   UNIVERSes RAW
   PREMIUM STICKY ADD TO CART
   ============================================================ */

.sticky-atc {

  --ur-sticky-bg: #ffffff;
  --ur-sticky-text: #111111;
  --ur-sticky-border: rgba(17,17,17,.10);
  --ur-sticky-button: #111111;
  --ur-sticky-button-hover: #292929;

  position: fixed;

  left: 0;
  right: 0;
  bottom: var(--sticky-pos-bottom, 0px);

  z-index: 999;

  width: 100%;

  background: var(--ur-sticky-bg);

  color: var(--ur-sticky-text);

  border-top: 1px solid var(--ur-sticky-border);

  box-shadow:
    0 -8px 30px rgba(0,0,0,.06);

  isolation: isolate;

  transform: translateZ(0);

  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
}


/* ============================================================
   MAIN WRAPPER
   ============================================================ */

.sticky-atc .section--page-width {

  width: 100%;

  max-width: 1440px;

  margin: 0 auto;

  padding-left: 28px;
  padding-right: 28px;
}


/* ============================================================
   CONTENT
   ============================================================ */

.sticky-atc__wrapper {

  min-height: 78px;

  gap: 24px;

  padding-top: 10px;
  padding-bottom: 10px;
}


/* ============================================================
   PRODUCT INFO
   ============================================================ */

.sticky-atc__content {

  min-width: 0;

  flex: 1 1 auto;

  gap: var(--gap, 24px);
}


.sticky-atc__media {

  width: 52px;
  height: 52px;

  flex: 0 0 52px;

  overflow: hidden;

  background: #f5f5f5;
}


.sticky-atc__media img {

  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}


.sticky-atc__info {

  min-width: 0;
}


.sticky-atc__title {

  margin-bottom: 5px;

  overflow: hidden;

  white-space: nowrap;

  text-overflow: ellipsis;
}


.sticky-atc__title span {

  color: #111;

  font-size: 12px;

  font-weight: 600;

  letter-spacing: .08em;

  line-height: 1.2;

  text-transform: uppercase;
}


.sticky-atc__price {

  color: rgba(17,17,17,.68);

  font-size: 13px;
}


.sticky-atc__price .price {

  font-size: 13px;

  font-weight: 500;
}


/* ============================================================
   VARIANT AREA
   ============================================================ */

.sticky-atc__variant {

  background: #fff;

  border-bottom: 1px solid var(--ur-sticky-border);
}


.sticky-atc__variant .section {

  padding-top: 10px;
  padding-bottom: 10px;
}


/* ============================================================
   ACTION
   ============================================================ */

.sticky-atc__action {

  flex: 0 0 auto;

  min-width: 330px;
}


.sticky-cart__button {

  width: 100%;
}


.sticky-cart__button > .md\:flex {

  width: 100%;
}


/* ============================================================
   QUANTITY
   ============================================================ */

.sticky-cart__quantity {

  flex: 0 0 auto;
}


.sticky-cart__quantity .quantity {

  min-height: 50px;

  display: flex;

  align-items: center;

  border: 1px solid rgba(17,17,17,.15);

  background: #fff;
}


.sticky-cart__quantity .quantity__button {

  width: 42px;
  height: 50px;

  display: flex;

  align-items: center;
  justify-content: center;

  border: 0;

  background: transparent;

  color: #111;

  cursor: pointer;
}


.sticky-cart__quantity .quantity__button:hover {

  background: #f5f5f5;
}


.sticky-cart__quantity .quantity__input {

  width: 42px;

  height: 50px;

  padding: 0;

  border: 0;

  background: transparent;

  color: #111;

  text-align: center;

  font-size: 12px;

  font-weight: 600;
}


.sticky-cart__quantity .svg-wrapper {

  width: 14px;
  height: 14px;
}


.sticky-cart__quantity svg {

  width: 14px;
  height: 14px;
}


/* ============================================================
   PREMIUM ADD TO CART
   ============================================================ */

.sticky-atc
#StickyCart-ProductSubmitButton-{{ section.id }} {

  position: relative;

  min-height: 50px;

  min-width: 220px;

  padding: 0 28px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 10px;

  border: 1px solid var(--ur-sticky-button);

  border-radius: 0;

  background: var(--ur-sticky-button);

  color: #fff;

  font-family: inherit;

  font-size: 11px;

  font-weight: 600;

  letter-spacing: .15em;

  line-height: 1;

  text-transform: uppercase;

  cursor: pointer;

  overflow: hidden;

  transition:
    background .25s ease,
    border-color .25s ease,
    transform .25s ease,
    box-shadow .25s ease;
}


/* Shine */

.sticky-atc
#StickyCart-ProductSubmitButton-{{ section.id }}::before {

  content: "";

  position: absolute;

  top: 0;
  left: -120%;

  width: 55%;
  height: 100%;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,.15),
      transparent
    );

  transform: skewX(-20deg);

  transition: left .65s ease;

  pointer-events: none;
}


.sticky-atc
#StickyCart-ProductSubmitButton-{{ section.id }}:hover::before {

  left: 140%;
}


/* Hover */

.sticky-atc
#StickyCart-ProductSubmitButton-{{ section.id }}:hover {

  background: var(--ur-sticky-button-hover);

  border-color: var(--ur-sticky-button-hover);

  transform: translateY(-1px);

  box-shadow:
    0 8px 20px rgba(0,0,0,.13);
}


/* Active */

.sticky-atc
#StickyCart-ProductSubmitButton-{{ section.id }}:active {

  transform: translateY(0);

  box-shadow: none;
}


/* Disabled */

.sticky-atc
#StickyCart-ProductSubmitButton-{{ section.id }}:disabled {

  background: #e8e8e8;

  border-color: #e8e8e8;

  color: #777;

  cursor: not-allowed;

  transform: none;

  box-shadow: none;
}


/* ============================================================
   BUTTON TEXT
   ============================================================ */

.sticky-atc
.add-to-cart-text {

  position: relative;

  z-index: 2;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  white-space: nowrap;
}


/* ============================================================
   LOADING
   ============================================================ */

.sticky-atc
#StickyCart-ProductSubmitButton-{{ section.id }}
.loading {

  pointer-events: none;

  opacity: .75;
}


/* ============================================================
   CHOOSE OPTIONS
   ============================================================ */

.sticky-atc
.button-toggle-variants {

  min-height: 50px;

  margin-top: 8px;

  border: 1px solid #111;

  border-radius: 0;

  background: #fff;

  color: #111;

  font-size: 10px;

  font-weight: 600;

  letter-spacing: .14em;

  text-transform: uppercase;
}


.sticky-atc
.button-toggle-variants:hover {

  background: #111;

  color: #fff;
}


/* ============================================================
   ERROR
   ============================================================ */

.sticky-atc
.product-form__error-message-wrapper {

  margin-bottom: 8px;

  color: #b42318;

  font-size: 11px;
}


/* ============================================================
   JUMP TO PRODUCT
   ============================================================ */

.sticky-atc.style-jump_to_product {

  width: min(
    var(--sticky-width, 80%),
    520px
  );

  left: 50%;

  right: auto;

  transform: translateX(-50%);

  border: 1px solid rgba(17,17,17,.12);

  border-radius: 0;
}


.sticky-atc.style-jump_to_product
.icon-arrow-down {

  width: 18px;
  height: 18px;
}


.sticky-atc.style-jump_to_product
.icon-arrow-down svg {

  width: 18px;
  height: 18px;
}


/* ============================================================
   MOBILE
   ============================================================ */

@media screen and (max-width: 749px) {

  .sticky-atc {

    bottom: 0;

    padding:
      env(safe-area-inset-top, 0)
      0
      env(safe-area-inset-bottom, 0);

    box-shadow:
      0 -8px 26px rgba(0,0,0,.10);
  }


  .sticky-atc .section--page-width {

    padding-left: 14px;
    padding-right: 14px;
  }


  .sticky-atc__wrapper {

    min-height: 68px;

    gap: 10px;

    padding-top: 8px;
    padding-bottom: 8px;
  }


  /* Hide desktop product information */

  .sticky-atc__content {

    display: none !important;
  }


  .sticky-atc__action {

    width: 100%;

    min-width: 0;
  }


  .sticky-atc
  #StickyCart-ProductSubmitButton-{{ section.id }} {

    width: 100%;

    min-height: 52px;

    min-width: 0;

    padding: 0 18px;

    font-size: 10px;

    letter-spacing: .14em;
  }


  .sticky-cart__quantity {

    display: none !important;
  }


  .sticky-atc__variant {

    max-height: 48vh;

    overflow-y: auto;

    -webkit-overflow-scrolling: touch;
  }


  .sticky-atc__variant
  .section {

    padding:
      10px
      14px;
  }


  .sticky-atc.style-jump_to_product {

    width: calc(100% - 28px);

    max-width: none;
  }


  .sticky-atc.style-jump_to_product
  .sticky-atc__wrapper {

    min-height: 54px;
  }

}


/* ============================================================
   TABLET
   ============================================================ */

@media screen and (min-width: 750px) and (max-width: 1100px) {

  .sticky-atc__action {

    min-width: 300px;
  }


  .sticky-atc
  #StickyCart-ProductSubmitButton-{{ section.id }} {

    min-width: 190px;

    padding-left: 20px;
    padding-right: 20px;
  }

}


/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {

  .sticky-atc,
  .sticky-atc button,
  .sticky-atc::before {

    transition: none !important;
  }

}

</style>


<sticky-atc
  class="
    sticky-atc
    w-full
    fixed
    bottom-0
    left-0
    right-0
    z-10
    flex
    justify-between
    items-center
    style-{{ style_class }}

    {% if block.settings.inherit_color_scheme == false %}
      color-scheme-custom
    {% else %}
      color-{{ color_scheme }}
    {% endif %}
  "

  {{ sticky_attr }}

  form="{{ product_form_id }}"

  data-sticky-section-id="{{ section.id }}"

  {% if style_class == 'jump_to_product' %}
    data-jump-to-product="true"
    role="button"
    tabindex="0"
    aria-label="{{ 'accessibility.jump_to_product' | t }}"
  {% endif %}
>


  <!-- Mobile overlay -->

  <overlay-component
    class="
      overlay-component
      fixed
      inset-0
      cursor-pointer
      md:hidden
    "
    aria-controls="StickyAddToCart"
    aria-expanded="true"
  ></overlay-component>


  <!-- ========================================================
       VARIANT PICKER
       ======================================================== -->

  {% unless product.has_only_default_variant %}

    <div class="sticky-atc__variant">

      <div
        class="
          section
          section--page-width
          variant-alignment--{{ variant_alignment }}
        "
        {{ attr }}
      >

        <div class="large-up-hide medium-hide">

          <div class="sticky-atc__info">

            <div class="sticky-atc__title">

              <span class="block font-bold {{ type_preset }}">

                {{ product.title | escape }}

              </span>

            </div>


            <div class="sticky-atc__price">

              {% render
                'price',
                product: product,
                use_variant: true,
                show_badges: false,
                price_class: 'price--large'
              %}

            </div>

          </div>

        </div>


        {% render
          'variant-main-picker',
          context: 'sticky',
          product_resource: product_resource
        %}

      </div>

    </div>

  {% endunless %}


  <!-- ========================================================
       MAIN STICKY BAR
       ======================================================== -->

  <div class="section section--page-width">

    <div
      class="
        sticky-atc__wrapper
        flex
        justify-between
        items-center
        w-full
      "
      {{ attr }}
    >


      <!-- Product information -->

      <div
        class="
          sticky-atc__content
          w-full
          flex
          items-center
          small-hide
        "
        style="--gap: {{ content_gap }};"
      >

        <div class="sticky-atc__media">

          {% assign current_media =
            product.selected_or_first_available_variant.featured_media
            | default: product.featured_media
          %}


          {% if current_media != blank %}

            {{
              current_media
              | image_url: width: 96
              | image_tag:
                height: '96',
                sizes: '52px',
                widths: '96',
                loading: 'lazy',
                class: 'w-full h-auto object-cover'
            }}

          {% endif %}

        </div>


        <div class="sticky-atc__info">

          <div class="sticky-atc__title">

            <span class="block font-bold {{ type_preset }}">

              {{ product.title | escape }}

            </span>

          </div>


          <div class="sticky-atc__price">

            <product-price>

              {% render
                'price-product',
                product_resource: product,
                show_unit_price: true,
                show_sale_price_first: true
              %}

            </product-price>

          </div>

        </div>

      </div>


      {% if style_class == 'jump_to_product' %}

        <span class="svg-wrapper icon-arrow-down">

          {{- 'icon-caret.svg' | inline_asset_content -}}

        </span>


      {% else %}


        <!-- ==================================================
             PURCHASE ACTION
             ================================================== -->

        <div class="sticky-atc__action flex justify-center flex-column">


          {% liquid

            assign check_against_inventory = true

            if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'

              assign check_against_inventory = false

            endif


            if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory

              assign quantity_rule_soldout = true

            endif


            assign variant_length = product.variants | size

          %}


          <!-- Error -->

          <div
            class="product-form__error-message-wrapper"
            role="alert"
            hidden
          >

            <span class="svg-wrapper">

              {{- 'icon-error.svg' | inline_asset_content -}}

            </span>

            <span class="product-form__error-message"></span>

          </div>


          <div
            class="md:flex max-sm:w-full items-center"
            style="--gap: {{ action_gap }};"
          >


            <!-- Quantity -->

            <div
              id="StickyCart-Quantity-Form-{{ section.id }}"
              class="
                sticky-cart__quantity
                product-form__quantity
                small-hide

                {% if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}
                  disabled
                {% endif %}
              "
            >

              {% assign cart_qty =
                cart
                | item_count_for_variant:
                  product.selected_or_first_available_variant.id
              %}


              <quantity-input
                class="quantity"
                data-url="{{ product.url }}"
                data-section="{{ section.id }}"
              >

                <button
                  class="quantity__button no-js-hidden pos-relative"
                  name="minus"
                  type="button"
                >

                  <span class="visually-hidden">

                    {{-
                      'products.product.quantity.decrease'
                      | t:
                        product: product.title
                      | escape
                    -}}

                  </span>


                  <span class="svg-wrapper icon-minus">

                    {{-
                      'icon-minus.svg'
                      | inline_asset_content
                    -}}

                  </span>

                </button>


                <input
                  class="quantity__input"

                  type="number"

                  name="quantity"

                  id="Quantity-Sticky-{{ section.id }}"

                  data-cart-quantity="{{ cart_qty }}"

                  data-inventory-managed="
                    {% if product.selected_or_first_available_variant.inventory_management == 'shopify' %}
                      true
                    {% else %}
                      false
                    {% endif %}
                  "

                  {% if product.selected_or_first_available_variant.inventory_management == 'shopify' %}

                    data-inventory-quantity="{{ product.selected_or_first_available_variant.inventory_quantity }}"

                  {% endif %}

                  data-inventory-policy="{{ product.selected_or_first_available_variant.inventory_policy }}"

                  data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"

                  min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"

                  {% if product.selected_or_first_available_variant.quantity_rule.max != null %}

                    data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"

                    max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"

                  {% endif %}

                  step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"

                  value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"

                  form="{{ product_form_id }}"
                />


                <button
                  class="quantity__button no-js-hidden pos-relative"
                  name="plus"
                  type="button"
                >

                  <span class="visually-hidden">

                    {{-
                      'products.product.quantity.increase'
                      | t:
                        product: product.title
                      | escape
                    -}}

                  </span>


                  <span class="svg-wrapper icon-plus">

                    {{-
                      'icon-plus.svg'
                      | inline_asset_content
                    -}}

                  </span>

                </button>

              </quantity-input>

            </div>


            <!-- Product button -->

            {% assign product_form_sticky_id =
              'product-form-sticky-' | append: section.id
            %}


            <div
              class="sticky-cart__button w-full"
              id="{{ product_form_sticky_id }}"
            >

              {% liquid

                assign check_against_inventory = true

                if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'

                  assign check_against_inventory = false

                endif


                if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory

                  assign quantity_rule_soldout = true

                endif


                if product.selected_or_first_available_variant.inventory_quantity <= 0 and product.selected_or_first_available_variant.inventory_policy == 'continue'

                  assign check_pre_order = true

                endif

              %}


              <input
                type="hidden"
                name="id"
                value="{{ product.selected_or_first_available_variant.id }}"
                disabled
                class="product-variant-id"
              >


              <!-- Premium Add To Cart -->

              <button
                id="StickyCart-ProductSubmitButton-{{ section.id }}"

                type="submit"

                name="add"

                class="
                  product-form__submit
                  button
                  button--full-width

                  {% unless variant_length > 1 %}
                    no-variants
                  {% endunless %}

                  {% if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}
                    sold-out--button
                  {% endif %}
                "

                form="{{ product_form_id }}"

                {% if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}
                  disabled
                {% endif %}

                data-inventory-quantity="{{ product.selected_or_first_available_variant.inventory_quantity }}"

                data-inventory-policy="{{ product.selected_or_first_available_variant.inventory_policy }}"

                aria-label="
                  {% if product.selected_or_first_available_variant.available %}
                    Add {{ product.title | escape }} to cart
                  {% else %}
                    {{ 'products.product.sold_out' | t }}
                  {% endif %}
                "
              >


                {% render 'loading-spinner' %}


                {% if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}

                  <span class="add-to-cart-text whitespace-nowrap">

                    {{ 'products.product.sold_out' | t }}

                  </span>


                {% else %}


                  {% if check_pre_order %}

                    <span class="add-to-cart-text whitespace-nowrap">

                      {{ 'products.product.pre_order' | t }}

                    </span>


                  {% else %}


                    {% if button_type == 'text' %}

                      <span class="add-to-cart-text whitespace-nowrap">

                        {{ 'products.product.add_to_cart' | t }}

                      </span>


                    {% else %}

                      <span class="add-to-cart-text whitespace-nowrap">

                        {% render
                          'icon-or-image',

                          icon: icon,

                          icon_custom: icon_custom,

                          svg_upload: svg_upload,

                          image_upload: image_upload,

                          width: width,

                          class_name: icon_block_class,

                          attributes: block.shopify_attributes
                        %}

                      </span>

                    {% endif %}

                  {% endif %}

                {% endif %}

              </button>


              {% if variant_length > 1 %}

                <button
                  id="StickyCart-ProductSubmitButton-ToggleVariants-{{ section.id }}"

                  type="button"

                  class="
                    button
                    button--full-width
                    button-toggle-variants
                  "
                >

                  <span class="add-to-cart-text--choose-options whitespace-nowrap">

                    {{ 'products.product.choose_options' | t }}

                  </span>

                </button>

              {% endif %}

            </div>

          </div>

        </div>

      {% endif %}

    </div>

  </div>

</sticky-atc>


{% schema %}

{
  "name": "t:names.sticky_add_to_cart",

  "settings": [

    {
      "type": "header",
      "content": "t:content.appearance"
    },

    {
      "type": "select",
