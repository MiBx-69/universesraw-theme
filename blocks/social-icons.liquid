{%- liquid
  if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
    assign social_links = true
  endif
-%}

{%- capture class_item -%}
  list-social__item social__item--effect{% if block.settings.social_style == 'custom' %} social__item--custom{% endif %}
{%- endcapture -%}

{%- capture class_link -%}
  list-social__link{% if block.settings.social_style == 'default' %} link{% endif %}
{%- endcapture -%}

{%- capture social_style -%}
  --gap-x: {{ block.settings.gap_x }}px;
  --gap-y: {{ block.settings.gap_y }}px;

  {% if block.settings.social_style == 'custom' %}
    --social-item-size: {{ block.settings.icon_size }}px;
    --social-item-size-mobile: {{ block.settings.icon_size_mobile }}px;
    --social-item-color: {{ block.settings.icon_color }};
    --social-item-color-hover: {{ block.settings.icon_color_hover }};
    --social-item-bg-color: {{ block.settings.icon_bg_color }};
    --social-item-bg-color-hover: {{ block.settings.icon_bg_color_hover }};
    --social-item-border-color: {{ block.settings.icon_border_color }};
    --social-item-border-color-hover: {{ block.settings.icon_border_color_hover }};
  {% endif %}
{%- endcapture -%}

{%- if social_links -%}

  <link
    rel="stylesheet"
    href="{{ 'component-list-social.css' | asset_url }}"
    media="print"
    fetchpriority="low"
    onload="this.media='all'"
  >

  <noscript>
    <link
      rel="stylesheet"
      href="{{ 'component-list-social.css' | asset_url }}"
    >
  </noscript>

  <div
    class="ur-social-luxury flex flex-wrap justify-center flex-column h-full spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
  >

    <ul
      class="list-unstyled list-social list-social--{{ block.settings.social_style }} flex flex-wrap sm\:justify-center list-position-inherit{% if class %} {{ class }}{% endif %}"
      role="list"
      style="{{ social_style }}"
    >

      {%- if settings.social_twitter_link != blank -%}
        <li class="{{ class_item }}">
          <a
            href="{{ settings.social_twitter_link }}"
            class="{{ class_link }}"
            aria-label="{{ 'content.social.twitter' | t }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="svg-wrapper">
              {{- 'icon-twitter.svg' | inline_asset_content -}}
            </span>

            <span class="visually-hidden">
              {{ 'content.social.twitter' | t }}
            </span>
          </a>
        </li>
      {%- endif -%}


      {%- if settings.social_facebook_link != blank -%}
        <li class="{{ class_item }}">
          <a
            href="{{ settings.social_facebook_link }}"
            class="{{ class_link }}"
            aria-label="{{ 'content.social.facebook' | t }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="svg-wrapper">
              {{- 'icon-facebook.svg' | inline_asset_content -}}
            </span>

            <span class="visually-hidden">
              {{ 'content.social.facebook' | t }}
            </span>
          </a>
        </li>
      {%- endif -%}


      {%- if settings.social_pinterest_link != blank -%}
        <li class="{{ class_item }}">
          <a
            href="{{ settings.social_pinterest_link }}"
            class="{{ class_link }}"
            aria-label="{{ 'content.social.pinterest' | t }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="svg-wrapper">
              {{- 'icon-pinterest.svg' | inline_asset_content -}}
            </span>

            <span class="visually-hidden">
              {{ 'content.social.pinterest' | t }}
            </span>
          </a>
        </li>
      {%- endif -%}


      {%- if settings.social_instagram_link != blank -%}
        <li class="{{ class_item }}">
          <a
            href="{{ settings.social_instagram_link }}"
            class="{{ class_link }}"
            aria-label="{{ 'content.social.instagram' | t }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="svg-wrapper">
              {{- 'icon-instagram.svg' | inline_asset_content -}}
            </span>

            <span class="visually-hidden">
              {{ 'content.social.instagram' | t }}
            </span>
          </a>
        </li>
      {%- endif -%}


      {%- if settings.social_tiktok_link != blank -%}
        <li class="{{ class_item }}">
          <a
            href="{{ settings.social_tiktok_link }}"
            class="{{ class_link }}"
            aria-label="{{ 'content.social.tiktok' | t }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="svg-wrapper">
              {{- 'icon-tiktok.svg' | inline_asset_content -}}
            </span>

            <span class="visually-hidden">
              {{ 'content.social.tiktok' | t }}
            </span>
          </a>
        </li>
      {%- endif -%}


      {%- if settings.social_tumblr_link != blank -%}
        <li class="{{ class_item }}">
          <a
            href="{{ settings.social_tumblr_link }}"
            class="{{ class_link }}"
            aria-label="{{ 'content.social.tumblr' | t }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="svg-wrapper">
              {{- 'icon-tumblr.svg' | inline_asset_content -}}
            </span>

            <span class="visually-hidden">
              {{ 'content.social.tumblr' | t }}
            </span>
          </a>
        </li>
      {%- endif -%}


      {%- if settings.social_snapchat_link != blank -%}
        <li class="{{ class_item }}">
          <a
            href="{{ settings.social_snapchat_link }}"
            class="{{ class_link }}"
            aria-label="{{ 'content.social.snapchat' | t }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="svg-wrapper">
              {{- 'icon-snapchat.svg' | inline_asset_content -}}
            </span>

            <span class="visually-hidden">
              {{ 'content.social.snapchat' | t }}
            </span>
          </a>
        </li>
      {%- endif -%}


      {%- if settings.social_youtube_link != blank -%}
        <li class="{{ class_item }}">
          <a
            href="{{ settings.social_youtube_link }}"
            class="{{ class_link }}"
            aria-label="{{ 'content.social.youtube' | t }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="svg-wrapper">
              {{- 'icon-youtube.svg' | inline_asset_content -}}
            </span>

            <span class="visually-hidden">
              {{ 'content.social.youtube' | t }}
            </span>
          </a>
        </li>
      {%- endif -%}


      {%- if settings.social_vimeo_link != blank -%}
        <li class="{{ class_item }}">
          <a
            href="{{ settings.social_vimeo_link }}"
            class="{{ class_link }}"
            aria-label="{{ 'content.social.vimeo' | t }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="svg-wrapper">
              {{- 'icon-vimeo.svg' | inline_asset_content -}}
            </span>

            <span class="visually-hidden">
              {{ 'content.social.vimeo' | t }}
            </span>
          </a>
        </li>
      {%- endif -%}

    </ul>
  </div>


  <style>
    /* =========================================================
       UNIVERSes RAW
       SOCIAL ICONS
       SVG VISIBILITY + QUIET LUXURY
       ========================================================= */

    .ur-social-luxury {
      --ur-social-text: #292622;
      --ur-social-muted: rgba(41, 38, 34, .68);
      --ur-social-border: rgba(41, 38, 34, .18);
      --ur-social-accent: #a58a62;

      position: relative;
      width: 100%;
      color: var(--ur-social-text);
    }


    /* =========================================================
       SOCIAL LIST
       ========================================================= */

    .ur-social-luxury .list-social {
      display: flex !important;
      align-items: center;
      justify-content: flex-start;
      flex-wrap: wrap;

      gap: 8px !important;

      margin: 0 !important;
      padding: 0 !important;

      list-style: none !important;
    }


    /* =========================================================
       SOCIAL ITEM
       ========================================================= */

    .ur-social-luxury .list-social__item {
      display: flex !important;
      align-items: center;
      justify-content: center;

      width: auto;
      height: auto;

      margin: 0 !important;
      padding: 0 !important;
    }


    /* =========================================================
       SOCIAL BUTTON
       ========================================================= */

    .ur-social-luxury .list-social__link {
      position: relative;

      display: flex !important;
      align-items: center !important;
      justify-content: center !important;

      width: 34px !important;
      height: 34px !important;

      min-width: 34px !important;
      min-height: 34px !important;

      margin: 0 !important;
      padding: 0 !important;

      box-sizing: border-box !important;

      color: #292622 !important;
      background: #ffffff !important;

      border: 1px solid var(--ur-social-border) !important;
      border-radius: 50% !important;

      text-decoration: none !important;

      opacity: 1 !important;
      visibility: visible !important;

      overflow: hidden;

      transition:
        color .25s ease,
        background-color .25s ease,
        border-color .25s ease,
        transform .25s cubic-bezier(.22, 1, .36, 1),
        box-shadow .25s ease !important;
    }


    /* =========================================================
       SVG WRAPPER
       ========================================================= */

    .ur-social-luxury .list-social__link .svg-wrapper {
      position: relative;

      display: flex !important;
      align-items: center !important;
      justify-content: center !important;

      width: 15px !important;
      height: 15px !important;

      min-width: 15px !important;
      min-height: 15px !important;

      flex: 0 0 15px !important;

      margin: 0 !important;
      padding: 0 !important;

      color: inherit !important;

      line-height: 0 !important;

      opacity: 1 !important;
      visibility: visible !important;

      z-index: 5;
    }


    /* =========================================================
       SVG
       ========================================================= */

    .ur-social-luxury .list-social__link .svg-wrapper svg {
      display: block !important;

      position: relative !important;

      width: 15px !important;
      height: 15px !important;

      min-width: 15px !important;
      min-height: 15px !important;

      max-width: 15px !important;
      max-height: 15px !important;

      margin: 0 !important;
      padding: 0 !important;

      color: currentColor !important;
      fill: currentColor !important;

      opacity: 1 !important;
      visibility: visible !important;

      overflow: visible !important;
    }


    /* =========================================================
       SVG PATHS
       ========================================================= */

    .ur-social-luxury .list-social__link .svg-wrapper svg path {
      fill: currentColor !important;
      color: currentColor !important;

      opacity: 1 !important;
      visibility: visible !important;
    }


    /* =========================================================
       OUTLINE SVG ELEMENTS
       ========================================================= */

    .ur-social-luxury .list-social__link .svg-wrapper svg line,
    .ur-social-luxury .list-social__link .svg-wrapper svg polyline,
    .ur-social-luxury .list-social__link .svg-wrapper svg polygon,
    .ur-social-luxury .list-social__link .svg-wrapper svg circle,
    .ur-social-luxury .list-social__link .svg-wrapper svg rect {
      stroke: currentColor !important;

      opacity: 1 !important;
      visibility: visible !important;
    }


    /* =========================================================
       DEFAULT MODE
       ========================================================= */

    .ur-social-luxury .list-social--default .list-social__link {
      color: #292622 !important;
      background: #ffffff !important;

      border-color:
        rgba(41, 38, 34, .18) !important;
    }


    /* =========================================================
       HOVER
       ========================================================= */

    .ur-social-luxury .list-social__link:hover {
      color: #ffffff !important;

      background: #292622 !important;

      border-color: #292622 !important;

      transform: translateY(-2px);

      box-shadow:
        0 6px 16px rgba(37, 33, 29, .10);
    }


    .ur-social-luxury .list-social__link:hover .svg-wrapper,
    .ur-social-luxury .list-social__link:hover svg {
      color: #ffffff !important;
    }


    .ur-social-luxury .list-social__link:hover svg {
      fill: currentColor !important;

      transform: scale(1.04);
    }


    /* =========================================================
       SUBTLE HIGHLIGHT
       ========================================================= */

    .ur-social-luxury .list-social__link::before {
      content: "";

      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          135deg,
          rgba(255, 255, 255, .20),
          transparent 52%
        );

      opacity: 0;

      pointer-events: none;

      z-index: 1;

      transition:
        opacity .25s ease;
    }


    .ur-social-luxury .list-social__link:hover::before {
      opacity: 1;
    }


    /* =========================================================
       CUSTOM STYLE MODE
       ========================================================= */

    .ur-social-luxury .list-social--custom .list-social__link {
      width:
        var(--social-item-size, 34px) !important;

      height:
        var(--social-item-size, 34px) !important;

      min-width:
        var(--social-item-size, 34px) !important;

      min-height:
        var(--social-item-size, 34px) !important;

      color:
        var(--social-item-color, #292622) !important;

      background:
        var(--social-item-bg-color, #ffffff) !important;

      border-color:
        var(
          --social-item-border-color,
          rgba(41, 38, 34, .18)
        ) !important;
    }


    .ur-social-luxury .list-social--custom .list-social__link:hover {
      color:
        var(
          --social-item-color-hover,
          #ffffff
        ) !important;

      background:
        var(
          --social-item-bg-color-hover,
          #292622
        ) !important;

      border-color:
        var(
          --social-item-border-color-hover,
          #292622
        ) !important;
    }


    /* =========================================================
       REMOVE DEFAULT LINK EFFECT
       ========================================================= */

    .ur-social-luxury .list-social__link::after {
      display: none !important;
      content: none !important;
    }


    .ur-social-luxury .list-social__link.link::after {
      display: none !important;
      content: none !important;
    }


    /* =========================================================
       FOCUS
       ========================================================= */

    .ur-social-luxury .list-social__link:focus-visible {
      outline:
        1px solid var(--ur-social-accent) !important;

      outline-offset: 3px !important;
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @media screen and (max-width: 749px) {

      .ur-social-luxury .list-social {
        gap: 7px !important;
      }


      .ur-social-luxury .list-social__link {
        width: 32px !important;
        height: 32px !important;

        min-width: 32px !important;
        min-height: 32px !important;
      }


      .ur-social-luxury .list-social__link .svg-wrapper {
        width: 14px !important;
        height: 14px !important;

        min-width: 14px !important;
        min-height: 14px !important;

        flex-basis: 14px !important;
      }


      .ur-social-luxury .list-social__link .svg-wrapper svg {
        width: 14px !important;
        height: 14px !important;

        min-width: 14px !important;
        min-height: 14px !important;

        max-width: 14px !important;
        max-height: 14px !important;
      }


      .ur-social-luxury .list-social--custom .list-social__link {
        width:
          var(--social-item-size-mobile, 32px) !important;

        height:
          var(--social-item-size-mobile, 32px) !important;

        min-width:
          var(--social-item-size-mobile, 32px) !important;

        min-height:
          var(--social-item-size-mobile, 32px) !important;
      }

    }


    /* =========================================================
       REDUCED MOTION
       ========================================================= */

    @media (prefers-reduced-motion: reduce) {

      .ur-social-luxury .list-social__link,
      .ur-social-luxury .list-social__link svg,
      .ur-social-luxury .list-social__link::before {
        transition: none !important;
      }

    }

  </style>

{%- endif -%}


{% schema %}
{
  "name": "t:names.social_icons",
  "settings": [
    {
      "type": "select",
      "id": "social_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size desktop",
      "min": 24,
      "max": 120,
      "step": 6,
      "unit": "px",
      "default": 36,
      "visible_if": "{{ block.settings.social_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Icon size mobile",
      "min": 24,
      "max": 120,
      "step": 6,
      "unit": "px",
      "default": 36,
      "visible_if": "{{ block.settings.social_style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.social_style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon background color",
      "default": "#232323",
      "visible_if": "{{ block.settings.social_style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Icon border color",
      "default": "#232323",
      "visible_if": "{{ block.settings.social_style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "icon_color_hover",
      "label": "Icon color hover",
      "default": "#232323",
      "visible_if": "{{ block.settings.social_style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "icon_bg_color_hover",
      "label": "Icon background color hover",
      "default": "transparent",
      "visible_if": "{{ block.settings.social_style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "icon_border_color_hover",
      "label": "Icon border color hover",
      "default": "#232323",
      "visible_if": "{{ block.settings.social_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "gap_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10,
      "label": "t:settings.column_gap"
    },
    {
      "type": "range",
      "id": "gap_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10,
      "label": "t:settings.row_gap"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.social_icons",
      "category": "t:categories.decorative"
    }
  ]
}
{% endschema %}