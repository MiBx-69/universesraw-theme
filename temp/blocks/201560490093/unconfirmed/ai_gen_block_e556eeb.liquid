{% doc %}
  @prompt
    Fix the product card badge positioning so that the "New", "Sale", and price percentage badges are anchored to the bottom left corner of the product image. The badge should be absolutely positioned within the image container, sitting at the bottom left with small padding from the edges. The badge should be minimal, small, and premium — not bold or oversized — and should not disturb the product image. Ensure the image container has position: relative so the badge aligns correctly.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-badge-position-fix-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    height: 0;
    overflow: visible;
    position: relative;
    z-index: 10;
  }

  .ai-badge-position-fix-{{ ai_gen_id }} + .shopify-section,
  .ai-badge-position-fix-{{ ai_gen_id }} ~ .shopify-section {
    position: relative;
  }

  .ai-badge-position-fix-{{ ai_gen_id }} {
    --ai-badge-offset-x: {{ block.settings.edge_padding }}px;
    --ai-badge-offset-y: {{ block.settings.edge_padding }}px;
    --ai-badge-size: {{ block.settings.badge_size }}px;
    --ai-badge-background: {{ block.settings.badge_background }};
    --ai-badge-text: {{ block.settings.badge_text_color }};
  }

  .card-product__wrapper,
  .card-product__image-wrapper,
  .card-product .product-card__image-wrapper,
  .product-card__image-wrapper,
  .product-item__image-wrapper,
  .productGrid .product-image {
    position: relative;
  }

  .card-product__badge,
  .card-product__badges,
  .product-card__badge,
  .product-card__badges,
  .product-item__badge,
  .product-item__badges,
  .product-badge,
  .product-badges,
  .card-product .badge {
    position: absolute;
    top: auto;
    right: auto;
    bottom: var(--ai-badge-offset-y);
    left: var(--ai-badge-offset-x);
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 4px;
    max-width: calc(100% - (var(--ai-badge-offset-x) * 2));
    pointer-events: none;
  }

  .card-product__badge > *,
  .card-product__badges > *,
  .product-card__badge > *,
  .product-card__badges > *,
  .product-item__badge > *,
  .product-item__badges > *,
  .product-badge,
  .product-badges > *,
  .card-product .badge {
    display: inline-flex;
    align-items: center;
    min-height: 0;
    padding: 3px 7px;
    border: 0;
    border-radius: 0;
    background: var(--ai-badge-background);
    color: var(--ai-badge-text);
    font-size: var(--ai-badge-size);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: .08em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: none;
  }

  @media screen and (max-width: 749px) {
    .ai-badge-position-fix-{{ ai_gen_id }} {
      --ai-badge-offset-x: {{ block.settings.mobile_edge_padding }}px;
      --ai-badge-offset-y: {{ block.settings.mobile_edge_padding }}px;
      --ai-badge-size: {{ block.settings.mobile_badge_size }}px;
    }
  }
{% endstyle %}

<div class="ai-badge-position-fix-{{ ai_gen_id }}" {{ block.shopify_attributes }} aria-hidden="true"></div>

{% schema %}
{
  "name": "Product badge position",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "edge_padding",
      "label": "Edge padding",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "mobile_edge_padding",
      "label": "Mobile edge padding",
      "min": 2,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "badge_size",
      "label": "Badge text size",
      "min": 9,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_badge_size",
      "label": "Mobile text size",
      "min": 8,
      "max": 14,
      "step": 1,
      "unit": "px",
      "default": 9
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Product badge position"
    }
  ],
  "tag": null,
  "class": "product-badge-position-fix"
}
{% endschema %}