{% doc %}
  @prompt
    creat a premium luxurious minimal and high uqality collection grid for our colelction witht he colelction iamge title and best mobile first design hign end luxurious premium design with it , i want a premium high end professioanl luxurious one not a simple ordinary one one tat looks like lv rl and prmeium brand 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-luxury-collections-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin:0 auto; background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; }
  .ai-luxury-collections-{{ ai_gen_id }}__header { display:flex; align-items:flex-end; justify-content:space-between; gap:32px; padding:0 0 34px; border-bottom:1px solid {{ block.settings.border_color }}; }
  .ai-luxury-collections-{{ ai_gen_id }}__eyebrow { margin:0 0 14px; color:{{ block.settings.accent_color }}; font-size:10px; letter-spacing:.24em; text-transform:uppercase; }
  .ai-luxury-collections-{{ ai_gen_id }}__heading { margin:0; font-size:{{ block.settings.heading_size }}px; line-height:.98; letter-spacing:-.045em; font-weight:400; }
  .ai-luxury-collections-{{ ai_gen_id }}__copy { max-width:360px; margin:0; color:{{ block.settings.muted_text_color }}; font-size:13px; line-height:1.7; }
  .ai-luxury-collections-{{ ai_gen_id }}__grid { display:grid; grid-template-columns:repeat({{ block.settings.columns_desktop }},minmax(0,1fr)); gap:{{ block.settings.grid_gap }}px; padding-top:{{ block.settings.grid_gap }}px; }
  .ai-luxury-collections-{{ ai_gen_id }}__card { display:block; min-width:0; color:inherit; text-decoration:none; }
  .ai-luxury-collections-{{ ai_gen_id }}__media { position:relative; overflow:hidden; aspect-ratio:{{ block.settings.image_ratio }}; background:{{ block.settings.image_background }}; }
  .ai-luxury-collections-{{ ai_gen_id }}__media:after { content:''; position:absolute; inset:12px; border:1px solid rgba(255,255,255,.38); pointer-events:none; }
  .ai-luxury-collections-{{ ai_gen_id }}__media img,.ai-luxury-collections-{{ ai_gen_id }}__media svg { display:block; width:100%; height:100%; object-fit:cover; }
  .ai-luxury-collections-{{ ai_gen_id }}__media svg { color:{{ block.settings.muted_text_color }}; }
  .ai-luxury-collections-{{ ai_gen_id }}__number { position:absolute; z-index:1; top:22px; left:24px; color:#fff; font-size:10px; letter-spacing:.16em; }
  .ai-luxury-collections-{{ ai_gen_id }}__meta { display:flex; align-items:center; justify-content:space-between; gap:15px; padding:17px 0 24px; border-bottom:1px solid {{ block.settings.border_color }}; }
  .ai-luxury-collections-{{ ai_gen_id }}__title { margin:0; font-size:15px; line-height:1.3; font-weight:500; letter-spacing:.01em; }
  .ai-luxury-collections-{{ ai_gen_id }}__link { color:{{ block.settings.muted_text_color }}; font-size:10px; letter-spacing:.17em; text-transform:uppercase; }
  .ai-luxury-collections-{{ ai_gen_id }}__card:focus-visible { outline:2px solid {{ block.settings.text_color }}; outline-offset:6px; }
  @media(max-width:749px){ .ai-luxury-collections-{{ ai_gen_id }}__header{display:block;padding-bottom:24px}.ai-luxury-collections-{{ ai_gen_id }}__heading{font-size:{{ block.settings.mobile_heading_size }}px}.ai-luxury-collections-{{ ai_gen_id }}__copy{margin-top:18px}.ai-luxury-collections-{{ ai_gen_id }}__grid{grid-template-columns:repeat({{ block.settings.columns_mobile }},minmax(0,1fr));gap:{{ block.settings.mobile_gap }}px;padding-top:{{ block.settings.mobile_gap }}px}.ai-luxury-collections-{{ ai_gen_id }}__media:after{inset:8px}.ai-luxury-collections-{{ ai_gen_id }}__number{top:15px;left:16px}.ai-luxury-collections-{{ ai_gen_id }}__meta{display:block;padding:12px 0 18px}.ai-luxury-collections-{{ ai_gen_id }}__link{display:block;margin-top:7px} }
{% endstyle %}

<div class="ai-luxury-collections-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-luxury-collections-{{ ai_gen_id }}__header">
    <div><p class="ai-luxury-collections-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p><h2 class="ai-luxury-collections-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2></div>
    {% if block.settings.description != blank %}<p class="ai-luxury-collections-{{ ai_gen_id }}__copy">{{ block.settings.description | escape }}</p>{% endif %}
  </div>
  {% if block.settings.collections != blank %}<div class="ai-luxury-collections-{{ ai_gen_id }}__grid">{% for collection in block.settings.collections %}<a class="ai-luxury-collections-{{ ai_gen_id }}__card" href="{{ collection.url }}" aria-label="View {{ collection.title | escape }} collection"><div class="ai-luxury-collections-{{ ai_gen_id }}__media"><span class="ai-luxury-collections-{{ ai_gen_id }}__number">0{{ forloop.index }}</span>{% if collection.featured_image %}<img src="{{ collection.featured_image | image_url: width: 1400 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}">{% else %}{{ 'collection-apparel-1' | placeholder_svg_tag }}{% endif %}</div><div class="ai-luxury-collections-{{ ai_gen_id }}__meta"><h3 class="ai-luxury-collections-{{ ai_gen_id }}__title">{{ collection.title | escape }}</h3><span class="ai-luxury-collections-{{ ai_gen_id }}__link">Discover</span></div></a>{% endfor %}</div>{% endif %}
</div>

{% schema %}
{"name":"Luxury collection gallery","settings":[{"type":"header","content":"Content"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The Universes edit"},{"type":"text","id":"heading","label":"Heading","default":"Collections, curated."},{"type":"textarea","id":"description","label":"Description","default":"A considered selection of elevated essentials, refined textures, and enduring silhouettes."},{"type":"collection_list","id":"collections","label":"Collections","limit":12},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"select","id":"columns_desktop","label":"Columns on desktop","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"3"},{"type":"select","id":"columns_mobile","label":"Columns on mobile","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"2"},{"type":"select","id":"image_ratio","label":"Image ratio","options":[{"value":"4 / 5","label":"Portrait"},{"value":"3 / 4","label":"Tall portrait"},{"value":"1 / 1","label":"Square"}],"default":"4 / 5"},{"type":"range","id":"grid_gap","label":"Grid gap","min":8,"max":40,"step":4,"unit":"px","default":24},{"type":"range","id":"mobile_gap","label":"Mobile gap","min":8,"max":28,"step":4,"unit":"px","default":12},{"type":"header","content":"Style"},{"type":"range","id":"heading_size","label":"Heading size","min":28,"max":72,"step":2,"unit":"px","default":52},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":24,"max":46,"step":2,"unit":"px","default":32},{"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#111111"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#5C5C5C"},{"type":"color","id":"accent_color","label":"Accent","default":"#8A6A3D"},{"type":"color","id":"border_color","label":"Borders","default":"#D9D5CE"},{"type":"color","id":"image_background","label":"Image background","default":"#F0EEE9"}],"presets":[{"name":"Luxury collection gallery"}],"tag":null,"class":"luxury-collection-gallery"}
{% endschema %}