{% doc %}
  @prompt
    creat a premium luxurious minimal and high uqality collection grid for our colelction witht he colelction iamge title and best mobile first design hign end luxurious premium design with it 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-grid-{{ ai_gen_id }}__intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .ai-collection-grid-{{ ai_gen_id }}__heading {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 500;
  }

  .ai-collection-grid-{{ ai_gen_id }}__description {
    max-width: 440px;
    margin: 8px 0 0;
    color: {{ block.settings.muted_text_color }};
    font-size: 14px;
    line-height: 1.6;
  }

  .ai-collection-grid-{{ ai_gen_id }}__count {
    flex: 0 0 auto;
    color: {{ block.settings.muted_text_color }};
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ai-collection-grid-{{ ai_gen_id }}__items {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-collection-grid-{{ ai_gen_id }}__card {
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .ai-collection-grid-{{ ai_gen_id }}__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ block.settings.image_ratio }};
    background: {{ block.settings.image_background }};
  }

  .ai-collection-grid-{{ ai_gen_id }}__media img,
  .ai-collection-grid-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-grid-{{ ai_gen_id }}__media svg {
    color: {{ block.settings.muted_text_color }};
  }

  .ai-collection-grid-{{ ai_gen_id }}__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-top: 13px;
  }

  .ai-collection-grid-{{ ai_gen_id }}__title {
    margin: 0;
    font-size: 15px;
    line-height: 1.3;
    font-weight: 500;
  }

  .ai-collection-grid-{{ ai_gen_id }}__link {
    flex: 0 0 auto;
    color: {{ block.settings.muted_text_color }};
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ai-collection-grid-{{ ai_gen_id }}__card:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 5px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-{{ ai_gen_id }}__intro {
      display: block;
      margin-bottom: 20px;
    }

    .ai-collection-grid-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-collection-grid-{{ ai_gen_id }}__count {
      display: block;
      margin-top: 12px;
    }

    .ai-collection-grid-{{ ai_gen_id }}__items {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-collection-grid-{{ ai_gen_id }}__meta {
      display: block;
      padding-top: 10px;
    }

    .ai-collection-grid-{{ ai_gen_id }}__link {
      display: block;
      margin-top: 5px;
    }
  }
{% endstyle %}

<div class="ai-collection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-grid-{{ ai_gen_id }}__intro">
    <div>
      {% if block.settings.heading != blank %}
        <h2 class="ai-collection-grid-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <p class="ai-collection-grid-{{ ai_gen_id }}__description">{{ block.settings.description | escape }}</p>
      {% endif %}
    </div>
    {% if block.settings.show_count %}
      <span class="ai-collection-grid-{{ ai_gen_id }}__count">{{ block.settings.collections.size }} collections</span>
    {% endif %}
  </div>

  {% if block.settings.collections != blank %}
    <div class="ai-collection-grid-{{ ai_gen_id }}__items">
      {% for collection in block.settings.collections %}
        <a class="ai-collection-grid-{{ ai_gen_id }}__card" href="{{ collection.url }}" aria-label="View {{ collection.title | escape }} collection">
          <div class="ai-collection-grid-{{ ai_gen_id }}__media">
            {% if collection.featured_image %}
              <img src="{{ collection.featured_image | image_url: width: 1200 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}">
            {% else %}
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="ai-collection-grid-{{ ai_gen_id }}__meta">
            <h3 class="ai-collection-grid-{{ ai_gen_id }}__title">{{ collection.title | escape }}</h3>
            {% if block.settings.show_link %}<span class="ai-collection-grid-{{ ai_gen_id }}__link">Explore</span>{% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-collection-grid-{{ ai_gen_id }}__items">
      <div class="ai-collection-grid-{{ ai_gen_id }}__media">{{ 'collection-apparel-1' | placeholder_svg_tag }}</div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Premium collection grid",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore the collections" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Curated essentials, considered details, and modern silhouettes for a refined wardrobe." },
    { "type": "collection_list", "id": "collections", "label": "Collections", "limit": 12 },
    { "type": "checkbox", "id": "show_count", "label": "Show collection count", "default": true },
    { "type": "checkbox", "id": "show_link", "label": "Show explore label", "default": true },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "options": [{ "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait" }, { "value": "3 / 4", "label": "Tall portrait" }], "default": "4 / 5" },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_gap", "label": "Mobile gap", "min": 8, "max": 28, "step": 4, "unit": "px", "default": 12 },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 42 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 22, "max": 42, "step": 2, "unit": "px", "default": 30 },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#5C5C5C" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#F2F1EF" }
  ],
  "presets": [{ "name": "Premium collection grid" }],
  "tag": null,
  "class": "premium-collection-grid"
}
{% endschema %}