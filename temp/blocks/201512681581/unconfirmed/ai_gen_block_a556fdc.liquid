{% doc %}
  @prompt
    Create a fully customizable Shopify Online Store 2.0 Liquid section called "Featured Collections Showcase" for a premium fashion e-commerce website.
    
    The section should be mobile-first, performance optimized, and designed for a luxury menswear brand similar to Ralph Lauren / Hugo Boss style.
    
    Requirements:
    
    1. Section Features:
    - Display selected Shopify collections using dynamic collection blocks.
    - Allow merchants to add unlimited collection blocks from the theme editor.
    - Each block should have:
      - Collection selector
      - Custom image override option
      - Collection title override
      - Subtitle text
      - Button text
      - Button URL
    - If no custom image is uploaded, automatically use the collection featured image.
    
    2. Desktop Layout:
    - Premium editorial fashion layout.
    - Support configurable columns:
      - 2 columns
      - 3 columns
      - 4 columns
      - 5 columns
    - Large image cards with elegant spacing.
    - Hover animation:
      - Smooth zoom effect
      - Image overlay transition
      - Button reveal animation
    
    3. Mobile Layout:
    - Fully responsive.
    - Provide theme settings:
      - Horizontal swipe carousel
      - 2-column grid
    - Touch-friendly swipe experience.
    - Optimized card sizing for mobile screens.
    - Prevent layout shifting.
    
    4. Design Style:
    - Luxury minimal aesthetic.
    - Clean typography.
    - Premium spacing.
    - Image-focused design.
    - Soft gradient overlay option.
    - Customizable:
      - Background color
      - Text color
      - Heading size
      - Card border radius
      - Section padding
      - Overlay opacity
    
    5. Theme Editor Settings:
    Add controls for:
    - Section heading
    - Section description
    - Heading alignment
    - Collection limit
    - Desktop columns
    - Mobile layout
    - Image ratio:
      - Square
      - Portrait
      - Landscape
    - Enable/disable animation
    - Enable/disable button
    - Enable/disable overlay
    
    6. Technical Requirements:
    - Shopify Online Store 2.0 compatible.
    - Use Liquid, JSON schema, HTML, CSS, and vanilla JavaScript only.
    - No external libraries.
    - Use Shopify image_url filters with responsive image sizes.
    - Add lazy loading for images.
    - Use semantic HTML and accessibility best practices.
    - Include proper alt text.
    - Ensure fast loading on mobile devices.
    
    7. Output:
    Provide complete production-ready code:
    - sections/featured-collections-showcase.liquid
    - CSS included inside the section
    - JavaScript included inside the section
    - Full Shopify schema JSON
    - Clean commented code.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-fcs-{{ ai_gen_id }}{display:block;width:100%;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};padding:{{ block.settings.section_padding }}px 0}.ai-fcs-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:1600px;margin:0 auto;padding:0 24px}.ai-fcs-{{ ai_gen_id }}__header{text-align:{{ block.settings.heading_alignment }};margin-bottom:32px}.ai-fcs-{{ ai_gen_id }}__heading{margin:0 0 10px;font-size:{{ block.settings.heading_size }}px;line-height:1.1}.ai-fcs-{{ ai_gen_id }}__description{max-width:640px;margin:0 auto;line-height:1.6}.ai-fcs-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat({{ block.settings.desktop_columns }},minmax(0,1fr));gap:{{ block.settings.card_gap }}px}.ai-fcs-{{ ai_gen_id }}__card{position:relative;overflow:hidden;border-radius:{{ block.settings.card_radius }}px;background:#e8e6e1;aspect-ratio:{{ block.settings.image_ratio }}}.ai-fcs-{{ ai_gen_id }}__media,.ai-fcs-{{ ai_gen_id }}__media img{display:block;width:100%;height:100%}.ai-fcs-{{ ai_gen_id }}__media img{object-fit:cover;transition:transform .6s ease}.ai-fcs-{{ ai_gen_id }}__card:hover img,.ai-fcs-{{ ai_gen_id }}__card:focus-within img{transform:scale(1.04)}.ai-fcs-{{ ai_gen_id }}__placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center}.ai-fcs-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}.ai-fcs-{{ ai_gen_id }}__overlay{position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }}) 100%);opacity:{% if block.settings.enable_overlay %}1{% else %}0{% endif %};transition:opacity .35s ease}.ai-fcs-{{ ai_gen_id }}__content{position:absolute;inset:auto 20px 20px;color:#fff;z-index:1}.ai-fcs-{{ ai_gen_id }}__title{margin:0 0 4px;color:#fff;font-size:22px}.ai-fcs-{{ ai_gen_id }}__subtitle{margin:0 0 14px;color:#fff}.ai-fcs-{{ ai_gen_id }}__button{display:inline-block;padding:10px 18px;color:#111;background:#fff;text-decoration:none;border-radius:{{ block.settings.button_radius }}px;opacity:0;transform:translateY(8px);transition:opacity .3s ease,transform .3s ease}.ai-fcs-{{ ai_gen_id }}__card:hover .ai-fcs-{{ ai_gen_id }}__button,.ai-fcs-{{ ai_gen_id }}__card:focus-within .ai-fcs-{{ ai_gen_id }}__button{opacity:{% if block.settings.enable_button %}1{% else %}0{% endif %};transform:translateY(0)}@media(max-width:749px){.ai-fcs-{{ ai_gen_id }}__inner{padding:0 16px}.ai-fcs-{{ ai_gen_id }}__grid{grid-template-columns:{% if block.settings.mobile_layout == 'grid' %}repeat(2,minmax(0,1fr)){% else %}none{% endif %}{% if block.settings.mobile_layout == 'carousel' %};display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none{% endif %}}.ai-fcs-{{ ai_gen_id }}__grid::-webkit-scrollbar{display:none}.ai-fcs-{{ ai_gen_id }}__card{% if block.settings.mobile_layout == 'carousel' %}min-width:78%;scroll-snap-align:start{% endif %}.ai-fcs-{{ ai_gen_id }}__heading{font-size:{{ block.settings.heading_size | times: 0.8 }}px}}@media(prefers-reduced-motion:reduce){.ai-fcs-{{ ai_gen_id }}__media img,.ai-fcs-{{ ai_gen_id }}__button{transition:none}}{% endstyle %}
<featured-collections-{{ ai_gen_id }} class="ai-fcs-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-fcs-{{ ai_gen_id }}__inner">{% if block.settings.heading != blank or block.settings.description != blank %}<header class="ai-fcs-{{ ai_gen_id }}__header">{% if block.settings.heading != blank %}<h2 class="ai-fcs-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.description != blank %}<div class="ai-fcs-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>{% endif %}</header>{% endif %}<div class="ai-fcs-{{ ai_gen_id }}__grid" role="list">{% for collection in block.settings.collections limit:block.settings.collection_limit %}{% if collection != blank %}{% assign image = collection.featured_image %}<article class="ai-fcs-{{ ai_gen_id }}__card" role="listitem"><a class="ai-fcs-{{ ai_gen_id }}__media" href="{{ collection.url }}" aria-label="{{ collection.title | escape }}">{% if image %}<img src="{{ image | image_url: width:1200 }}" srcset="{{ image | image_url: width:480 }} 480w, {{ image | image_url: width:800 }} 800w, {{ image | image_url: width:1200 }} 1200w" sizes="(max-width:749px) 78vw, {{ 100 | divided_by: block.settings.desktop_columns }}vw" alt="{{ image.alt | default: collection.title | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">{% else %}<div class="ai-fcs-{{ ai_gen_id }}__placeholder">{{ 'collection-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</a><div class="ai-fcs-{{ ai_gen_id }}__overlay"></div><div class="ai-fcs-{{ ai_gen_id }}__content"><h3 class="ai-fcs-{{ ai_gen_id }}__title">{{ collection.title | escape }}</h3>{% if block.settings.enable_button %}<a class="ai-fcs-{{ ai_gen_id }}__button" href="{{ collection.url }}">{{ block.settings.button_text | escape }}</a>{% endif %}</div></article>{% endif %}{% endfor %}</div></div></featured-collections-{{ ai_gen_id }}>
<script>(function(){if(!customElements.get('featured-collections-{{ ai_gen_id }}'))customElements.define('featured-collections-{{ ai_gen_id }}',class extends HTMLElement{connectedCallback(){this.setAttribute('data-ready','true')}})})();</script>
{% schema %}{"name":"Collection showcase","tag":null,"class":"featured-collections-showcase","settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore the collection"},{"type":"richtext","id":"description","label":"Description","default":"<p>Curated edits for a considered wardrobe.</p>"},{"type":"text","id":"button_text","label":"Button text","default":"View collection"},{"type":"select","id":"heading_alignment","label":"Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"collection_list","id":"collections","label":"Collections","limit":20},{"type":"range","id":"collection_limit","label":"Collection limit","min":1,"max":20,"step":1,"default":6},{"type":"range","id":"desktop_columns","label":"Desktop columns","min":2,"max":5,"step":1,"default":4},{"type":"select","id":"mobile_layout","label":"Mobile layout","options":[{"value":"carousel","label":"Swipe carousel"},{"value":"grid","label":"2-column grid"}],"default":"carousel"},{"type":"select","id":"image_ratio","label":"Image ratio","options":[{"value":"1 / 1","label":"Square"},{"value":"4 / 5","label":"Portrait"},{"value":"4 / 3","label":"Landscape"}],"default":"4 / 5"},{"type":"checkbox","id":"enable_animation","label":"Enable animation","default":true},{"type":"checkbox","id":"enable_button","label":"Enable button","default":true},{"type":"checkbox","id":"enable_overlay","label":"Enable overlay","default":true},{"type":"color","id":"background_color","label":"Background","default":"#f7f6f3"},{"type":"color","id":"text_color","label":"Text","default":"#171717"},{"type":"range","id":"heading_size","label":"Heading size","min":20,"max":64,"step":2,"unit":"px","default":40},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":24,"step":2,"unit":"px","default":0},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":24,"step":2,"unit":"px","default":0},{"type":"range","id":"section_padding","label":"Section padding","min":20,"max":120,"step":10,"unit":"px","default":70},{"type":"range","id":"card_gap","label":"Card gap","min":8,"max":40,"step":4,"unit":"px","default":16},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":90,"step":10,"unit":"%","default":40},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Collection showcase"}]}{% endschema %}