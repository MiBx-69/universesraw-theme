{% doc %}
  @prompt
    Create a premium Trust Badges section for Shopify Online Store 2.0 using Liquid, HTML5, CSS3, and vanilla JavaScript. The design must be luxury, minimal, modern, and mobile-first, with fast loading, accessibility (WCAG), and Core Web Vitals optimization. Include premium SVG icons, subtle hover animations, and fully customizable settings through the Theme Editor.
    
    Add these trust badges:
    
    Easy 3-Day Exchange – Easy exchange within 3 days after delivery.
    Cash on Delivery – Available nationwide across Bangladesh.
    Fast Nationwide Delivery – Delivery within 2–5 business days.
    Premium Quality Guaranteed.
    Secure Checkout & Safe Payment.
    Trusted by Thousands of Customers.
    
    The section should be fully responsive, mobile-optimized, support dark/light themes, and allow icon, title, description, colors, spacing, and layout customization from the Shopify Theme Editor. Use clean, production-ready code with no external libraries.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-badges-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background: {{ block.settings.background_color }};
    {% if block.settings.background_gradient != blank %}
      background: {{ block.settings.background_gradient }};
    {% endif %}
  }

  .ai-trust-badges-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-trust-badges-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.gap_desktop }}px;
    align-items: start;
  }

  .ai-trust-badge-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: {{ block.settings.layout_direction }};
    align-items: {{ block.settings.align_items }};
    justify-content: {{ block.settings.justify_content }};
    gap: {{ block.settings.icon_text_gap }}px;
    padding: {{ block.settings.item_padding }}px;
    background: {{ block.settings.item_background }};
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-align: {{ block.settings.text_align }};
  }

  {% if block.settings.enable_hover_effect %}
    .ai-trust-badge-item-{{ ai_gen_id }}:hover {
      transform: translateY(-{{ block.settings.hover_lift }}px);
      box-shadow: 0 {{ block.settings.hover_shadow_y }}px {{ block.settings.hover_shadow_blur }}px {{ block.settings.hover_shadow_color }};
      background: {{ block.settings.item_hover_background }};
      border-color: {{ block.settings.border_hover_color }};
    }
  {% endif %}

  .ai-trust-badge-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  {% if block.settings.enable_hover_effect %}
    .ai-trust-badge-item-{{ ai_gen_id }}:hover .ai-trust-badge-icon-{{ ai_gen_id }} {
      transform: scale({{ block.settings.icon_hover_scale }});
    }
  {% endif %}

  .ai-trust-badge-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
    stroke: {{ block.settings.icon_color }};
  }

  .ai-trust-badge-content-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-trust-badge-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
    line-height: 1.3;
    letter-spacing: {{ block.settings.title_letter_spacing }};
  }

  .ai-trust-badge-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    font-weight: {{ block.settings.description_weight }};
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
    opacity: {{ block.settings.description_opacity }};
  }

  @media screen and (max-width: 989px) {
    .ai-trust-badges-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-trust-badges-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
      gap: {{ block.settings.gap_tablet }}px;
    }

    .ai-trust-badge-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .ai-trust-badge-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-trust-badge-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_mobile }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-trust-badges-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.gap_mobile }}px;
    }
  }
{% endstyle %}

