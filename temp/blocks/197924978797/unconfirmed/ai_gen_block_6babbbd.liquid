{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-luxury-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background: {{ block.settings.background_color }};
    {% if block.settings.background_gradient != blank %}
      background: {{ block.settings.background_gradient }};
    {% endif %}
    border-top: {{ block.settings.border_top_width }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_bottom_width }}px solid {{ block.settings.border_color }};
    position: relative;
    overflow: hidden;
  }

  .ai-trust-luxury-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .ai-trust-luxury-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax({{ block.settings.min_item_width }}px, 1fr));
    gap: {{ block.settings.gap }}px;
    align-items: stretch;
  }

  .ai-trust-luxury-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: {{ block.settings.icon_gap }}px;
    padding: {{ block.settings.item_padding_vertical }}px {{ block.settings.item_padding_horizontal }}px;
    background: {{ block.settings.item_background }};
    border: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: default;
    min-height: {{ block.settings.min_item_height }}px;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur({{ block.settings.backdrop_blur }}px);
    -webkit-backdrop-filter: blur({{ block.settings.backdrop_blur }}px);
  }

  .ai-trust-luxury-item-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: {{ block.settings.item_overlay }};
    opacity: 0;
    transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    z-index: 0;
  }

  {% if block.settings.enable_hover %}
    .ai-trust-luxury-item-{{ ai_gen_id }}:hover {
      background: {{ block.settings.item_hover_background }};
      border-color: {{ block.settings.item_hover_border_color }};
      transform: translateY(-{{ block.settings.hover_lift }}px);
      box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_spread }}px {{ block.settings.shadow_color }};
    }

    .ai-trust-luxury-item-{{ ai_gen_id }}:hover::before {
      opacity: 1;
    }

    .ai-trust-luxury-item-{{ ai_gen_id }}:hover .ai-trust-luxury-icon-wrapper-{{ ai_gen_id }} {
      transform: scale({{ block.settings.icon_hover_scale }}) rotate({{ block.settings.icon_hover_rotate }}deg);
    }

    .ai-trust-luxury-item-{{ ai_gen_id }}:hover .ai-trust-luxury-text-{{ ai_gen_id }} {
      color: {{ block.settings.text_hover_color }};
    }
  {% endif %}

  .ai-trust-luxury-icon-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    padding: {{ block.settings.icon_padding }}px;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    z-index: 1;
  }

  .ai-trust-luxury-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-trust-luxury-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: {{ block.settings.icon_stroke_width }};
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-trust-luxury-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    color: {{ block.settings.text_color }};
    line-height: {{ block.settings.line_height }};
    letter-spacing: {{ block.settings.letter_spacing }};
    text-transform: {{ block.settings.text_transform }};
    transition: color 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    z-index: 1;
    max-width: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-luxury-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-trust-luxury-grid-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'scroll' %}
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        gap: {{ block.settings.gap_mobile }}px;
        padding-bottom: 4px;
      {% else %}
        grid-template-columns: repeat({{ block.settings.mobile_columns }}, 1fr);
        gap: {{ block.settings.gap_mobile }}px;
      {% endif %}
    }

    {% if block.settings.mobile_layout == 'scroll' %}
      .ai-trust-luxury-grid-{{ ai_gen_id }}::-webkit-scrollbar {
        display: none;
      }

      .ai-trust-luxury-item-{{ ai_gen_id }} {
        flex: 0 0 auto;
        scroll-snap-align: start;
        width: {{ block.settings.mobile_scroll_width }}%;
      }
    {% endif %}

    .ai-trust-luxury-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
      padding: {{ block.settings.icon_padding_mobile }}px;
    }

    .ai-trust-luxury-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .ai-trust-luxury-item-{{ ai_gen_id }} {
      padding: {{ block.settings.item_padding_vertical_mobile }}px {{ block.settings.item_padding_horizontal_mobile }}px;
      min-height: {{ block.settings.min_item_height_mobile }}px;
    }
  }
{% endstyle %}

