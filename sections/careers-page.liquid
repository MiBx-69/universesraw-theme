<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "JobPosting",
  "title": {{ block.settings.title | strip_html | json }},
  "description": {{ block.settings.short_description | strip_html | default: block.settings.title | json }},
  "identifier": {
    "@type": "PropertyValue",
    "name": {{ s.org_name | default: shop.name | json }},
    "value": {{ block.id | json }}
  },
  "datePosted": {{ block.settings.date_posted | default: 'today' | date: '%Y-%m-%d' | json }},
  {% if block.settings.deadline != blank %}"validThrough": {{ block.settings.deadline | date: '%Y-%m-%d' | json }},{% endif %}
  "employmentType": {{ block.settings.employment_type | default: 'FULL_TIME' | upcase | replace: ' ', '_' | json }},
  "hiringOrganization": {
    "@type": "Organization",
    "name": {{ s.org_name | default: shop.name | json }},
    "sameAs": {{ shop.url | json }}
    {% if s.org_logo %},"logo": {{ s.org_logo | image_url: width: 600 | prepend: "https:" | json }}{% endif %}
  },
  "jobLocation": {
    "@type": "Place",
    "address": { "@type": "PostalAddress", "addressLocality": {{ block.settings.location | default: 'Remote' | json }} }
  }
  {% if block.settings.salary != blank %},"baseSalary": { "@type": "MonetaryAmount", "currency": {{ shop.currency | json }}, "value": { "@type": "QuantitativeValue", "value": {{ block.settings.salary | json }} } }{% endif %}
}
</script>
{% endfor %}

{% comment %} ============================================================
  VANILLA JS — deferred, scoped to this section instance
============================================================ {% endcomment %}
<script>
(function () {
  "use strict";
  var root = document.getElementById("uraw-root-{{ uid }}");
  if (!root) return;
  var prefersReducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function init() {
    initReveal();
    initCounters();
    initJobsFilter();
    initModal();
    initTestimonialSlider();
    initFaqSearch();
    initStickyApply();
  }

  /* Scroll-reveal for module headings / cards */
  function initReveal() {
    var items = root.querySelectorAll(".uraw-reveal");
    if (!items.length) return;
    if (prefersReducedMotion || !("IntersectionObserver" in window)) {
      items.forEach(function (el) { el.classList.add("is-visible"); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: "0px 0px -40px 0px" });
    items.forEach(function (el) { io.observe(el); });
  }

  /* Animated stat counters */
  function initCounters() {
    var counters = root.querySelectorAll("[data-counter]");
    if (!counters.length) return;
    var animate = function (el) {
      var raw = (el.getAttribute("data-target") || "").trim();
      var match = raw.match(/[\d.,]+/);
      if (!match) return;
      var prefix = raw.slice(0, match.index);
      var suffix = raw.slice(match.index + match[0].length);
      var target = parseFloat(match[0].replace(/,/g, ""));
      if (isNaN(target)) return;
      if (prefersReducedMotion) { el.textContent = raw; return; }
      var duration = 1400, start = null;
      function step(ts) {
        if (start === null) start = ts;
        var progress = Math.min((ts - start) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        var current = target * eased;
        var display = target % 1 === 0 ? Math.round(current).toLocaleString() : current.toFixed(1);
        el.textContent = prefix + display + suffix;
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = raw;
      }
      requestAnimationFrame(step);
    };
    if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) { animate(entry.target); io.unobserve(entry.target); }
        });
      }, { threshold: 0.5 });
      counters.forEach(function (el) { io.observe(el); });
    } else {
      counters.forEach(animate);
    }
  }

  /* Jobs: search, filter, sort, empty state */
  function initJobsFilter() {
    var list = root.querySelector("[data-jobs-list]");
    if (!list) return;
    var rows = Array.prototype.slice.call(list.querySelectorAll("[data-job-row]"));
    var searchInput = root.querySelector("[data-jobs-search]");
    var filterSelects = root.querySelectorAll("[data-jobs-filter]");
    var sortSelect = root.querySelector("[data-jobs-sort]");
    var emptyState = root.querySelector("[data-jobs-empty]");
    var countEl = root.querySelector("[data-jobs-count]");

    function apply() {
      var term = searchInput ? searchInput.value.trim().toLowerCase() : "";
      var filters = {};
      filterSelects.forEach(function (sel) { filters[sel.getAttribute("data-jobs-filter")] = sel.value; });
      var visible = 0;
      rows.forEach(function (row) {
        var matchesTerm = !term || row.getAttribute("data-title").indexOf(term) !== -1;
        var matchesDept = !filters.department || row.getAttribute("data-department") === filters.department;
        var matchesLoc = !filters.location || row.getAttribute("data-location") === filters.location;
        var matchesType = !filters.type || row.getAttribute("data-type") === filters.type;
        var show = matchesTerm && matchesDept && matchesLoc && matchesType;
        row.style.display = show ? "" : "none";
        if (show) visible++;
      });
      if (emptyState) emptyState.classList.toggle("is-visible", visible === 0);
      if (countEl) countEl.textContent = visible + " open role" + (visible !== 1 ? "s" : "");
    }

    function sort() {
      if (!sortSelect) return;
      var val = sortSelect.value;
      var sorted = rows.slice();
      if (val === "title-asc") {
        sorted.sort(function (a, b) { return a.getAttribute("data-title").localeCompare(b.getAttribute("data-title")); });
      } else if (val === "department") {
        sorted.sort(function (a, b) { return a.getAttribute("data-department").localeCompare(b.getAttribute("data-department")); });
      } else if (val === "deadline") {
        sorted.sort(function (a, b) {
          var da = a.getAttribute("data-deadline") || "9999-99-99";
          var db = b.getAttribute("data-deadline") || "9999-99-99";
          return da.localeCompare(db);
        });
      } else {
        sorted.sort(function (a, b) {
          var fa = a.getAttribute("data-featured") === "true" ? 0 : 1;
          var fb = b.getAttribute("data-featured") === "true" ? 0 : 1;
          return fa - fb;
        });
      }
      sorted.forEach(function (row) { list.appendChild(row); });
    }

    if (searchInput) searchInput.addEventListener("input", apply);
    filterSelects.forEach(function (sel) { sel.addEventListener("change", apply); });
    if (sortSelect) sortSelect.addEventListener("change", sort);
  }

  /* Job details modal */
  function initModal() {
    var backdrop = root.querySelector("[data-modal-backdrop]");
    var triggers = root.querySelectorAll("[data-modal-target]");
    var modals = root.querySelectorAll("[data-modal]");
    if (!triggers.length || !modals.length) return;
    var openModal = null;
    var lastFocused = null;

    function open(id) {
      var modal = root.querySelector("#" + id);
      if (!modal) return;
      lastFocused = document.activeElement;
      modal.classList.add("is-open");
      if (backdrop) backdrop.classList.add("is-open");
      document.body.style.overflow = "hidden";
      openModal = modal;
      var closeBtn = modal.querySelector("[data-modal-close]");
      if (closeBtn) closeBtn.focus();
      document.addEventListener("keydown", onKeydown);
    }
    function close() {
      if (!openModal) return;
      openModal.classList.remove("is-open");
      if (backdrop) backdrop.classList.remove("is-open");
      document.body.style.overflow = "";
      document.removeEventListener("keydown", onKeydown);
      if (lastFocused) lastFocused.focus();
      openModal = null;
    }
    function onKeydown(e) {
      if (e.key === "Escape") close();
      if (e.key === "Tab" && openModal) {
        var focusables = openModal.querySelectorAll('a[href], button, input, select, textarea, [tabindex]:not([tabindex="-1"])');
        if (!focusables.length) return;
        var first = focusables[0], last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }

    triggers.forEach(function (trigger) {
      trigger.addEventListener("click", function () { open(trigger.getAttribute("data-modal-target")); });
      trigger.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(trigger.getAttribute("data-modal-target")); }
      });
    });
    modals.forEach(function (modal) {
      var closeBtn = modal.querySelector("[data-modal-close]");
      if (closeBtn) closeBtn.addEventListener("click", close);
    });
    if (backdrop) backdrop.addEventListener("click", close);
  }

  /* Testimonial slider (scroll-snap driven) */
  function initTestimonialSlider() {
    var track = root.querySelector("[data-testimonial-track]");
    var prev = root.querySelector("[data-testimonial-prev]");
    var next = root.querySelector("[data-testimonial-next]");
    if (!track || (!prev && !next)) return;
    function step(dir) {
      var card = track.querySelector(".uraw-testimonial-card");
      var amount = card ? card.getBoundingClientRect().width + 24 : 300;
      track.scrollBy({ left: dir * amount, behavior: prefersReducedMotion ? "auto" : "smooth" });
    }
    if (prev) prev.addEventListener("click", function () { step(-1); });
    if (next) next.addEventListener("click", function () { step(1); });
  }

  /* FAQ live search */
  function initFaqSearch() {
    var input = root.querySelector("[data-faq-search]");
    var items = root.querySelectorAll("[data-faq-item]");
    if (!input || !items.length) return;
    input.addEventListener("input", function () {
      var term = input.value.trim().toLowerCase();
      items.forEach(function (item) {
        var q = item.getAttribute("data-question") || "";
        var text = item.textContent.toLowerCase();
        var match = !term || q.indexOf(term) !== -1 || text.indexOf(term) !== -1;
        item.hidden = !match;
      });
    });
  }

  /* Sticky mobile apply bar — shows once hero scrolls out of view */
  function initStickyApply() {
    var bar = root.querySelector("[data-sticky-apply]");
    var hero = root.querySelector(".uraw-hero");
    if (!bar) return;
    if (!hero || !("IntersectionObserver" in window)) { bar.classList.add("is-visible"); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        bar.classList.toggle("is-visible", !entry.isIntersecting);
      });
    }, { threshold: 0 });
    io.observe(hero);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }

  /* Re-init cleanly when the section is edited live in the Theme Editor */
  document.addEventListener("shopify:section:load", function (evt) {
    if (evt.target && evt.target.contains(root)) init();
  });
})();
</script>

{% schema %}
{
  "name": "Careers page",
  "tag": "section",
  "class": "uraw-careers-section",
  "settings": [
    { "type": "header", "content": "Global — brand & layout" },
    { "type": "text", "id": "org_name", "label": "Organization name", "info": "Used in SEO schema. Defaults to store name." },
    { "type": "image_picker", "id": "org_logo", "label": "Organization logo (for SEO schema)" },
    { "type": "color", "id": "color_primary", "label": "Text color", "default": "#1B1A18" },
    { "type": "color", "id": "color_secondary", "label": "Muted / secondary text", "default": "#8C8579" },
    { "type": "color", "id": "color_accent", "label": "Accent color", "default": "#AD8A56" },
    { "type": "color", "id": "color_background", "label": "Background color", "default": "#FAF8F4" },
    { "type": "color", "id": "color_surface", "label": "Surface / card background", "default": "#E7DECD" },
    { "type": "color", "id": "color_button", "label": "Button background", "default": "#1B1A18" },
    { "type": "color", "id": "color_button_text", "label": "Button text", "default": "#FAF8F4" },
    { "type": "color", "id": "color_button_hover", "label": "Button hover", "default": "#AD8A56" },
    { "type": "font_picker", "id": "font_heading", "label": "Heading font", "default": "playfair_display_n7" },
    { "type": "font_picker", "id": "font_body", "label": "Body font", "default": "assistant_n4" },
    { "type": "range", "id": "container_width", "label": "Container width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
    { "type": "range", "id": "section_spacing", "label": "Section spacing (desktop)", "min": 40, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "mobile_spacing", "label": "Section spacing (mobile)", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "border_radius", "label": "Corner radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 2 },
    { "type": "checkbox", "id": "enable_animations", "label": "Enable animations", "default": true, "info": "Reduced-motion preference is always respected." },

    { "type": "header", "content": "Hero" },
    { "type": "checkbox", "id": "show_hero", "label": "Show hero section", "default": true },
    { "type": "image_picker", "id": "hero_image", "label": "Background image" },
    { "type": "video", "id": "hero_video", "label": "Background video (optional, overrides image)" },
    { "type": "color", "id": "hero_overlay_color", "label": "Overlay color", "default": "#1B1A18" },
    { "type": "range", "id": "hero_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 40 },
    { "type": "text", "id": "hero_eyebrow", "label": "Small heading", "default": "Careers" },
    { "type": "text", "id": "headline", "label": "Main headline", "default": "Join the Universe" },
    { "type": "richtext", "id": "hero_description", "label": "Description", "default": "<p>We build for people who wear their convictions. Come make raw, honest fashion with us.</p>" },
    { "type": "text", "id": "hero_primary_cta_text", "label": "Primary button label", "default": "View open roles" },
    { "type": "url", "id": "hero_primary_cta_link", "label": "Primary button link" },
    { "type": "text", "id": "hero_secondary_cta_text", "label": "Secondary button label", "default": "Our story" },
    { "type": "url", "id": "hero_secondary_cta_link", "label": "Secondary button link" },
    { "type": "select", "id": "hero_text_align", "label": "Text alignment", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },
    { "type": "select", "id": "hero_height", "label": "Hero height", "default": "large", "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }, { "value": "fullscreen", "label": "Fullscreen" } ] },

    { "type": "header", "content": "Company statistics" },
    { "type": "text", "id": "stats_heading", "label": "Heading", "default": "Universes RAW, by the numbers" },

    { "type": "header", "content": "Why join us" },
    { "type": "text", "id": "why_eyebrow", "label": "Eyebrow", "default": "Why join us" },
    { "type": "text", "id": "why_heading", "label": "Heading", "default": "Made for people who make things" },
    { "type": "textarea", "id": "why_subheading", "label": "Subheading" },

