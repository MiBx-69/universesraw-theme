{{ 'toolbar-mobile.css' | asset_url | stylesheet_tag }}

<toolbar-mobile
  class="toolbar-mobile"
  data-toolbar-mobile
>
  <div class="toolbar-mobile__inner">

    {%- comment -%}
      SEARCH
    {%- endcomment -%}

    {%- for block in section.blocks -%}

      {%- case block.type -%}

        {%- when 'search' -%}

          {%- if block.settings.action_type == 'drawer' -%}

            <side-drawer-opener
              class="toolbar-mobile__item"
              data-side-drawer="#Drawer-Search"
            >
              <button
                class="toolbar-mobile__button"
                type="button"
                aria-haspopup="dialog"
                aria-label="{{ 'content.search' | t }}"
              >
                <span class="toolbar-mobile__icon">
                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon }}
                  {%- else -%}
                    {{ 'icon-search.svg' | inline_asset_content }}
                  {%- endif -%}
                </span>

                {%- if block.settings.title != blank -%}
                  <span class="toolbar-mobile__label">
                    {{ block.settings.title | escape }}
                  </span>
                {%- endif -%}
              </button>
            </side-drawer-opener>

          {%- else -%}

            <a
              href="{{ routes.search_url }}"
              class="toolbar-mobile__item"
              aria-label="{{ block.settings.title | escape }}"
            >
              <span class="toolbar-mobile__button">

                <span class="toolbar-mobile__icon">
                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon }}
                  {%- else -%}
                    {{ 'icon-search.svg' | inline_asset_content }}
                  {%- endif -%}
                </span>

                {%- if block.settings.title != blank -%}
                  <span class="toolbar-mobile__label">
                    {{ block.settings.title | escape }}
                  </span>
                {%- endif -%}

              </span>
            </a>

          {%- endif -%}


        {%- when 'account' -%}

          {%- if block.settings.action_type == 'drawer' -%}

            <side-drawer-opener
              class="toolbar-mobile__item"
              data-side-drawer="#Drawer-Account"
            >
              <button
                class="toolbar-mobile__button"
                type="button"
                aria-haspopup="dialog"
                aria-label="{% if customer %}{{ 'customer.account_fallback' | t }}{% else %}{{ 'customer.log_in' | t }}{% endif %}"
              >

                <span class="toolbar-mobile__icon">
                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon }}
                  {%- else -%}
                    {{ 'icon-account.svg' | inline_asset_content }}
                  {%- endif -%}
                </span>

                {%- if block.settings.title != blank -%}
                  <span class="toolbar-mobile__label">
                    {{ block.settings.title | escape }}
                  </span>
                {%- endif -%}

              </button>
            </side-drawer-opener>

          {%- else -%}

            <a
              href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
              class="toolbar-mobile__item"
              aria-label="{{ block.settings.title | escape }}"
            >

              <span class="toolbar-mobile__button">

                <span class="toolbar-mobile__icon">
                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon }}
                  {%- else -%}
                    {{ 'icon-account.svg' | inline_asset_content }}
                  {%- endif -%}
                </span>

                {%- if block.settings.title != blank -%}
                  <span class="toolbar-mobile__label">
                    {{ block.settings.title | escape }}
                  </span>
                {%- endif -%}

              </span>

              <span class="visually-hidden">
                {%- if customer -%}
                  {{ 'customer.account_fallback' | t }}
                {%- else -%}
                  {{ 'customer.log_in' | t }}
                {%- endif -%}
              </span>

            </a>

          {%- endif -%}


        {%- when 'home' -%}

          <a
            href="/"
            class="toolbar-mobile__item toolbar-mobile__item--home"
            aria-label="{{ block.settings.title | default: 'Home' | escape }}"
          >

            <span class="toolbar-mobile__home-button">

              <span class="toolbar-mobile__home-icon">
                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon }}
                {%- else -%}

                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <path
                      d="M3 10.8L12 3L21 10.8V20C21 20.55 20.55 21 20 21H15V14H9V21H4C3.45 21 3 20.55 3 20V10.8Z"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>

                {%- endif -%}
              </span>

            </span>

            {%- if block.settings.title != blank -%}
              <span class="toolbar-mobile__label">
                {{ block.settings.title | escape }}
              </span>
            {%- endif -%}

          </a>


        {%- when 'cart' -%}

          {%- if block.settings.action_type == 'drawer' -%}

            <side-drawer-opener
              class="toolbar-mobile__item"
              data-side-drawer="#Cart-Drawer"
            >

              <button
                class="toolbar-mobile__button toolbar-mobile__button--cart"
                type="button"
                aria-haspopup="dialog"
                aria-label="{{ 'content.cart.cart_items' | t: count: cart.item_count }}"
              >

                <span class="toolbar-mobile__icon toolbar-mobile__cart-icon-wrapper">

                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon }}
                  {%- else -%}
                    {{ 'icon-cart_2.svg' | inline_asset_content }}
                  {%- endif -%}

                  {%- if cart.item_count < 100 -%}

                    <span
                      class="toolbar-mobile__cart-count cart-count-bubble"
                      data-cart-count
                    >
                      {{ cart.item_count }}
                    </span>

                  {%- endif -%}

                </span>

                {%- if block.settings.title != blank -%}
                  <span class="toolbar-mobile__label">
                    {{ block.settings.title | escape }}
                  </span>
                {%- endif -%}

              </button>

            </side-drawer-opener>

          {%- else -%}

            <a
              href="{{ routes.cart_url }}"
              class="toolbar-mobile__item"
              aria-label="{{ 'content.cart.cart_items' | t: count: cart.item_count }}"
            >

              <span class="toolbar-mobile__button toolbar-mobile__button--cart">

                <span class="toolbar-mobile__icon toolbar-mobile__cart-icon-wrapper">

                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon }}
                  {%- else -%}
                    {{ 'icon-cart_2.svg' | inline_asset_content }}
                  {%- endif -%}

                  {%- if cart.item_count < 100 -%}

                    <span
                      class="toolbar-mobile__cart-count cart-count-bubble"
                      data-cart-count
                    >
                      {{ cart.item_count }}
                    </span>

                  {%- endif -%}

                </span>

                {%- if block.settings.title != blank -%}
                  <span class="toolbar-mobile__label">
                    {{ block.settings.title | escape }}
                  </span>
                {%- endif -%}

              </span>

            </a>

          {%- endif -%}

      {%- endcase -%}

    {%- endfor -%}

  </div>
</toolbar-mobile>


<script src="{{ 'toolbar-mobile.js' | asset_url }}" defer="defer"></script>


{% schema %}

{
  "name": "Premium Mobile Toolbar",
  "tag": "section",
  "class": "shopify-section--toolbar-mobile",
  "limit": 1,

  "enabled_on": {
    "groups": ["custom.popup"]
  },

  "settings": [
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],

  "blocks": [

    {
      "type": "search",
      "name": "Search",
      "limit": 1,

      "settings": [

        {
          "type": "textarea",
          "id": "icon",
          "label": "Custom SVG icon"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Search"
        },

        {
          "type": "select",
          "id": "action_type",
          "label": "Action",
          "options": [
            {
              "value": "drawer",
              "label": "Open drawer"
            },
            {
              "value": "page",
              "label": "Search page"
            }
          ],
          "default": "drawer"
        }

      ]
    },


    {
      "type": "account",
      "name": "Account",
      "limit": 1,

      "settings": [

        {
          "type": "textarea",
          "id": "icon",
          "label": "Custom SVG icon"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Account"
        },

        {
          "type": "select",
          "id": "action_type",
          "label": "Action",
          "options": [
            {
              "value": "drawer",
              "label": "Open drawer"
            },
            {
              "value": "page",
              "label": "Account page"
            }
          ],
          "default": "drawer"
        }

      ]
    },


    {
      "type": "home",
      "name": "Home",
      "limit": 1,

      "settings": [

        {
          "type": "textarea",
          "id": "icon",
          "label": "Custom SVG icon"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Home"
        }

      ]
    },


    {
      "type": "cart",
      "name": "Cart",
      "limit": 1,

      "settings": [

        {
          "type": "textarea",
          "id": "icon",
          "label": "Custom SVG icon"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Cart"
        },

        {
          "type": "select",
          "id": "action_type",
          "label": "Action",
          "options": [
            {
              "value": "drawer",
              "label": "Open drawer"
            },
            {
              "value": "page",
              "label": "Cart page"
            }
          ],
          "default": "drawer"
        }

      ]
    }

  ],

  "presets": [

    {
      "name": "Premium Mobile Toolbar",

      "blocks": [
        {
          "type": "search"
        },

        {
          "type": "account"
        },

        {
          "type": "home"
        },

        {
          "type": "cart"
        }
      ]
    }

  ]
}

{% endschema %}