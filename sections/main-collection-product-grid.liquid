{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'collection-wrapper.css' | asset_url | stylesheet_tag }}

{%- liquid
  if cart.attributes.pagination != blank and cart.attributes.pagination
    assign paginate_by = cart.attributes.pagination
  else
    assign paginate_by = section.settings.products_per_page
  endif

  assign limit = paginate_by

  assign columns_tablet = 2
  assign columns_mobile = section.settings.columns_mobile
  assign horizontal_class = false

  if section.settings.columns_desktop == 1
    assign columns_tablet = 1
    assign columns_mobile = 1
    assign horizontal_class = true
  endif
-%}

<div
  class="template-collection{%- if section.settings.product_grid_width == 'full-width' %} template-collection--full-width{% endif %} collection-wrapper grid-base gap-style gradient color-{{ section.settings.color_scheme }} spacing"
  style="
    --p-spacing-t: {{ section.settings.padding_top }}px;
    --p-spacing-b: {{ section.settings.padding_bottom }}px;
  "
>
  {% content_for 'block',
    type: 'filters',
    id: 'filters',
    results: collection,
    results_size: collection.products_count,
    limit: limit
  %}

  {% content_for 'block', type: '_collection-header', id: 'collection-header' %}

  {%- paginate collection.products by limit -%}

    <div
      class="
        main-collection-grid
        {%- if section.settings.inherit_color_scheme == false %} color-{{ section.settings.color_scheme }}{% endif %}
        {%- if section.settings.product_grid_width == 'full-width' %} collection-wrapper--full-width{% endif %}
        {%- if section.settings.full_width_on_mobile == true %} collection-wrapper--full-width-on-mobile{% endif %}
        spacing-style
      "
      style="
        --grid--margin--mobile: 0{% if section.settings.product_grid_width == 'centered' and section.settings.full_width_on_mobile == false %} var(--margin-lg){% else %} 0{% endif %};
        --grid-column--desktop: var(--{% if section.settings.product_grid_width == 'centered' %}centered{% else %}full-width{% endif %});
        --grid-column--mobile: var(--{% if section.settings.full_width_on_mobile %}full-width{% else %}{% if section.settings.product_grid_width == 'centered' %}centered{% else %}full-width{% endif %}{% endif %});
        --padding-inline-start: {{ section.settings.padding-inline-start }}px;
        --padding-inline-end: {{ section.settings.padding-inline-end }}px;
      "
    >

      <div class="product-grid-container" id="ProductGridContainer">

        {%- if collection.products.size == 0 -%}

          <div
            class="collection collection--empty page-width"
            id="product-grid"
            data-id="{{ section.id }}"
          >
            <div class="loading-overlay gradient">
              {% render 'loading-spinner' %}
            </div>

            <div class="title-wrapper center">
              <h2 class="title title--primary">

                {{ 'content.no_products_found' | t -}}

                <br>

                {{
                  'content.use_fewer_filters_html'
                  | t:
                    link: collection.url,
                    class: 'underlined-link link'
                }}

              </h2>
            </div>
          </div>

        {%- else -%}

          <div
            class="collection"
            data-id="{{ section.id }}"
          >

            <div class="loading-overlay gradient">
              {% render 'loading-spinner' %}
            </div>

            {% capture children %}

              {% for product in collection.products %}

                <li
                  id="{{ section.id }}-{{ product.id }}"
                  class="
                    product-grid__item
                    product-grid__item--{{ forloop.index0 }}
                    {% if settings.animations_reveal_on_scroll %}
                      scroll-trigger animate--slide-in
                    {% endif %}
                  "
                  data-page="{{ paginate.current_page }}"
                  data-product-id="{{ product.id }}"

                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >

                  {% # theme-check-disable %}

                  {% content_for
                    "block",
                    type: "_product-card",
                    id: "product-card",
                    closest.product: product
                  %}

                  {% # theme-check-enable %}


                  <!-- =====================================================
                       UNIVERSes RAW — FLOATING SHOPPING BAG
                       ===================================================== -->

                  <modal-opener
                    class="universes-horizon-bag"
                    data-modal="#QuickAddStandard"
                  >

                    <button
                      type="button"
                      class="universes-horizon-bag__button"

                      aria-label="
                        Quick add {{ product.title | escape }}
                      "

                      data-product-url="{{ product.url }}"
                      data-product-id="{{ product.id }}"
                      data-product-handle="{{ product.handle }}"
                    >

                      <svg
                        class="universes-horizon-bag__icon"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.65"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M5.5 8.5h13l-1 11H6.5l-1-11Z"/>
                        <path d="M8.5 8.5V7a3.5 3.5 0 0 1 7 0v1.5"/>
                        <path d="M12 11.5v4"/>
                        <path d="M10 13.5h4"/>
                      </svg>

                      <span class="visually-hidden">
                        Quick add {{ product.title | escape }}
                      </span>

                    </button>

                  </modal-opener>

                </li>

              {% endfor %}

            {% endcapture %}


            {% render 'product-grid',
              section: section,
              children: children,
              products: collection.products,
              paginate: paginate
            %}


            <div
              class="product-count pos-relative light left hidden"
              role="status"
            >

              <h2 class="product-count__text text-body mar-0">

                <span id="ProductCount">

                  {%- if collection.results_count -%}

                    {{
                      'content.results_with_count'
                      | t:
                        terms: collection.terms,
                        count: collection.results_count
                    }}

                  {%- elsif collection.products_count == collection.all_products_count -%}

                    {{
                      'products.facets.product_count_simple'
                      | t:
                        count: collection.products_count
                    }}

                  {%- else -%}

                    {{
                      'products.facets.product_count'
                      | t:
                        product_count: collection.products_count,
                        count: collection.all_products_count
                    }}

                  {%- endif -%}

                </span>

              </h2>

              {%- render 'loading-spinner' -%}

            </div>


            {%- if paginate.pages > 1 -%}

              {% render 'pagination',
                paginate: paginate,
                anchor: '',
                settings: section.settings,
                suffix: 'pagination'
              %}

            {%- endif -%}

          </div>

        {%- endif -%}

      </div>

    </div>

  {%- endpaginate -%}


  {% if section.settings.image_shape == 'arch' %}

    {{ 'mask-arch.svg' | inline_asset_content }}

  {%- endif -%}

</div>


<!-- =============================================================
     UNIVERSes RAW — QUICK ADD BAG
     FIXED TO PRODUCT IMAGE BOTTOM-RIGHT CORNER
     ============================================================= -->

<style>

  /* =========================================================
     UNIVERSes RAW — PREMIUM COLLECTION QUICK ADD
     Minimal bag + integrated plus mark
     ========================================================= */

  /* Product image/card area remains the positioning parent */
  .product-grid__item .card__inner {
    position: relative !important;
  }

  /* Quick Add stays inside the product image, bottom-right */
  .product-grid__item .universes-horizon-bag {
    position: absolute !important;
    top: auto !important;
    left: auto !important;
    right: 12px !important;
    bottom: 12px !important;
    z-index: 100 !important;

    width: 44px !important;
    height: 44px !important;
    margin: 0 !important;
    padding: 0 !important;

    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  .product-grid__item .universes-horizon-bag__button {
    appearance: none !important;
    -webkit-appearance: none !important;
    box-sizing: border-box !important;

    position: relative !important;

    width: 44px !important;
    min-width: 44px !important;
    height: 44px !important;
    min-height: 44px !important;

    margin: 0 !important;
    padding: 0 !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    border: 1px solid rgba(17,17,17,.10) !important;
    border-radius: 50% !important;

    background: rgba(255,255,255,.96) !important;
    color: #111 !important;

    box-shadow:
      0 6px 18px rgba(0,0,0,.12),
      0 2px 5px rgba(0,0,0,.06) !important;

    cursor: pointer !important;
    overflow: visible !important;

    transition:
      transform .24s cubic-bezier(.22,.61,.36,1),
      background-color .24s ease,
      color .24s ease,
      box-shadow .24s ease !important;
  }

  /* Bag + plus icon */
  .product-grid__item .universes-horizon-bag__icon {
    display: block !important;
    width: 20px !important;
    height: 20px !important;
    margin: 0 !important;
    padding: 0 !important;
    color: currentColor !important;
    stroke: currentColor !important;
    fill: none !important;
    pointer-events: none !important;
    transition:
      transform .24s cubic-bezier(.22,.61,.36,1) !important;
  }

  /* Small Add (+) badge */
  .product-grid__item .universes-horizon-bag__button::after {
    content: "+";
    position: absolute !important;
    right: -3px !important;
    bottom: -3px !important;

    width: 16px !important;
    height: 16px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    border: 2px solid #fff !important;
    border-radius: 50% !important;

    background: #111 !important;
    color: #fff !important;

    font-family: Arial, sans-serif !important;
    font-size: 10px !important;
    font-weight: 500 !important;
    line-height: 1 !important;

    box-shadow: 0 2px 6px rgba(0,0,0,.18) !important;
    z-index: 5 !important;

    transition:
      transform .24s cubic-bezier(.22,.61,.36,1),
      background-color .24s ease,
      color .24s ease !important;
  }

  /* Desktop hover */
  @media (hover: hover) and (min-width: 750px) {
    .product-grid__item .universes-horizon-bag__button:hover {
      transform: translateY(-2px) scale(1.035) !important;
      background: #111 !important;
      color: #fff !important;
      box-shadow:
        0 11px 26px rgba(0,0,0,.20),
        0 3px 8px rgba(0,0,0,.08) !important;
    }

    .product-grid__item .universes-horizon-bag__button:hover .universes-horizon-bag__icon {
      transform: scale(1.04) !important;
    }

    .product-grid__item .universes-horizon-bag__button:hover::after {
      background: #fff !important;
      color: #111 !important;
      transform: scale(1.08) rotate(90deg) !important;
    }
  }

  /* Keyboard accessibility */
  .product-grid__item .universes-horizon-bag__button:focus-visible {
    outline: 2px solid #111 !important;
    outline-offset: 3px !important;
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .product-grid__item .universes-horizon-bag {
      right: 8px !important;
      bottom: 8px !important;
      width: 42px !important;
      height: 42px !important;
    }

    .product-grid__item .universes-horizon-bag__button {
      width: 42px !important;
      min-width: 42px !important;
      height: 42px !important;
      min-height: 42px !important;
    }

    .product-grid__item .universes-horizon-bag__icon {
      width: 19px !important;
      height: 19px !important;
    }

    .product-grid__item .universes-horizon-bag__button::after {
      width: 15px !important;
      height: 15px !important;
      right: -3px !important;
      bottom: -3px !important;
      font-size: 9px !important;
    }
  }

</style>

<script>
  /*
   * Move each Quick Add bag INTO the product card's .card__inner.
   * This is what makes bottom/right positioning refer to the
   * product IMAGE area instead of the entire product card.
   */

  (function () {

    function positionUniversesQuickAdd(root) {

      root = root || document;

      var productItems = root.querySelectorAll
        ? root.querySelectorAll('.product-grid__item')
        : [];

      productItems.forEach(function (item) {

        var bag = item.querySelector('.universes-horizon-bag');

        if (!bag) return;

        /*
         * Dawn/product-card image wrapper.
         * .card__inner contains the product image/media area.
         */
        var imageContainer = item.querySelector('.card__inner');

        /*
         * Fallbacks in case the theme markup changes.
         */
        if (!imageContainer) {
          imageContainer = item.querySelector('.card__media');
        }

        if (!imageContainer) {
          imageContainer = item.querySelector('.card__media-container');
        }

        if (!imageContainer) return;

        /*
         * Prevent unnecessary DOM moves.
         */
        if (bag.parentElement !== imageContainer) {
          imageContainer.appendChild(bag);
        }

        /*
         * Make absolutely sure the image container is
         * the positioning parent.
         */
        imageContainer.style.position = 'relative';
      });
    }

    /*
     * Initial page load
     */
    function initQuickAdd() {
      positionUniversesQuickAdd(document);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initQuickAdd);
    } else {
      initQuickAdd();
    }

    /*
     * Shopify Theme Editor / AJAX section reloads
     */
    document.addEventListener('shopify:section:load', function (event) {
      positionUniversesQuickAdd(event.target);
    });

    /*
     * Re-run after dynamic product-grid updates.
     */
    document.addEventListener('shopify:section:reorder', function () {
      positionUniversesQuickAdd(document);
    });

  })();
</script>


{% schema %}

{
  "name": "t:names.collection",

  "class": "section",

  "settings": [

    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",

      "options": [

        {
          "value": "grid",
          "label": "t:options.grid"
        },

        {
          "value": "organic",
          "label": "t:options.editorial"
        }

      ],

      "default": "grid"
    },


    {
      "type": "range",
      "id": "products_per_page",

      "min": 8,
      "max": 32,
      "step": 8,

      "default": 16,

      "label": "t:settings.products_per_page"
    },


    {
      "type": "select",
      "id": "product_card_size",

      "label": "t:settings.card_size",

      "options": [

        {
          "value": "small",
          "label": "t:options.small"
        },

        {
          "value": "medium",
          "label": "t:options.medium"
        },

        {
          "value": "large",
          "label": "t:options.large"
        },

        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        },

        {
          "value": "extra-extra-large",
          "label": "t:options.extra_extra_large"
        }

      ],

      "default": "medium",

      "visible_if":
        "{{ section.settings.layout_type == 'grid' }}"
    },


    {
      "type": "color_scheme",
      "id": "color_scheme",

      "label": "t:settings.color_scheme",

      "info": "t:info.has_cards_info",

      "default": "scheme-1"
    },


    {
      "type": "header",
      "content": "t:content.layout"
    },


    {
      "type": "select",
      "id": "product_grid_width",

      "label": "t:settings.width",

      "options": [

        {
          "value": "centered",
          "label": "t:options.page"
        },

        {
          "value": "full-width",
          "label": "t:options.full"
        }

      ],

      "default": "centered"
    },


    {
      "type": "checkbox",
      "id": "full_width_on_mobile",

      "label": "t:settings.full_width_on_mobile",

      "default": true,

      "visible_if":
        "{{ section.settings.product_grid_width != 'full-width' }}"
    },


    {
      "type": "range",

      "id": "columns_gap_horizontal",

      "label": "t:settings.horizontal_gap",

      "min": 0,
      "max": 50,
      "step": 1,

      "unit": "px",

      "default": 16
    },


    {
      "type": "range",

      "id": "columns_gap_vertical",

      "label": "t:settings.vertical_gap",

      "min": 0,
      "max": 50,
      "step": 1,

      "unit": "px",

      "default": 16
    },


    {
      "type": "range",

      "id": "padding-inline-start",

      "label": "t:settings.left_padding",

      "min": 0,
      "max": 100,
      "step": 1,

      "unit": "px",

      "default": 0
    },


    {
      "type": "range",

      "id": "padding-inline-end",

      "label": "t:settings.right_padding",

      "min": 0,
      "max": 100,
      "step": 1,

      "unit": "px",

      "default": 0
    },


    {
      "type": "header",
      "content": "t:content.pagination"
    },


    {
      "type": "select",
      "id": "pagination_type",

      "label": "t:settings.type",

      "options": [

        {
          "value": "infinite",
          "label": "t:options.infinite"
        },

        {
          "value": "pagination",
          "label": "t:options.pagination"
        }

      ],

      "default": "pagination"
    },


    {
      "type": "range",

      "id": "padding-block-start-pagination",

      "label": "t:settings.padding_top",

      "min": 0,
      "max": 100,
      "step": 1,

      "unit": "px",

      "default": 50
    },


    {
      "type": "range",

      "id": "padding-block-end-pagination",

      "label": "t:settings.padding_bottom",

      "min": 0,
      "max": 100,
      "step": 1,

      "unit": "px",

      "default": 50
    },


    {
      "type": "header",
      "content": "t:content.section_padding"
    },


    {
      "type": "range",

      "id": "padding_top",

      "min": 0,
      "max": 100,
      "step": 1,

      "unit": "px",

      "label": "t:settings.top",

      "default": 36
    },


    {
      "type": "range",

      "id": "padding_bottom",

      "min": 0,
      "max": 100,
      "step": 1,

      "unit": "px",

      "label": "t:settings.bottom",

      "default": 36
    }

  ]
}

{% endschema %}