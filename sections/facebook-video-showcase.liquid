{% liquid
  assign section_id = 'fb-video-showcase-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="fb-video-showcase"
  data-section-id="{{ section.id }}"
>
  <div class="fb-video-showcase__container">

    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}

      <div class="fb-video-showcase__header">

        <div class="fb-video-showcase__heading-wrap">

          {% if section.settings.eyebrow != blank %}
            <div class="fb-video-showcase__eyebrow">
              {{ section.settings.eyebrow }}
            </div>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="fb-video-showcase__heading">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

        </div>

        {% if section.blocks.size > 1 %}

          <div class="fb-video-showcase__arrows">

            <button
              type="button"
              class="fb-video-showcase__arrow fb-video-showcase__arrow--prev"
              data-fb-prev
              aria-label="Previous video"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 18L9 12L15 6"></path>
              </svg>
            </button>

            <button
              type="button"
              class="fb-video-showcase__arrow fb-video-showcase__arrow--next"
              data-fb-next
              aria-label="Next video"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 18L15 12L9 6"></path>
              </svg>
            </button>

          </div>

        {% endif %}

      </div>

    {% endif %}


    {% if section.blocks.size > 0 %}

      <div
        class="fb-video-showcase__track"
        data-fb-track
        tabindex="0"
        aria-label="Featured product videos"
      >

        {% for block in section.blocks %}

          {% assign player_id = section_id | append: '-player-' | append: forloop.index %}

          <article
            class="fb-video-showcase__card{% if forloop.first %} is-active{% endif %}"
            data-fb-card
            data-index="{{ forloop.index0 }}"
            data-player-id="{{ player_id }}"
            {{ block.shopify_attributes }}
          >

            <div class="fb-video-showcase__media">

              {% if block.settings.embed_code != blank %}

                <div
                  id="{{ player_id }}"
                  class="fb-video-showcase__facebook-player"
                  data-facebook-embed
                  data-embed-code="{{ block.settings.embed_code | escape }}"
                  data-index="{{ forloop.index0 }}"
                >
                </div>

              {% else %}

                <div class="fb-video-showcase__placeholder">

                  <div class="fb-video-showcase__placeholder-icon">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M8 5v14l11-7z"></path>
                    </svg>

                  </div>

                  <span>
                    Paste Facebook embed code
                  </span>

                </div>

              {% endif %}


              {% if block.settings.badge != blank %}

                <div class="fb-video-showcase__badge">
                  {{ block.settings.badge }}
                </div>

              {% endif %}


              {% if block.settings.button_text != blank and block.settings.button_link != blank %}

                <div class="fb-video-showcase__cta-wrap">

                  <a
                    href="{{ block.settings.button_link }}"
                    class="fb-video-showcase__cta"
                  >

                    <span>
                      {{ block.settings.button_text }}
                    </span>

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h13"></path>
                      <path d="M13 6l6 6-6 6"></path>
                    </svg>

                  </a>

                </div>

              {% endif %}

            </div>

          </article>

        {% endfor %}

      </div>


      {% if section.blocks.size > 1 %}

        <div class="fb-video-showcase__bottom">

          <div class="fb-video-showcase__dots">

            {% for block in section.blocks %}

              <button
                type="button"
                class="fb-video-showcase__dot{% if forloop.first %} is-active{% endif %}"
                data-fb-dot="{{ forloop.index0 }}"
                aria-label="View video {{ forloop.index }}"
              ></button>

            {% endfor %}

          </div>

        </div>

      {% endif %}


    {% else %}

      <div class="fb-video-showcase__empty-section">
        Add Facebook Video blocks from the Theme Editor.
      </div>

    {% endif %}

  </div>
</section>


<style>

  /* ==========================================================
     ROOT
  ========================================================== */

  #{{ section_id }} {
    width: 100%;
    position: relative;
  }

  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }


  /* ==========================================================
     CONTAINER
  ========================================================== */

  #{{ section_id }} .fb-video-showcase__container {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;

    margin-left: auto;
    margin-right: auto;

    padding-top: {{ section.settings.padding_top }}px;
    padding-right: {{ section.settings.side_padding }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.side_padding }}px;
  }


  /* ==========================================================
     HEADER
  ========================================================== */

  #{{ section_id }} .fb-video-showcase__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 30px;

    margin-bottom: 22px;
  }

  #{{ section_id }} .fb-video-showcase__heading-wrap {
    min-width: 0;
  }

  #{{ section_id }} .fb-video-showcase__eyebrow {
    display: block;

    margin-bottom: 8px;

    font-size: 10px;
    line-height: 1.2;

    font-weight: 600;

    letter-spacing: .18em;
    text-transform: uppercase;

    opacity: .55;
  }

  #{{ section_id }} .fb-video-showcase__heading {
    margin: 0;

    font-size: clamp(27px, 3.5vw, 42px);
    line-height: .98;

    letter-spacing: -.045em;

    font-weight: 600;
  }


  /* ==========================================================
     ARROWS
  ========================================================== */

  #{{ section_id }} .fb-video-showcase__arrows {
    display: flex;

    gap: 8px;

    flex-shrink: 0;
  }

  #{{ section_id }} .fb-video-showcase__arrow {
    width: 42px;
    height: 42px;

    padding: 0;

    display: grid;
    place-items: center;

    border: 1px solid rgba(0,0,0,.16);

    border-radius: 50%;

    background: transparent;

    color: inherit;

    cursor: pointer;

    transition:
      background .25s ease,
      color .25s ease,
      border-color .25s ease,
      transform .25s ease;
  }

  #{{ section_id }} .fb-video-showcase__arrow svg {
    width: 16px;
    height: 16px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.7;

    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #{{ section_id }} .fb-video-showcase__arrow:hover {
    background: #111;

    color: #fff;

    border-color: #111;

    transform: translateY(-2px);
  }


  /* ==========================================================
     TRACK
  ========================================================== */

  #{{ section_id }} .fb-video-showcase__track {
    display: grid;

    grid-auto-flow: column;

    grid-auto-columns:
      calc(
        (
          100% -
          (
            {{ section.settings.gap }}px *
            ({{ section.settings.desktop_columns }} - 1)
          )
        )
        /
        {{ section.settings.desktop_columns }}
      );

    gap: {{ section.settings.gap }}px;

    overflow-x: auto;
    overflow-y: hidden;

    scroll-snap-type: x mandatory;

    scroll-behavior: smooth;

    scrollbar-width: none;

    -ms-overflow-style: none;

    padding: 3px 2px 12px;
  }

  #{{ section_id }} .fb-video-showcase__track::-webkit-scrollbar {
    display: none;
  }


  /* ==========================================================
     CARD
  ========================================================== */

  #{{ section_id }} .fb-video-showcase__card {
    position: relative;

    min-width: 0;

    aspect-ratio: 9 / 16;

    overflow: hidden;

    border-radius: {{ section.settings.radius }}px;

    background: #111;

    scroll-snap-align: start;

    isolation: isolate;

    box-shadow:
      0 12px 35px rgba(0,0,0,.09);

    transition:
      transform .35s cubic-bezier(.2,.7,.2,1),
      box-shadow .35s ease;
  }

  #{{ section_id }} .fb-video-showcase__card.is-active {
    z-index: 2;
  }

  #{{ section_id }} .fb-video-showcase__card:hover {
    transform: translateY(-4px);

    box-shadow:
      0 20px 45px rgba(0,0,0,.14);
  }


  /* ==========================================================
     MEDIA
  ========================================================== */

  #{{ section_id }} .fb-video-showcase__media {
    position: absolute;

    inset: 0;

    overflow: hidden;

    background: #111;
  }


  /* ==========================================================
     FACEBOOK PLAYER
  ========================================================== */

  #{{ section_id }} .fb-video-showcase__facebook-player {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    overflow: hidden;

    background: #111;

    z-index: 1;
  }


  #{{ section_id }} .fb-video-showcase__facebook-player .fb-video {
    position: absolute !important;

    inset: 0 !important;

    width: 100% !important;

    height: 100% !important;

    max-width: none !important;

    margin: 0 !important;
  }


  #{{ section_id }} .fb-video-showcase__facebook-player iframe {
    position: absolute !important;

    top: 50% !important;
    left: 50% !important;

    width: 100% !important;
    height: 100% !important;

    max-width: none !important;
    max-height: none !important;

    transform:
      translate(-50%, -50%) !important;

    border: 0 !important;

    margin: 0 !important;

    padding: 0 !important;

    display: block !important;
  }


  /* ==========================================================
     BADGE
  ========================================================== */

  #{{ section_id }} .fb-video-showcase__badge {
    position: absolute;

    top: 13px;
    left: 13px;

    z-index: 10;

    display: inline-flex;

    align-items: center;

    min-height: 26px;

    padding:
      6px 10px;

    border-radius: 999px;

    background:
      rgba(255,255,255,.94);

    color: #111;

    font-size: 9px;

    line-height: 1;

    font-weight: 700;

    letter-spacing: .12em;

    text-transform: uppercase;

    pointer-events: none;

    backdrop-filter:
      blur(8px);

    -webkit-backdrop-filter:
      blur(8px);
  }


  /* ==========================================================
     CTA
  ========================================================== */

  #{{ section_id }} .fb-video-showcase__cta-wrap {
    position: absolute;

    left: 14px;
    bottom: 14px;

    z-index: 10;

    display: flex;

    pointer-events: none;
  }

  #{{ section_id }} .fb-video-showcase__cta {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    min-height: 38px;

    padding:
      10px 15px;

    border-radius: 999px;

    background: #fff;

    color: #111;

    text-decoration: none;

    font-size: 10px;

    line-height: 1;

    font-weight: 700;

    letter-spacing: .08em;

    text-transform: uppercase;

    pointer-events: auto;

    transition:
      transform .25s ease,
      background .25s ease;
  }

  #{{ section_id }} .fb-video-showcase__cta svg {
    width: 14px;
    height: 14px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.8;

    stroke-linecap: round;

    stroke-linejoin: round;
  }

  #{{ section_id }} .fb-video-showcase__cta:hover {
    background: #f3f3f3;

    transform:
      translateX(3px);
  }


  /* ==========================================================
     PLACEHOLDER
  ========================================================== */

  #{{ section_id }} .fb-video-showcase__placeholder {
    position: absolute;

    inset: 0;

    z-index: 1;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    gap: 12px;

    color: rgba(255,255,255,.65);

    background:
      radial-gradient(
        circle at center,
        #292929,
        #101010 70%
      );

    font-size: 11px;

    text-align: center;
  }

  #{{ section_id }} .fb-video-showcase__placeholder-icon {
    width: 42px;
    height: 42px;

    border:
      1px solid rgba(255,255,255,.2);

    border-radius: 50%;

    display: grid;

    place-items: center;
  }

  #{{ section_id }} .fb-video-showcase__placeholder-icon svg {
    width: 18px;
    height: 18px;

    fill: currentColor;
  }


  /* ==========================================================
     DOTS
  ========================================================== */

  #{{ section_id }} .fb-video-showcase__bottom {
    display: flex;

    align-items: center;

    justify-content: center;

    margin-top: 8px;
  }

  #{{ section_id }} .fb-video-showcase__dots {
    display: flex;

    align-items: center;

    gap: 6px;
  }

  #{{ section_id }} .fb-video-showcase__dot {
    width: 6px;
    height: 6px;

    padding: 0;

    border: 0;

    border-radius: 999px;

    background:
      rgba(0,0,0,.20);

    cursor: pointer;

    transition:
      width .3s ease,
      background .3s ease;
  }

  #{{ section_id }} .fb-video-showcase__dot.is-active {
    width: 22px;

    background: #111;
  }


  /* ==========================================================
     MOBILE
  ========================================================== */

  @media screen and (max-width: 989px) {

    #{{ section_id }} .fb-video-showcase__track {
      grid-auto-columns:
        calc(
          (100% - {{ section.settings.gap }}px)
          / 2.25
        );
    }

  }


  @media screen and (max-width: 749px) {

    #{{ section_id }} .fb-video-showcase__container {
      padding-left:
        {{ section.settings.mobile_side_padding }}px;

      padding-right:
        {{ section.settings.mobile_side_padding }}px;
    }

    #{{ section_id }} .fb-video-showcase__header {
      margin-bottom: 17px;

      align-items: center;
    }

    #{{ section_id }} .fb-video-showcase__heading {
      font-size: 28px;
    }

    #{{ section_id }} .fb-video-showcase__arrows {
      display: none;
    }

    #{{ section_id }} .fb-video-showcase__track {

      grid-auto-columns:
        {{ section.settings.mobile_width }}%;

      gap: 11px;

      margin-right:
        -{{ section.settings.mobile_side_padding }}px;

      padding-right:
        {{ section.settings.mobile_side_padding }}px;

      scroll-snap-type:
        x mandatory;
    }

    #{{ section_id }} .fb-video-showcase__card:hover {
      transform: none;
    }

    #{{ section_id }} .fb-video-showcase__badge {
      top: 11px;
      left: 11px;
    }

    #{{ section_id }} .fb-video-showcase__cta-wrap {
      left: 11px;
      bottom: 11px;
    }

  }


  /* ==========================================================
     REDUCED MOTION
  ========================================================== */

  @media (prefers-reduced-motion: reduce) {

    #{{ section_id }} .fb-video-showcase__track {
      scroll-behavior: auto;
    }

    #{{ section_id }} .fb-video-showcase__card,
    #{{ section_id }} .fb-video-showcase__arrow,
    #{{ section_id }} .fb-video-showcase__cta,
    #{{ section_id }} .fb-video-showcase__dot {
      transition: none;
    }

  }

</style>


<script>

(function() {

  'use strict';


  /* ==========================================================
     SECTION
  ========================================================== */

  const root =
    document.getElementById(
      '{{ section_id }}'
    );


  if (!root) {
    return;
  }


  if (
    root.dataset.initialized === 'true'
  ) {
    return;
  }


  root.dataset.initialized =
    'true';


  const track =
    root.querySelector(
      '[data-fb-track]'
    );


  const cards =
    Array.from(
      root.querySelectorAll(
        '[data-fb-card]'
      )
    );


  const dots =
    Array.from(
      root.querySelectorAll(
        '[data-fb-dot]'
      )
    );


  const previousButton =
    root.querySelector(
      '[data-fb-prev]'
    );


  const nextButton =
    root.querySelector(
      '[data-fb-next]'
    );


  if (!track || !cards.length) {
    return;
  }


  /* ==========================================================
     FACEBOOK PLAYERS
  ========================================================== */

  const players = {};

  let activeIndex = 0;

  let facebookReady = false;

  let sdkLoading = false;


  /* ==========================================================
     DECODE EMBED URL
  ========================================================== */

  function getFacebookUrl(embedCode) {

    if (!embedCode) {
      return null;
    }


    const wrapper =
      document.createElement(
        'div'
      );


    wrapper.innerHTML =
      embedCode;


    const iframe =
      wrapper.querySelector(
        'iframe'
      );


    if (!iframe) {
      return null;
    }


    const src =
      iframe.getAttribute(
        'src'
      );


    if (!src) {
      return null;
    }


    try {

      const url =
        new URL(
          src,
          window.location.href
        );


      const href =
        url.searchParams.get(
          'href'
        );


      if (href) {

        return decodeURIComponent(
          href
        );

      }


      return src;

    } catch (error) {

      return null;

    }

  }


  /* ==========================================================
     LOAD FACEBOOK SDK
  ========================================================== */

  function loadFacebookSDK() {

    if (
      window.FB &&
      typeof window.FB.init === 'function'
    ) {

      initializeFacebook();

      return;

    }


    if (sdkLoading) {
      return;
    }


    sdkLoading = true;


    window.fbAsyncInit =
      function() {

        initializeFacebook();

      };


    const existing =
      document.getElementById(
        'facebook-jssdk'
      );


    if (existing) {

      return;

    }


    const script =
      document.createElement(
        'script'
      );


    script.id =
      'facebook-jssdk';


    script.async = true;

    script.defer = true;

    script.crossOrigin =
      'anonymous';


    script.src =
      'https://connect.facebook.net/en_US/sdk.js';


    document.head.appendChild(
      script
    );

  }


  /* ==========================================================
     INITIALIZE FACEBOOK
  ========================================================== */

  function initializeFacebook() {

    if (
      !window.FB ||
      facebookReady
    ) {
      return;
    }


    facebookReady = true;


    try {

      window.FB.init({

        xfbml: false,

        version: 'v23.0'

      });

    } catch (error) {

      try {

        window.FB.init({
          xfbml: false
        });

      } catch (secondError) {

        return;

      }

    }


    renderFacebookPlayers();

  }


  /* ==========================================================
     RENDER FACEBOOK PLAYERS
  ========================================================== */

  function renderFacebookPlayers() {

    const embedElements =
      Array.from(
        root.querySelectorAll(
          '[data-facebook-embed]'
        )
      );


    embedElements.forEach(
      function(element) {

        const embedCode =
          element.dataset.embedCode;


        const videoUrl =
          getFacebookUrl(
            embedCode
          );


        if (!videoUrl) {
          return;
        }


        element.innerHTML = '';


        const player =
          document.createElement(
            'div'
          );


        player.className =
          'fb-video';


        player.id =
          element.id;


        player.setAttribute(
          'data-href',
          videoUrl
        );


        player.setAttribute(
          'data-width',
          '100%'
        );


        player.setAttribute(
          'data-allowfullscreen',
          'true'
        );


        /*
         * We deliberately use autoplay false here.
         *
         * The API will mute and play only the
         * currently active video.
         */

        player.setAttribute(
          'data-autoplay',
          'false'
        );


        player.setAttribute(
          'data-show-text',
          'false'
        );


        element.appendChild(
          player
        );

      }
    );


    try {

      window.FB.XFBML.parse(
        root
      );

    } catch (error) {

      return;

    }


    /*
     * Facebook sends xfbml.ready when
     * each embedded video is ready.
     */

    window.FB.Event.subscribe(
      'xfbml.ready',
      function(message) {

        if (
          !message ||
          message.type !== 'video' ||
          !message.instance
        ) {
          return;
        }


        const player =
          message.instance;


        const playerId =
          message.id;


        players[playerId] =
          player;


        /*
         * IMPORTANT:
         *
         * Always mute the player first.
         */

        try {
          player.mute();
        } catch (error) {}


        /*
         * Video started event.
         */

        try {

          player.subscribe(
            'startedPlaying',
            function() {

              const card =
                document.getElementById(
                  playerId
                );


              if (!card) {
                return;
              }


              const index =
                parseInt(
                  card.closest(
                    '[data-fb-card]'
                  ).dataset.index,
                  10
                );


              if (
                index === activeIndex
              ) {

                setActiveCard(
                  index,
                  false
                );

              }

            }
          );

        } catch (error) {}


        /*
         * VIDEO FINISHED.
         *
         * This is the important part.
         *
         * The slider does NOT use a timer.
         *
         * Facebook's finishedPlaying event
         * triggers the next video.
         */

        try {

          player.subscribe(
            'finishedPlaying',
            function() {

              const card =
                document.getElementById(
                  playerId
                );


              if (!card) {
                return;
              }


              const parentCard =
                card.closest(
                  '[data-fb-card]'
                );


              if (!parentCard) {
                return;
              }


              const finishedIndex =
                parseInt(
                  parentCard.dataset.index,
                  10
                );


              /*
               * Only advance if this is
               * the currently active video.
               */

              if (
                finishedIndex === activeIndex
              ) {

                goTo(
                  activeIndex + 1,
                  true
                );

              }

            }
          );

        } catch (error) {}


        /*
         * Pause event.
         */

        try {

          player.subscribe(
            'paused',
            function() {

              /*
               * Intentionally do nothing.
               *
               * Pausing a video does NOT
               * advance the slider.
               */

            }
          );

        } catch (error) {}


        /*
         * If this is the first player,
         * start it muted.
         */

        if (
          playerId ===
          '{{ section_id }}-player-1'
        ) {

          window.setTimeout(
            function() {

              playPlayer(
                playerId
              );

            },
            500
          );

        }

      }
    );

  }


  /* ==========================================================
     PAUSE PLAYER
  ========================================================== */

  function pausePlayer(playerId) {

    const player =
      players[playerId];


    if (!player) {
      return;
    }


    try {

      player.pause();

    } catch (error) {}

  }


  /* ==========================================================
     PLAY PLAYER MUTED
  ========================================================== */

  function playPlayer(playerId) {

    const player =
      players[playerId];


    if (!player) {
      return;
    }


    /*
     * Always mute before playing.
     */

    try {

      player.mute();

    } catch (error) {}


    /*
     * Small delay gives Facebook time
     * to finish initializing the iframe.
     */

    window.setTimeout(
      function() {

        try {

          player.mute();

        } catch (error) {}


        try {

          player.play();

        } catch (error) {}

      },
      100
    );

  }


  /* ==========================================================
     PAUSE ALL
  ========================================================== */

  function pauseAllPlayers() {

    Object.keys(
      players
    ).forEach(
      function(playerId) {

        pausePlayer(
          playerId
        );

      }
    );

  }


  /* ==========================================================
     GET STEP
  ========================================================== */

  function getStep() {

    if (!cards[0]) {
      return 0;
    }


    const cardWidth =
      cards[0].getBoundingClientRect().width;


    const styles =
      window.getComputedStyle(
        track
      );


    const gap =
      parseFloat(
        styles.columnGap ||
        styles.gap ||
        0
      );


    return cardWidth + gap;

  }


  /* ==========================================================
     UPDATE DOTS
  ========================================================== */

  function updateDots(index) {

    dots.forEach(
      function(dot, dotIndex) {

        dot.classList.toggle(
          'is-active',
          dotIndex === index
        );

      }
    );

  }


  /* ==========================================================
     ACTIVE CARD
  ========================================================== */

  function setActiveCard(
    index,
    shouldPlay
  ) {

    if (!cards.length) {
      return;
    }


    if (index < 0) {
      index =
        cards.length - 1;
    }


    if (
      index >= cards.length
    ) {
      index = 0;
    }


    activeIndex =
      index;


    cards.forEach(
      function(card, cardIndex) {

        card.classList.toggle(
          'is-active',
          cardIndex === index
        );

      }
    );


    updateDots(
      index
    );


    if (shouldPlay) {

      pauseAllPlayers();


      const card =
        cards[index];


      if (!card) {
        return;
      }


      const playerId =
        card.dataset.playerId;


      playPlayer(
        playerId
      );

    }

  }


  /* ==========================================================
     GO TO
  ========================================================== */

  function goTo(
    index,
    playVideo
  ) {

    if (!cards.length) {
      return;
    }


    let target =
      index;


    if (target < 0) {
      target =
        cards.length - 1;
    }


    if (
      target >= cards.length
    ) {
      target = 0;
    }


    const step =
      getStep();


    track.scrollTo({

      left:
        target * step,

      behavior:
        window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches
          ? 'auto'
          : 'smooth'

    });


    setActiveCard(
      target,
      playVideo
    );

  }


  /* ==========================================================
     PREVIOUS
  ========================================================== */

  if (previousButton) {

    previousButton.addEventListener(
      'click',
      function() {

        goTo(
          activeIndex - 1,
          true
        );

      }
    );

  }


  /* ==========================================================
     NEXT
  ========================================================== */

  if (nextButton) {

    nextButton.addEventListener(
      'click',
      function() {

        goTo(
          activeIndex + 1,
          true
        );

      }
    );

  }


  /* ==========================================================
     DOTS
  ========================================================== */

  dots.forEach(
    function(dot) {

      dot.addEventListener(
        'click',
        function() {

          const index =
            parseInt(
              dot.dataset.fbDot,
              10
            );


          if (
            Number.isNaN(index)
          ) {
            return;
          }


          goTo(
            index,
            true
          );

        }
      );

    }
  );


  /* ==========================================================
     SCROLL DETECTION
  ========================================================== */

  let scrollTimeout =
    null;


  track.addEventListener(
    'scroll',
    function() {

      if (scrollTimeout) {
        window.clearTimeout(
          scrollTimeout
        );
      }


      scrollTimeout =
        window.setTimeout(
          function() {

            const step =
              getStep();


            if (!step) {
              return;
            }


            const index =
              Math.round(
                track.scrollLeft /
                step
              );


            if (
              index !== activeIndex
            ) {

              setActiveCard(
                Math.min(
                  Math.max(
                    index,
                    0
                  ),
                  cards.length - 1
                ),
                true
              );

            }

          },
          120
        );

    },
    {
      passive: true
    }
  );


  /* ==========================================================
     KEYBOARD
  ========================================================== */

  track.addEventListener(
    'keydown',
    function(event) {

      if (
        event.key ===
        'ArrowRight'
      ) {

        event.preventDefault();

        goTo(
          activeIndex + 1,
          true
        );

      }


      if (
        event.key ===
        'ArrowLeft'
      ) {

        event.preventDefault();

        goTo(
          activeIndex - 1,
          true
        );

      }

    }
  );


  /* ==========================================================
     RESIZE
  ========================================================== */

  window.addEventListener(
    'resize',
    function() {

      const step =
        getStep();


      if (!step) {
        return;
      }


      track.scrollTo({

        left:
          activeIndex * step,

        behavior:
          'auto'

      });

    },
    {
      passive: true
    }
  );


  /* ==========================================================
     INITIALIZE
  ========================================================== */

  loadFacebookSDK();


  /*
   * Keep the first card selected immediately.
   */

  setActiveCard(
    0,
    false
  );


})();

</script>


