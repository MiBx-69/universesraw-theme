{% liquid
  assign section_id = 'fb-video-showcase-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="fb-video-showcase"
  data-section-id="{{ section.id }}"
>
  <div class="fb-video-showcase__container">

    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="fb-video-showcase__header">

        <div class="fb-video-showcase__heading-wrap">

          {% if section.settings.eyebrow != blank %}
            <div class="fb-video-showcase__eyebrow">
              {{ section.settings.eyebrow }}
            </div>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="fb-video-showcase__heading">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

        </div>

        {% if section.blocks.size > 1 %}
          <div class="fb-video-showcase__arrows">

            <button
              type="button"
              class="fb-video-showcase__arrow fb-video-showcase__arrow--prev"
              aria-label="Previous video"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 18L9 12L15 6"></path>
              </svg>
            </button>

            <button
              type="button"
              class="fb-video-showcase__arrow fb-video-showcase__arrow--next"
              aria-label="Next video"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 18L15 12L9 6"></path>
              </svg>
            </button>

          </div>
        {% endif %}

      </div>
    {% endif %}


    {% if section.blocks.size > 0 %}

      <div
        class="fb-video-showcase__track"
        data-video-track
        tabindex="0"
        aria-label="Featured product videos"
      >

        {% for block in section.blocks %}

          <article
            class="fb-video-showcase__card"
            data-video-card
            {{ block.shopify_attributes }}
          >

            <div class="fb-video-showcase__media">

              {% if block.settings.embed_code != blank %}

                <div
                  class="fb-video-showcase__embed"
                  data-facebook-embed
                  data-first-video="{% if forloop.first %}true{% else %}false{% endif %}"
                >
                  {{ block.settings.embed_code }}
                </div>

              {% else %}

                <div class="fb-video-showcase__placeholder">

                  <div class="fb-video-showcase__placeholder-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M8 5v14l11-7z"></path>
                    </svg>
                  </div>

                  <span>Paste Facebook embed code</span>

                </div>

              {% endif %}


              {% if block.settings.badge != blank %}
                <div class="fb-video-showcase__badge">
                  {{ block.settings.badge }}
                </div>
              {% endif %}


              {% if block.settings.button_text != blank and block.settings.button_link != blank %}

                <div class="fb-video-showcase__cta-wrap">

                  <a
                    href="{{ block.settings.button_link }}"
                    class="fb-video-showcase__cta"
                  >
                    <span>{{ block.settings.button_text }}</span>

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h13"></path>
                      <path d="M13 6l6 6-6 6"></path>
                    </svg>
                  </a>

                </div>

              {% endif %}

            </div>

          </article>

        {% endfor %}

      </div>


      {% if section.blocks.size > 1 %}

        <div class="fb-video-showcase__bottom">

          <div class="fb-video-showcase__dots">

            {% for block in section.blocks %}

              <button
                type="button"
                class="fb-video-showcase__dot{% if forloop.first %} is-active{% endif %}"
                data-dot="{{ forloop.index0 }}"
                aria-label="View video {{ forloop.index }}"
              ></button>

            {% endfor %}

          </div>

        </div>

      {% endif %}

    {% else %}

      <div class="fb-video-showcase__empty-section">
        Add Facebook Video blocks from the Theme Editor.
      </div>

    {% endif %}

  </div>
</section>


<style>

  #{{ section_id }} {
    width: 100%;
    position: relative;
  }

  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }


  /* ==========================================
     CONTAINER
  ========================================== */

  #{{ section_id }} .fb-video-showcase__container {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;

    margin-left: auto;
    margin-right: auto;

    padding-top: {{ section.settings.padding_top }}px;
    padding-right: {{ section.settings.side_padding }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.side_padding }}px;
  }


  /* ==========================================
     HEADER
  ========================================== */

  #{{ section_id }} .fb-video-showcase__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 30px;

    margin-bottom: 22px;
  }

  #{{ section_id }} .fb-video-showcase__heading-wrap {
    min-width: 0;
  }

  #{{ section_id }} .fb-video-showcase__eyebrow {
    display: block;

    margin-bottom: 8px;

    font-size: 10px;
    line-height: 1.2;

    font-weight: 600;

    letter-spacing: .18em;
    text-transform: uppercase;

    opacity: .55;
  }

  #{{ section_id }} .fb-video-showcase__heading {
    margin: 0;

    font-size: clamp(27px, 3.5vw, 42px);
    line-height: .98;

    letter-spacing: -.045em;

    font-weight: 600;
  }


  /* ==========================================
     ARROWS
  ========================================== */

  #{{ section_id }} .fb-video-showcase__arrows {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  #{{ section_id }} .fb-video-showcase__arrow {
    width: 42px;
    height: 42px;

    padding: 0;

    display: grid;
    place-items: center;

    border: 1px solid rgba(0,0,0,.16);

    border-radius: 50%;

    background: transparent;

    color: inherit;

    cursor: pointer;

    transition:
      background .25s ease,
      color .25s ease,
      border-color .25s ease,
      transform .25s ease;
  }

  #{{ section_id }} .fb-video-showcase__arrow svg {
    width: 16px;
    height: 16px;

    fill: none;

    stroke: currentColor;
    stroke-width: 1.7;

    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #{{ section_id }} .fb-video-showcase__arrow:hover {
    background: #111;
    color: #fff;

    border-color: #111;

    transform: translateY(-2px);
  }


  /* ==========================================
     SLIDER
  ========================================== */

  #{{ section_id }} .fb-video-showcase__track {
    display: grid;

    grid-auto-flow: column;

    grid-auto-columns:
      calc(
        (
          100% -
          (
            {{ section.settings.gap }}px *
            ({{ section.settings.desktop_columns }} - 1)
          )
        )
        /
        {{ section.settings.desktop_columns }}
      );

    gap: {{ section.settings.gap }}px;

    overflow-x: auto;
    overflow-y: hidden;

    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;

    scrollbar-width: none;
    -ms-overflow-style: none;

    padding: 3px 2px 12px;
  }

  #{{ section_id }} .fb-video-showcase__track::-webkit-scrollbar {
    display: none;
  }


  /* ==========================================
     CARD
  ========================================== */

  #{{ section_id }} .fb-video-showcase__card {
    position: relative;

    min-width: 0;

    aspect-ratio: 9 / 16;

    overflow: hidden;

    border-radius: {{ section.settings.radius }}px;

    background: #111;

    scroll-snap-align: start;

    isolation: isolate;

    box-shadow:
      0 12px 35px rgba(0,0,0,.09);

    transition:
      transform .35s cubic-bezier(.2,.7,.2,1),
      box-shadow .35s ease;
  }

  #{{ section_id }} .fb-video-showcase__card:hover {
    transform: translateY(-4px);

    box-shadow:
      0 20px 45px rgba(0,0,0,.14);
  }


  /* ==========================================
     MEDIA
  ========================================== */

  #{{ section_id }} .fb-video-showcase__media {
    position: absolute;

    inset: 0;

    overflow: hidden;

    background: #111;
  }


  /* ==========================================
     FACEBOOK EMBED
  ========================================== */

  #{{ section_id }} .fb-video-showcase__embed {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    overflow: hidden;

    background: #111;

    z-index: 1;
  }


  #{{ section_id }} .fb-video-showcase__embed iframe {
    position: absolute;

    top: 50%;
    left: 50%;

    width: 100% !important;
    height: 100% !important;

    max-width: none !important;
    max-height: none !important;

    transform: translate(-50%, -50%);

    display: block;

    border: 0 !important;

    margin: 0 !important;

    padding: 0 !important;

    background: #111;
  }


  /* ==========================================
     BADGE
  ========================================== */

  #{{ section_id }} .fb-video-showcase__badge {
    position: absolute;

    top: 13px;
    left: 13px;

    z-index: 5;

    display: inline-flex;
    align-items: center;

    min-height: 26px;

    padding: 6px 10px;

    border-radius: 999px;

    background: rgba(255,255,255,.94);

    color: #111;

    font-size: 9px;
    line-height: 1;

    font-weight: 700;

    letter-spacing: .12em;
    text-transform: uppercase;

    pointer-events: none;

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }


  /* ==========================================
     CTA
  ========================================== */

  #{{ section_id }} .fb-video-showcase__cta-wrap {
    position: absolute;

    left: 14px;
    bottom: 14px;

    z-index: 6;

    display: flex;

    pointer-events: none;
  }

  #{{ section_id }} .fb-video-showcase__cta {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    min-height: 38px;

    padding: 10px 15px;

    border-radius: 999px;

    background: #fff;

    color: #111;

    text-decoration: none;

    font-size: 10px;
    line-height: 1;

    font-weight: 700;

    letter-spacing: .08em;
    text-transform: uppercase;

    pointer-events: auto;

    transition:
      transform .25s ease,
      background .25s ease;
  }

  #{{ section_id }} .fb-video-showcase__cta svg {
    width: 14px;
    height: 14px;

    fill: none;

    stroke: currentColor;
    stroke-width: 1.8;

    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #{{ section_id }} .fb-video-showcase__cta:hover {
    background: #f3f3f3;

    transform: translateX(3px);
  }


  /* ==========================================
     PLACEHOLDER
  ========================================== */

  #{{ section_id }} .fb-video-showcase__placeholder {
    position: absolute;

    inset: 0;

    z-index: 1;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 12px;

    padding: 20px;

    color: rgba(255,255,255,.65);

    background:
      radial-gradient(
        circle at center,
        #292929,
        #101010 70%
      );

    font-size: 11px;

    text-align: center;
  }

  #{{ section_id }} .fb-video-showcase__placeholder-icon {
    width: 42px;
    height: 42px;

    border: 1px solid rgba(255,255,255,.2);

    border-radius: 50%;

    display: grid;
    place-items: center;
  }

  #{{ section_id }} .fb-video-showcase__placeholder svg {
    width: 18px;
    height: 18px;

    fill: currentColor;
  }


  /* ==========================================
     DOTS
  ========================================== */

  #{{ section_id }} .fb-video-showcase__bottom {
    display: flex;

    align-items: center;
    justify-content: center;

    margin-top: 8px;
  }

  #{{ section_id }} .fb-video-showcase__dots {
    display: flex;

    align-items: center;

    gap: 6px;
  }

  #{{ section_id }} .fb-video-showcase__dot {
    width: 6px;
    height: 6px;

    padding: 0;

    border: 0;

    border-radius: 999px;

    background: rgba(0,0,0,.20);

    cursor: pointer;

    transition:
      width .3s ease,
      background .3s ease;
  }

  #{{ section_id }} .fb-video-showcase__dot.is-active {
    width: 22px;

    background: #111;
  }


  /* ==========================================
     EMPTY SECTION
  ========================================== */

  #{{ section_id }} .fb-video-showcase__empty-section {
    padding: 45px 20px;

    border:
      1px dashed rgba(0,0,0,.18);

    border-radius:
      {{ section.settings.radius }}px;

    text-align: center;

    font-size: 13px;

    opacity: .6;
  }


  /* ==========================================
     TABLET
  ========================================== */

  @media screen and (max-width: 989px) {

    #{{ section_id }} .fb-video-showcase__track {
      grid-auto-columns:
        calc(
          (100% - {{ section.settings.gap }}px)
          / 2.25
        );
    }

  }


  /* ==========================================
     MOBILE
  ========================================== */

  @media screen and (max-width: 749px) {

    #{{ section_id }} .fb-video-showcase__container {
      padding-left:
        {{ section.settings.mobile_side_padding }}px;

      padding-right:
        {{ section.settings.mobile_side_padding }}px;
    }

    #{{ section_id }} .fb-video-showcase__header {
      margin-bottom: 17px;

      align-items: center;
    }

    #{{ section_id }} .fb-video-showcase__heading {
      font-size: 28px;
    }

    #{{ section_id }} .fb-video-showcase__arrows {
      display: none;
    }

    #{{ section_id }} .fb-video-showcase__track {
      grid-auto-columns:
        {{ section.settings.mobile_width }}%;

      gap: 11px;

      margin-right:
        -{{ section.settings.mobile_side_padding }}px;

      padding-right:
        {{ section.settings.mobile_side_padding }}px;

      scroll-snap-type: x mandatory;
    }

    #{{ section_id }} .fb-video-showcase__card:hover {
      transform: none;
    }

    #{{ section_id }} .fb-video-showcase__badge {
      top: 11px;
      left: 11px;
    }

    #{{ section_id }} .fb-video-showcase__cta-wrap {
      left: 11px;
      bottom: 11px;
    }

  }


  /* ==========================================
     REDUCED MOTION
  ========================================== */

  @media (prefers-reduced-motion: reduce) {

    #{{ section_id }} .fb-video-showcase__track {
      scroll-behavior: auto;
    }

    #{{ section_id }} .fb-video-showcase__card,
    #{{ section_id }} .fb-video-showcase__arrow,
    #{{ section_id }} .fb-video-showcase__cta,
    #{{ section_id }} .fb-video-showcase__dot {
      transition: none;
    }

  }

</style>


<script>

(function() {

  const root = document.getElementById(
    '{{ section_id }}'
  );

  if (!root) {
    return;
  }

  if (root.dataset.initialized === 'true') {
    return;
  }

  root.dataset.initialized = 'true';


  const track = root.querySelector(
    '[data-video-track]'
  );

  const cards = Array.from(
    root.querySelectorAll(
      '[data-video-card]'
    )
  );

  const dots = Array.from(
    root.querySelectorAll(
      '[data-dot]'
    )
  );

  const previousButton = root.querySelector(
    '.fb-video-showcase__arrow--prev'
  );

  const nextButton = root.querySelector(
    '.fb-video-showcase__arrow--next'
  );


  /*
   * Enhance the Facebook embed code.
   *
   * We do NOT replace the Facebook video URL.
   * We only use the exact iframe that the
   * merchant pasted into the Theme Editor.
   *
   * For the first video we add autoplay/mute
   * parameters when the Facebook embed supports
   * them.
   */

  const embeds = Array.from(
    root.querySelectorAll(
      '[data-facebook-embed]'
    )
  );


  embeds.forEach(function(embed, index) {

    const iframe = embed.querySelector(
      'iframe'
    );

    if (!iframe) {
      return;
    }


    iframe.setAttribute(
      'loading',
      index === 0 ? 'eager' : 'lazy'
    );


    iframe.setAttribute(
      'allow',
      'autoplay; encrypted-media; picture-in-picture; web-share'
    );


    if (index === 0) {

      try {

        const source =
          iframe.getAttribute('src');

        if (source) {

          const url =
            new URL(
              source,
              window.location.href
            );


          if (!url.searchParams.has('autoplay')) {
            url.searchParams.set(
              'autoplay',
              'true'
            );
          }


          if (!url.searchParams.has('mute')) {
            url.searchParams.set(
              'mute',
              'true'
            );
          }


          if (!url.searchParams.has('playsinline')) {
            url.searchParams.set(
              'playsinline',
              'true'
            );
          }


          iframe.setAttribute(
            'src',
            url.toString()
          );

        }

      } catch (error) {
        /*
         * Keep the original embed untouched
         * if the browser cannot parse it.
         */
      }

    }

  });


  if (!track || cards.length < 2) {
    return;
  }


  const autoplayEnabled =
    {{ section.settings.autoplay | json }};

  const autoplayDelay =
    {{ section.settings.autoplay_speed | times: 1000 }};


  let autoplayTimer = null;

  let userInteracted = false;


  /* ==========================================
     SLIDE STEP
  ========================================== */

  function getStep() {

    if (!cards[0]) {
      return 0;
    }


    const cardWidth =
      cards[0].getBoundingClientRect().width;


    const styles =
      window.getComputedStyle(track);


    const gap =
      parseFloat(
        styles.columnGap ||
        styles.gap ||
        0
      );


    return cardWidth + gap;
  }


  /* ==========================================
     CURRENT INDEX
  ========================================== */

  function getCurrentIndex() {

    const step = getStep();

    if (!step) {
      return 0;
    }


    return Math.round(
      track.scrollLeft / step
    );
  }


  /* ==========================================
     UPDATE DOTS
  ========================================== */

  function updateDots(index) {

    dots.forEach(function(dot, dotIndex) {

      dot.classList.toggle(
        'is-active',
        dotIndex === index
      );

    });

  }


  /* ==========================================
     GO TO SLIDE
  ========================================== */

  function goTo(index) {

    let target = index;


    if (target < 0) {
      target = cards.length - 1;
    }


    if (target >= cards.length) {
      target = 0;
    }


    const step = getStep();

    track.scrollTo({
      left: target * step,

      behavior:
        window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches
          ? 'auto'
          : 'smooth'
    });


    updateDots(target);
  }


  /* ==========================================
     AUTOPLAY
  ========================================== */

  function stopAutoplay() {

    if (autoplayTimer) {

      window.clearInterval(
        autoplayTimer
      );

      autoplayTimer = null;
    }

  }


  function startAutoplay() {

    if (
      !autoplayEnabled ||
      cards.length < 2
    ) {
      return;
    }


    stopAutoplay();


    autoplayTimer =
      window.setInterval(function() {

        if (
          document.hidden ||
          userInteracted
        ) {
          return;
        }


        if (
          window.matchMedia(
            '(prefers-reduced-motion: reduce)'
          ).matches
        ) {
          return;
        }


        goTo(
          getCurrentIndex() + 1
        );

      }, autoplayDelay);

  }


  /* ==========================================
     PREVIOUS
  ========================================== */

  if (previousButton) {

    previousButton.addEventListener(
      'click',
      function() {

        userInteracted = true;

        stopAutoplay();

        goTo(
          getCurrentIndex() - 1
        );

      }
    );

  }


  /* ==========================================
     NEXT
  ========================================== */

  if (nextButton) {

    nextButton.addEventListener(
      'click',
      function() {

        userInteracted = true;

        stopAutoplay();

        goTo(
          getCurrentIndex() + 1
        );

      }
    );

  }


  /* ==========================================
     DOTS
  ========================================== */

  dots.forEach(function(dot) {

    dot.addEventListener(
      'click',
      function() {

        userInteracted = true;

        stopAutoplay();


        const index =
          parseInt(
            dot.dataset.dot,
            10
          );


        if (!Number.isNaN(index)) {
          goTo(index);
        }

      }
    );

  });


  /* ==========================================
     SCROLL
  ========================================== */

  track.addEventListener(
    'scroll',
    function() {

      const index =
        getCurrentIndex();


      updateDots(
        Math.min(
          Math.max(index, 0),
          dots.length - 1
        )
      );

    },
    {
      passive: true
    }
  );


  /* ==========================================
     TOUCH / DRAG
  ========================================== */

  track.addEventListener(
    'pointerdown',
    function() {

      userInteracted = true;

      stopAutoplay();

    },
    {
      passive: true
    }
  );


  /* ==========================================
     KEYBOARD
  ========================================== */

  track.addEventListener(
    'keydown',
    function(event) {

      if (event.key === 'ArrowRight') {

        event.preventDefault();

        userInteracted = true;

        stopAutoplay();

        goTo(
          getCurrentIndex() + 1
        );

      }


      if (event.key === 'ArrowLeft') {

        event.preventDefault();

        userInteracted = true;

        stopAutoplay();

        goTo(
          getCurrentIndex() - 1
        );

      }

    }
  );


  /* ==========================================
     INITIALIZE
  ========================================== */

  updateDots(0);

  startAutoplay();


})();

</script>


{% schema %}

{
  "name": "Facebook Video Showcase",

  "tag": "section",

  "class": "section-facebook-video-showcase",

  "settings": [

    {
      "type": "header",
      "content": "Heading"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Watch the collection"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Videos"
    },


    {
      "type": "header",
      "content": "Slider"
    },

    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Automatically move slider",
      "default": true
    },

    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Slider interval",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },

    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop videos",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },

    {
      "type": "range",
      "id": "mobile_width",
      "label": "Mobile video width",
      "min": 70,
      "max": 92,
      "step": 1,
      "unit": "%",
      "default": 78
    },

    {
      "type": "range",
      "id": "gap",
      "label": "Video gap",
      "min": 6,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "range",
      "id": "radius",
      "label": "Video radius",
      "min": 0,
      "max": 32,
