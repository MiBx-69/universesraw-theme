{% liquid
  assign quick_product = closest.product
  assign first_image = quick_product.featured_media

  if first_image == blank
    assign first_image = quick_product.media | first
  endif
%}

<div class="universes-quick-add">

  <div class="universes-quick-add__inner">

    <!-- =========================================
         PRODUCT IMAGE
         ========================================= -->

    <div class="universes-quick-add__image">

      {% if first_image != blank %}

        {{
          first_image
          | image_url: width: 900
          | image_tag:
            loading: 'eager',
            widths: '300,450,600,750,900',
            sizes: '(max-width: 749px) 42vw, 300px',
            class: 'universes-quick-add__image-img'
        }}

      {% else %}

        <div class="universes-quick-add__image-placeholder">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>

      {% endif %}

    </div>


    <!-- =========================================
         OPTIONS
         ========================================= -->

    <div class="universes-quick-add__options">

      <product-form
        class="universes-quick-add__form"
        data-section-id="{{ section.id }}"
      >

        {%- form 'product',
          quick_product,
          id: 'UniversesQuickAddForm-' | append: quick_product.id,
          class: 'universes-quick-add__product-form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        -%}

          <input
            type="hidden"
            name="id"
            value="{{ quick_product.selected_or_first_available_variant.id }}"
            class="universes-quick-add__variant-id"
          >


          <!-- =====================================
               VARIANTS
               ===================================== -->

          {% unless quick_product.has_only_default_variant %}

            <div class="universes-quick-add__variants">

              {% for option in quick_product.options_with_values %}

                <fieldset
                  class="universes-quick-add__option"
                  data-option-position="{{ option.position }}"
                >

                  <legend class="universes-quick-add__label">
                    {{ option.name }}
                  </legend>


                  <div class="universes-quick-add__values">

                    {% for value in option.values %}

                      {% liquid
                        assign option_available = false

                        for variant in quick_product.variants
                          if variant.available
                            case option.position
                              when 1
                                if variant.option1 == value
                                  assign option_available = true
                                endif
                              when 2
                                if variant.option2 == value
                                  assign option_available = true
                                endif
                              when 3
                                if variant.option3 == value
                                  assign option_available = true
                                endif
                            endcase
                          endif
                        endfor
                      %}

                      <input
                        type="radio"
                        id="QuickAdd-{{ quick_product.id }}-{{ option.position }}-{{ forloop.index }}"
                        name="quick-add-option-{{ option.position }}"
                        value="{{ value | escape }}"
                        class="universes-quick-add__radio"
                        data-option-position="{{ option.position }}"
                        {% if option.selected_value == value %}
                          checked
                        {% endif %}
                        {% unless option_available %}
                          disabled
                        {% endunless %}
                      >

                      <label
                        for="QuickAdd-{{ quick_product.id }}-{{ option.position }}-{{ forloop.index }}"
                        class="universes-quick-add__value
                        {% unless option_available %} is-disabled{% endunless %}"
                      >
                        {{ value }}
                      </label>

                    {% endfor %}

                  </div>

                </fieldset>

              {% endfor %}

            </div>

          {% endunless %}


          <!-- =====================================
               ADD TO CART
               ===================================== -->

          <button
            type="submit"
            name="add"
            class="universes-quick-add__submit"
            {% unless quick_product.selected_or_first_available_variant.available %}
              disabled
            {% endunless %}
          >

            <span class="universes-quick-add__submit-text">

              {% if quick_product.selected_or_first_available_variant.available %}
                ADD TO CART
              {% else %}
                SOLD OUT
              {% endif %}

            </span>

            <span
              class="universes-quick-add__spinner"
              aria-hidden="true"
            ></span>

          </button>

        {%- endform -%}

      </product-form>

    </div>

  </div>

</div>


<style>

/* ==========================================================
   UNIVERSes RAW
   MINIMAL QUICK ADD
   ========================================================== */

.universes-quick-add {

  width: 100%;

  margin: 0;

  padding: 0;

  background: #fff;

}


.universes-quick-add__inner {

  display: grid;

  grid-template-columns:
    240px
    minmax(0, 1fr);

  width: 100%;

  min-height: 310px;

  margin: 0;

  padding: 0;

}


/* ==========================================================
   IMAGE
   ========================================================== */

.universes-quick-add__image {

  width: 240px;

  height: 310px;

  overflow: hidden;

  background: #f5f5f5;

}


.universes-quick-add__image-img {

  display: block;

  width: 100%;

  height: 100%;

  object-fit: cover;

  object-position: center;

}


.universes-quick-add__image-placeholder {

  width: 100%;

  height: 100%;

  display: flex;

  align-items: center;

  justify-content: center;

}


/* ==========================================================
   OPTIONS AREA
   ========================================================== */

.universes-quick-add__options {

  min-width: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 30px;

}


.universes-quick-add__form {

  width: 100%;

  max-width: 330px;

}


.universes-quick-add__product-form {

  width: 100%;

  margin: 0;

  padding: 0;

}


/* ==========================================================
   VARIANTS
   ========================================================== */

.universes-quick-add__variants {

  width: 100%;

  margin: 0 0 20px;

}


.universes-quick-add__option {

  margin: 0 0 18px;

  padding: 0;

  border: 0;

}


.universes-quick-add__option:last-child {

  margin-bottom: 0;

}


.universes-quick-add__label {

  margin: 0 0 9px;

  padding: 0;

  font-size: 10px;

  line-height: 1;

  font-weight: 600;

  letter-spacing: .12em;

  text-transform: uppercase;

  color: #111;

}


.universes-quick-add__values {

  display: flex;

  flex-wrap: wrap;

  gap: 7px;

}


.universes-quick-add__radio {

  position: absolute;

  width: 1px;

  height: 1px;

  opacity: 0;

  pointer-events: none;

}


.universes-quick-add__value {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-width: 42px;

  height: 36px;

  padding: 0 11px;

  border: 1px solid #d8d8d8;

  border-radius: 3px;

  background: #fff;

  color: #111;

  font-size: 11px;

  line-height: 1;

  cursor: pointer;

  transition:
    background .15s ease,
    color .15s ease,
    border-color .15s ease;

}


.universes-quick-add__radio:checked
+ .universes-quick-add__value {

  background: #111;

  color: #fff;

  border-color: #111;

}


.universes-quick-add__value:hover {

  border-color: #111;

}


.universes-quick-add__value.is-disabled {

  opacity: .35;

  text-decoration: line-through;

  cursor: not-allowed;

}


/* ==========================================================
   ADD TO CART
   ========================================================== */

.universes-quick-add__submit {

  position: relative;

  display: flex;

  align-items: center;

  justify-content: center;

  width: 100%;

  height: 46px;

  min-height: 46px;

  margin: 20px 0 0;

  padding: 0 20px;

  border: 0;

  border-radius: 4px;

  background: #111;

  color: #fff;

  font-size: 10px;

  line-height: 1;

  font-weight: 600;

  letter-spacing: .14em;

  text-transform: uppercase;

  cursor: pointer;

  transition:
    background .18s ease,
    opacity .18s ease;

}


.universes-quick-add__submit:hover {

  background: #c7192d;

}


.universes-quick-add__submit:disabled {

  opacity: .45;

  cursor: not-allowed;

}


/* ==========================================================
   SPINNER
   ========================================================== */

.universes-quick-add__spinner {

  position: absolute;

  width: 16px;

  height: 16px;

  right: 18px;

  top: 50%;

  margin-top: -8px;

  border: 2px solid rgba(255,255,255,.35);

  border-top-color: #fff;

  border-radius: 50%;

  animation:
    universesQuickAddSpin .7s linear infinite;

  opacity: 0;

}


.universes-quick-add__submit.loading
.universes-quick-add__spinner {

  opacity: 1;

}


.universes-quick-add__submit.loading
.universes-quick-add__submit-text {

  opacity: .55;

}


@keyframes universesQuickAddSpin {

  to {
    transform: rotate(360deg);
  }

}


/* ==========================================================
   MOBILE
   ========================================================== */

@media screen and (max-width: 749px) {

  .universes-quick-add__inner {

    grid-template-columns: 130px minmax(0,1fr);

    min-height: 210px;

  }


  .universes-quick-add__image {

    width: 130px;

    height: 210px;

  }


  .universes-quick-add__options {

    padding: 20px 16px;

  }


  .universes-quick-add__form {

    max-width: none;

  }


  .universes-quick-add__variants {

    margin-bottom: 12px;

  }


  .universes-quick-add__option {

    margin-bottom: 12px;

  }


  .universes-quick-add__label {

    margin-bottom: 7px;

    font-size: 9px;

  }


  .universes-quick-add__value {

    min-width: 36px;

    height: 32px;

    padding: 0 9px;

    font-size: 10px;

  }


  .universes-quick-add__submit {

    height: 42px;

    min-height: 42px;

    margin-top: 12px;

    font-size: 9px;

  }

}


/* ==========================================================
   SMALL MOBILE
   ========================================================== */

@media screen and (max-width: 480px) {

  .universes-quick-add__inner {

    grid-template-columns: 110px minmax(0,1fr);

    min-height: 190px;

  }


  .universes-quick-add__image {

    width: 110px;

    height: 190px;

  }


  .universes-quick-add__options {

    padding: 16px 14px;

  }


  .universes-quick-add__value {

    min-width: 34px;

    height: 30px;

    padding: 0 8px;

  }

}

</style>


<script>
(function () {

  const quickAdd = document.querySelector(
    '#MainProduct-quick-add-{{ section.id }}'
  );

  if (!quickAdd) return;

  const form = quickAdd.querySelector(
    '.universes-quick-add__product-form'
  );

  if (!form) return;

  const variantInput = form.querySelector(
    '.universes-quick-add__variant-id'
  );

  const radios = Array.from(
    form.querySelectorAll(
      '.universes-quick-add__radio'
    )
  );

  const submitButton = form.querySelector(
    '.universes-quick-add__submit'
  );

  const submitText = form.querySelector(
    '.universes-quick-add__submit-text'
  );


  const variants = {{ quick_product.variants | json }};


  function getSelectedOptions() {

    const selected = {};

    radios.forEach(function (radio) {

      if (radio.checked) {

        selected[
          'option' + radio.dataset.optionPosition
        ] = radio.value;

      }

    });

    return selected;

  }


  function findVariant() {

    const selected = getSelectedOptions();

    return variants.find(function (variant) {

      return (
        (!selected.option1 ||
          variant.option1 === selected.option1) &&

        (!selected.option2 ||
          variant.option2 === selected.option2) &&

        (!selected.option3 ||
          variant.option3 === selected.option3)
      );

    });

  }


  function updateVariant() {

    const variant = findVariant();

    if (!variant) {

      if (variantInput) {
        variantInput.value = '';
      }

      if (submitButton) {
        submitButton.disabled = true;
      }

      return;

    }


    if (variantInput) {

      variantInput.value = variant.id;

    }


    if (submitButton) {

      submitButton.disabled = !variant.available;

      if (submitText) {

        submitText.textContent =
          variant.available
            ? 'ADD TO CART'
            : 'SOLD OUT';

      }

    }

  }


  radios.forEach(function (radio) {

    radio.addEventListener(
      'change',
      updateVariant
    );

  });


  /*
   * Let Shopify's existing product-form.js
   * handle the actual AJAX add-to-cart.
   */

  form.addEventListener(
    'submit',
    function () {

      if (
        submitButton &&
        !submitButton.disabled
      ) {

        submitButton.classList.add(
          'loading'
        );

      }

    }
  );


  updateVariant();

})();
</script>


{% schema %}
{
  "name": "Quick add product",
  "blocks": [],
  "settings": [],
  "presets": []
}
{% endschema %}