{% liquid
  assign render_order = 'media,product-details'

  assign product_has_media = true
  if closest.product.media.size == 0
    assign product_has_media = false
  endif

  assign product_grid_class = 'product-quick-add__grid product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media'
  endif

  if section.settings.equal_columns
    assign product_grid_class = product_grid_class | append: ' product-information__grid--half'

    if section.settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' product-information__grid--limit-details'
    endif
  endif

  assign page_width = section.settings.page_width
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div class="section universes-quick-add-section">

  <product-info
    id="MainProduct-quick-add-{{ section.id }}"
    class="product-information universes-quick-add-product section--{{ page_width }} spacing-style color-{{ section.settings.color_scheme }} relative"
    data-section="{{ section.id }}"
    data-product-id="{{ closest.product.id }}"
    data-update-url="false"
    data-url="{{ closest.product.url }}"
    style="{% render 'spacing-style', settings: section.settings %}"
  >

    {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
    {{ 'component-rating.css' | asset_url | stylesheet_tag }}

    {%- if closest.product.quantity_price_breaks_configured? -%}
      {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {% render 'schema',
      product: closest.product
    %}

    <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

    {%- if closest.product.quantity_price_breaks_configured? -%}
      <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if request.design_mode -%}
      <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- assign first_3d_model = closest.product.media
      | where: 'media_type', 'model'
      | first
    -%}

    {%- if first_3d_model -%}

      <link
        id="ModelViewerStyle"
        rel="stylesheet"
        href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
        media="print"
        onload="this.media='all'"
      >

      <link
        id="ModelViewerOverride"
        rel="stylesheet"
        href="{{ 'component-model-viewer-ui.css' | asset_url }}"
        media="print"
        onload="this.media='all'"
      >

    {%- endif -%}


    {% if product_has_media %}

      {% assign product_href = '#ProductInformation-' | append: section.id %}

      {% render 'skip-to-content-link',
        href: product_href,
        text: 'accessibility.skip_to_product_info'
      %}

    {% endif %}


    <div
      class="{{ product_grid_class }} universes-quick-add-grid"
      data-product-grid-content
      style="--gap: {{ section.settings.gap }}px;"
    >

      {% assign render_order_array = render_order | split: ',' %}


      {%- capture media -%}

        <div
          class="product-information__media universes-quick-add-media-column"
          data-testid="product-information-media"
        >

          <div
            class="product-quick-add__media product-information__media--{{ section.settings.desktop_media_position }} universes-quick-add-media"
          >

            {%- content_for 'block',
              type: '_quick-add-product-media-gallery',
              id: 'media-gallery',
              closest.product: closest.product
            -%}

          </div>

        </div>

      {%- endcapture -%}


      {%- capture details -%}

        <div class="universes-quick-add-details-column">

          <div class="universes-quick-add-details-inner">

            {%- content_for 'block',
              type: '_product-details',
              id: 'product-details',
              closest.product: closest.product
            -%}

          </div>

        </div>

      {%- endcapture -%}


      {% for block in render_order_array %}

        {% if block == 'media' and product_has_media %}

          {{ media }}

        {% elsif block == 'product-details' %}

          {{ details }}

        {% endif %}

      {% endfor %}

    </div>


    {%- if closest.product.media.size > 0 -%}

      <script
        src="{{ 'media-gallery.js' | asset_url }}"
        defer="defer"
      ></script>

    {%- endif -%}


    {%- content_for 'blocks' -%}

  </product-info>

</div>


<style>

/* =========================================================
   UNIVERSes RAW
   COMPACT HORIZON-STYLE QUICK ADD
   ========================================================= */


/* =========================================================
   MODAL ROOT
   ========================================================= */

#QuickAddStandard {

  --quick-add-width: 520px;

  --quick-add-max-height: 560px;

  z-index: 10000 !important;

}


/* =========================================================
   COMPACT CENTERED POPUP
   ========================================================= */

#QuickAddStandard
.quick-add-modal__content--standard {

  position: absolute !important;

  top: 50% !important;

  left: 50% !important;

  width: var(--quick-add-width) !important;

  max-width:
    calc(100vw - 32px) !important;

  height: auto !important;

  max-height:
    var(--quick-add-max-height) !important;

  transform:
    translate(-50%, -50%) !important;

  overflow: hidden !important;

  background: #ffffff !important;

  border:
    1px solid
    rgba(17, 17, 17, .06) !important;

  border-radius: 18px !important;

  box-shadow:
    0 20px 70px
    rgba(0, 0, 0, .22) !important;

}


/* =========================================================
   MODAL CONTENT
   ========================================================= */

#QuickStandardModal {

  width: 100% !important;

  height: auto !important;

  max-height:
    var(--quick-add-max-height) !important;

  overflow-x: hidden !important;

  overflow-y: auto !important;

  scrollbar-width: thin;

  -webkit-overflow-scrolling: touch;

}


/* =========================================================
   QUICK ADD GRID
   ========================================================= */

#QuickStandardModal
.universes-quick-add-grid {

  display: grid !important;

  grid-template-columns:
    190px
    minmax(0, 1fr) !important;

  width: 100% !important;

  gap: 0 !important;

  align-items: stretch !important;

}


/* =========================================================
   PRODUCT IMAGE COLUMN
   ========================================================= */

#QuickStandardModal
.universes-quick-add-media-column {

  width: 190px !important;

  min-width: 190px !important;

  min-height: 0 !important;

  overflow: hidden !important;

  background: #f7f7f7 !important;

}


/* =========================================================
   PRODUCT MEDIA
   ========================================================= */

#QuickStandardModal
.universes-quick-add-media {

  width: 100% !important;

  height: 100% !important;

  min-height: 0 !important;

}


/* =========================================================
   PRODUCT IMAGE
   ========================================================= */

#QuickStandardModal
.universes-quick-add-media img {

  display: block !important;

  width: 100% !important;

  height: 100% !important;

  max-height: 470px !important;

  object-fit: cover !important;

}


/* =========================================================
   DETAILS COLUMN
   ========================================================= */

#QuickStandardModal
.universes-quick-add-details-column {

  width: 100% !important;

  min-width: 0 !important;

  background: #ffffff !important;

}


/* =========================================================
   DETAILS INNER
   ========================================================= */

#QuickStandardModal
.universes-quick-add-details-inner {

  width: 100% !important;

  height: 100% !important;

  max-height: 500px !important;

  padding:
    28px
    24px
    24px !important;

  overflow-x: hidden !important;

  overflow-y: auto !important;

  scrollbar-width: thin;

}


/* =========================================================
   PRODUCT TITLE
   ========================================================= */

#QuickStandardModal
.product__title h1,

#QuickStandardModal
.product__title h2,

#QuickStandardModal
.product-information__title {

  margin:
    0 0 8px !important;

  padding: 0 !important;

  font-size: 18px !important;

  line-height: 1.3 !important;

  font-weight: 500 !important;

  letter-spacing: -.01em !important;

}


/* =========================================================
   PRICE
   ========================================================= */

#QuickStandardModal
.price {

  margin:
    0 0 18px !important;

}


#QuickStandardModal
.price-item {

  font-size: 17px !important;

  font-weight: 600 !important;

}


/* =========================================================
   PRODUCT FORM INPUT
   ========================================================= */

#QuickStandardModal
.product-form__input {

  margin-top: 16px !important;

  margin-bottom: 0 !important;

}


/* =========================================================
   VARIANT LABEL
   ========================================================= */

#QuickStandardModal
.product-form__input
.form__label,

#QuickStandardModal
.product-form__input
legend {

  display: flex !important;

  align-items: center !important;

  justify-content: space-between !important;

  width: 100% !important;

  margin:
    0 0 8px !important;

  font-size: 10px !important;

  line-height: 1.4 !important;

  font-weight: 600 !important;

  letter-spacing: .09em !important;

  text-transform: uppercase !important;

}


/* =========================================================
   SIZE / VARIANT BUTTONS
   ========================================================= */

#QuickStandardModal
.product-form__input
input[type="radio"]
+ label {

  display: inline-flex !important;

  align-items: center !important;

  justify-content: center !important;

  min-width: 42px !important;

  min-height: 36px !important;

  margin:
    0 5px 5px 0 !important;

  padding:
    8px 11px !important;

  border:
    1px solid
    rgba(17, 17, 17, .14) !important;

  border-radius: 3px !important;

  background: #ffffff !important;

  color: #111111 !important;

  font-size: 11px !important;

  line-height: 1 !important;

  text-align: center !important;

  cursor: pointer !important;

  transition:
    background-color .18s ease,
    border-color .18s ease,
    color .18s ease !important;

}


/* =========================================================
   SELECTED VARIANT
   ========================================================= */

#QuickStandardModal
.product-form__input
input[type="radio"]:checked
+ label {

  background: #111111 !important;

  border-color: #111111 !important;

  color: #ffffff !important;

}


/* =========================================================
   DISABLED VARIANT
   ========================================================= */

#QuickStandardModal
.product-form__input
input[type="radio"]:disabled
+ label {

  opacity: .35 !important;

  cursor: not-allowed !important;

  text-decoration: line-through !important;

}


/* =========================================================
   HOVER
   ========================================================= */

@media (hover: hover) {

  #QuickStandardModal
  .product-form__input
  input[type="radio"]
  + label:hover {

    border-color: #111111 !important;

  }

}


/* =========================================================
   QUANTITY
   ========================================================= */

#QuickStandardModal
quantity-input {

  width: 110px !important;

  height: 40px !important;

  margin-top: 10px !important;

  border:
    1px solid
    rgba(17, 17, 17, .14) !important;

  border-radius: 3px !important;

}


/* =========================================================
   ADD TO CART
   ========================================================= */

#QuickStandardModal
.product-form__submit,

#QuickStandardModal
.product-form__cart-submit,

#QuickStandardModal
button[name="add"] {

  display: flex !important;

  align-items: center !important;

  justify-content: center !important;

  width: 100% !important;

  min-height: 46px !important;

  margin-top: 18px !important;

  padding:
    0 18px !important;

  border:
    1px solid #111111 !important;

  border-radius: 3px !important;

  background: #111111 !important;

  color: #ffffff !important;

  font-size: 10px !important;

  line-height: 1 !important;

  font-weight: 600 !important;

  letter-spacing: .13em !important;

  text-transform: uppercase !important;

  cursor: pointer !important;

  transition:
    background-color .2s ease,
    color .2s ease !important;

}


@media (hover: hover) {

  #QuickStandardModal
  .product-form__submit:hover,

  #QuickStandardModal
  .product-form__cart-submit:hover,

  #QuickStandardModal
  button[name="add"]:hover {

    background: #ffffff !important;

    color: #111111 !important;

  }

}


/* =========================================================
   HIDE UNNECESSARY PRODUCT INFORMATION
   ========================================================= */

#QuickStandardModal
.product__description,

#QuickStandardModal
.product-information__description,

#QuickStandardModal
pickup-availability,

#QuickStandardModal
share-button,

#QuickStandardModal
.product-popup-modal,

#QuickStandardModal
.product__sku,

#QuickStandardModal
.product__inventory {

  display: none !important;

}


/* =========================================================
   CLOSE BUTTON
   ========================================================= */

#QuickAddStandard
.quick-add-modal__close {

  position: absolute !important;

  top: 10px !important;

  right: 10px !important;

  z-index: 100 !important;

  display: flex !important;

  align-items: center !important;

  justify-content: center !important;

  width: 34px !important;

  height: 34px !important;

  padding: 0 !important;

  margin: 0 !important;

  border:
    1px solid
    rgba(17, 17, 17, .08) !important;

  border-radius: 50% !important;

  background:
    rgba(255, 255, 255, .95) !important;

  color: #111111 !important;

  box-shadow:
    0 3px 12px
    rgba(0, 0, 0, .10) !important;

  cursor: pointer !important;

}


/* =========================================================
   FLOATING SHOPPING BAG
   BOTTOM RIGHT
   ========================================================= */

.product-grid__item {

  position: relative !important;

}


.product-grid__item
.universes-horizon-bag {

  position: absolute !important;

  top: auto !important;

  right: 12px !important;

  bottom: 12px !important;

  left: auto !important;

  z-index: 100 !important;

  display: block !important;

  width: 42px !important;

  height: 42px !important;

  margin: 0 !important;

  padding: 0 !important;

  opacity: 1 !important;

  visibility: visible !important;

  pointer-events: auto !important;

}


.product-grid__item
.universes-horizon-bag__button {

  box-sizing: border-box !important;

  display: flex !important;

  align-items: center !important;

  justify-content: center !important;

  width: 42px !important;

  min-width: 42px !important;

  height: 42px !important;

  min-height: 42px !important;

  padding: 0 !important;

  margin: 0 !important;

  border:
    1px solid
    rgba(17, 17, 17, .08) !important;

  border-radius: 50% !important;

  background:
    rgba(255, 255, 255, .97) !important;

  color: #111111 !important;

  box-shadow:
    0 4px 15px
    rgba(0, 0, 0, .14) !important;

  cursor: pointer !important;

  transition:
    transform .2s ease,
    background-color .2s ease,
    color .2s ease,
    box-shadow .2s ease !important;

}


.product-grid__item
.universes-horizon-bag__button svg {

  display: block !important;

  width: 19px !important;

  height: 19px !important;

  margin: 0 !important;

  color: currentColor !important;

  stroke: currentColor !important;

  fill: none !important;

}


@media (hover: hover) {

  .product-grid__item
  .universes-horizon-bag__button:hover {

    background: #111111 !important;

    color: #ffffff !important;

    transform:
      translateY(-2px) !important;

    box-shadow:
      0 7px 20px
      rgba(0, 0, 0, .20) !important;

  }

}


/* =========================================================
   MOBILE QUICK ADD
   ========================================================= */

@media screen and (max-width: 749px) {

  #QuickAddStandard
  .quick-add-modal__content--standard {

    top: 50% !important;

    left: 50% !important;

    width:
      calc(100vw - 24px) !important;

    max-width:
      calc(100vw - 24px) !important;

    max-height:
      72dvh !important;

    transform:
      translate(-50%, -50%) !important;

    border-radius:
      16px !important;

  }


  #QuickStandardModal {

    max-height:
      72dvh !important;

  }


  #QuickStandardModal
  .universes-quick-add-grid {

    grid-template-columns:
      125px
      minmax(0, 1fr) !important;

  }


  #QuickStandardModal
  .universes-quick-add-media-column {

    width: 125px !important;

    min-width: 125px !important;

  }


  #QuickStandardModal
  .universes-quick-add-media img {

    max-height:
      330px !important;

  }


  #QuickStandardModal
  .universes-quick-add-details-inner {

    max-height:
      400px !important;

    padding:
      24px
      18px
      20px !important;

  }


  #QuickStandardModal
  .product__title h1,

  #QuickStandardModal
  .product__title h2,

  #QuickStandardModal
  .product-information__title {

    font-size: 15px !important;

    line-height: 1.25 !important;

  }


  #QuickStandardModal
  .price-item {

    font-size: 15px !important;

  }


  #QuickStandardModal
  .product-form__input
  input[type="radio"]
  + label {

    min-width: 38px !important;

    min-height: 34px !important;

    padding:
      7px 9px !important;

    font-size: 10px !important;

  }


  #QuickStandardModal
  .product-form__submit,

  #QuickStandardModal
  .product-form__cart-submit,

  #QuickStandardModal
  button[name="add"] {

    min-height: 43px !important;

    margin-top: 14px !important;

    font-size: 9px !important;

  }


  .product-grid__item
  .universes-horizon-bag {

    right: 8px !important;

    bottom: 8px !important;

    width: 38px !important;

    height: 38px !important;

  }


  .product-grid__item
  .universes-horizon-bag__button {

    width: 38px !important;

    min-width: 38px !important;

    height: 38px !important;

    min-height: 38px !important;

  }


  .product-grid__item
  .universes-horizon-bag__button svg {

    width: 17px !important;

    height: 17px !important;

  }

}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  #QuickStandardModal *,
  #QuickStandardModal *::before,
  #QuickStandardModal *::after {

    transition-duration:
      .01ms !important;

  }

}

</style>


{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "page_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}