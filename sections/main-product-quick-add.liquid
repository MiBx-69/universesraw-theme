{% liquid
  assign quick_product = closest.product

  assign first_image = quick_product.featured_media

  if first_image == blank
    assign first_image = quick_product.media | first
  endif

  assign quick_form_id = 'UniversesQuickAddForm-' | append: quick_product.id
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div class="section universes-quick-add-section">

  <product-info
    id="MainProduct-quick-add-{{ section.id }}"
    class="product-information universes-quick-add-product"
    data-section="{{ section.id }}"
    data-product-id="{{ quick_product.id }}"
    data-update-url="false"
    data-url="{{ quick_product.url }}"
  >

    {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
    {{ 'component-rating.css' | asset_url | stylesheet_tag }}

    <script
      src="{{ 'product-info.js' | asset_url }}"
      defer
    ></script>

    <script
      src="{{ 'product-form.js' | asset_url }}"
      defer
    ></script>


    <div class="universes-quick-add">

      <div class="universes-quick-add__inner">


        <!-- PRODUCT IMAGE -->

        <div class="universes-quick-add__image">

          {% if first_image != blank %}

            {{
              first_image
              | image_url: width: 900
              | image_tag:
                loading: 'eager',
                widths: '300,450,600,750,900',
                sizes: '(max-width: 749px) 40vw, 300px',
                class: 'universes-quick-add__image-img'
            }}

          {% else %}

            <div class="universes-quick-add__placeholder">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>

          {% endif %}

        </div>


        <!-- OPTIONS -->

        <div class="universes-quick-add__options">

          <product-form-component class="universes-quick-add__product-form-wrapper">

            {% form 'product',
              quick_product,
              id: quick_form_id,
              class: 'universes-quick-add__form',
              novalidate: 'novalidate',
              data-type: 'add-to-cart-form'
            %}

              <input
                type="hidden"
                name="id"
                value="{{ quick_product.selected_or_first_available_variant.id }}"
                class="universes-quick-add__variant-id"
              >


              <!-- VARIANTS -->

              {% unless quick_product.has_only_default_variant %}

                <div class="universes-quick-add__variants">

                  {% for option in quick_product.options_with_values %}

                    <fieldset
                      class="universes-quick-add__option"
                      data-option-position="{{ option.position }}"
                    >

                      <legend class="universes-quick-add__label">
                        {{ option.name }}
                      </legend>

                      <div class="universes-quick-add__values">

                        {% for value in option.values %}

                          {% liquid
                            assign value_available = false

                            for variant in quick_product.variants

                              if variant.available

                                case option.position

                                  when 1
                                    if variant.option1 == value
                                      assign value_available = true
                                    endif

                                  when 2
                                    if variant.option2 == value
                                      assign value_available = true
                                    endif

                                  when 3
                                    if variant.option3 == value
                                      assign value_available = true
                                    endif

                                endcase

                              endif

                            endfor
                          %}

                          <input
                            type="radio"
                            id="UniversesQuickAdd-{{ quick_product.id }}-{{ option.position }}-{{ forloop.index }}"
                            name="UniversesQuickAddOption{{ option.position }}"
                            value="{{ value | escape }}"
                            class="universes-quick-add__radio"
                            data-option-position="{{ option.position }}"
                            {% if option.selected_value == value %}
                              checked
                            {% endif %}
                            {% unless value_available %}
                              disabled
                            {% endunless %}
                          >

                          <label
                            for="UniversesQuickAdd-{{ quick_product.id }}-{{ option.position }}-{{ forloop.index }}"
                            class="universes-quick-add__value{% unless value_available %} is-disabled{% endunless %}"
                          >
                            {{ value }}
                          </label>

                        {% endfor %}

                      </div>

                    </fieldset>

                  {% endfor %}

                </div>

              {% endunless %}


              <!-- ADD TO CART -->

              <button
                type="submit"
                name="add"
                class="universes-quick-add__submit"
                {% unless quick_product.selected_or_first_available_variant.available %}
                  disabled
                {% endunless %}
              >

                <span class="universes-quick-add__submit-text">

                  {% if quick_product.selected_or_first_available_variant.available %}
                    ADD TO CART
                  {% else %}
                    SOLD OUT
                  {% endif %}

                </span>

                <span class="universes-quick-add__spinner"></span>

              </button>

            {% endform %}

          </product-form-component>

        </div>

      </div>

    </div>

  </product-info>

</div>


<style>

/* ==========================================================
   UNIVERSes RAW QUICK ADD
   ========================================================== */

.universes-quick-add {
  width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  background: #fff !important;
}

.universes-quick-add__inner {
  display: grid !important;
  grid-template-columns: 230px minmax(0, 1fr) !important;

  width: 100% !important;

  height: 300px !important;
  min-height: 300px !important;
  max-height: 300px !important;

  margin: 0 !important;
  padding: 0 !important;
}


/* IMAGE */

.universes-quick-add__image {
  width: 230px !important;
  height: 300px !important;

  min-height: 300px !important;
  max-height: 300px !important;

  overflow: hidden !important;

  background: #f5f5f5 !important;
}

.universes-quick-add__image-img {
  display: block !important;

  width: 100% !important;
  height: 100% !important;

  min-height: 300px !important;
  max-height: 300px !important;

  object-fit: cover !important;
  object-position: center !important;
}

.universes-quick-add__placeholder {
  width: 100% !important;
  height: 100% !important;
}


/* OPTIONS */

.universes-quick-add__options {
  display: flex !important;

  align-items: center !important;
  justify-content: center !important;

  width: 100% !important;
  min-width: 0 !important;

  height: 300px !important;

  padding: 28px !important;

  box-sizing: border-box !important;
}

.universes-quick-add__product-form-wrapper {
  display: block !important;

  width: 100% !important;

  max-width: 300px !important;
}

.universes-quick-add__form {
  width: 100% !important;

  margin: 0 !important;
  padding: 0 !important;
}


/* VARIANTS */

.universes-quick-add__variants {
  width: 100% !important;

  margin: 0 !important;
  padding: 0 !important;
}

.universes-quick-add__option {
  margin: 0 0 16px !important;

  padding: 0 !important;

  border: 0 !important;
}

.universes-quick-add__option:last-child {
  margin-bottom: 0 !important;
}

.universes-quick-add__label {
  display: block !important;

  margin: 0 0 8px !important;
  padding: 0 !important;

  font-size: 10px !important;

  line-height: 1 !important;

  font-weight: 600 !important;

  letter-spacing: .12em !important;

  text-transform: uppercase !important;

  color: #111 !important;
}

.universes-quick-add__values {
  display: flex !important;

  flex-wrap: wrap !important;

  gap: 6px !important;
}

.universes-quick-add__radio {
  position: absolute !important;

  width: 1px !important;
  height: 1px !important;

  opacity: 0 !important;

  pointer-events: none !important;
}

.universes-quick-add__value {
  display: inline-flex !important;

  align-items: center !important;
  justify-content: center !important;

  min-width: 40px !important;
  height: 34px !important;

  padding: 0 10px !important;

  border: 1px solid #d5d5d5 !important;

  border-radius: 3px !important;

  background: #fff !important;

  color: #111 !important;

  font-size: 10px !important;

  line-height: 1 !important;

  cursor: pointer !important;

  box-sizing: border-box !important;
}

.universes-quick-add__radio:checked
+ .universes-quick-add__value {
  background: #111 !important;

  border-color: #111 !important;

  color: #fff !important;
}

.universes-quick-add__value.is-disabled {
  opacity: .35 !important;

  text-decoration: line-through !important;

  cursor: not-allowed !important;
}


/* ADD TO CART */

.universes-quick-add__submit {
  position: relative !important;

  display: flex !important;

  align-items: center !important;
  justify-content: center !important;

  width: 100% !important;

  height: 46px !important;
  min-height: 46px !important;

  margin: 20px 0 0 !important;

  padding: 0 18px !important;

  border: 0 !important;

  border-radius: 4px !important;

  background: #111 !important;

  color: #fff !important;

  font-size: 10px !important;

  font-weight: 600 !important;

  letter-spacing: .14em !important;

  text-transform: uppercase !important;

  cursor: pointer !important;
}

.universes-quick-add__submit:hover {
  background: #c7192d !important;
}

.universes-quick-add__submit:disabled {
  opacity: .45 !important;

  cursor: not-allowed !important;
}


/* MOBILE */

@media screen and (max-width: 749px) {

  .universes-quick-add__inner {
    grid-template-columns: 125px minmax(0, 1fr) !important;

    height: 220px !important;
    min-height: 220px !important;
    max-height: 220px !important;
  }

  .universes-quick-add__image {
    width: 125px !important;

    height: 220px !important;
    min-height: 220px !important;
    max-height: 220px !important;
  }

  .universes-quick-add__image-img {
    height: 220px !important;

    min-height: 220px !important;
    max-height: 220px !important;
  }

  .universes-quick-add__options {
    height: 220px !important;

    padding: 18px 14px !important;
  }

  .universes-quick-add__product-form-wrapper {
    max-width: none !important;
  }

  .universes-quick-add__option {
    margin-bottom: 12px !important;
  }

  .universes-quick-add__label {
    font-size: 9px !important;

    margin-bottom: 6px !important;
  }

  .universes-quick-add__value {
    min-width: 36px !important;

    height: 31px !important;

    padding: 0 8px !important;

    font-size: 9px !important;
  }

  .universes-quick-add__submit {
    height: 40px !important;

    min-height: 40px !important;

    margin-top: 14px !important;

    font-size: 9px !important;
  }
}


/* SMALL PHONE */

@media screen and (max-width: 380px) {

  .universes-quick-add__inner {
    grid-template-columns: 105px minmax(0, 1fr) !important;

    height: 190px !important;
    min-height: 190px !important;
    max-height: 190px !important;
  }

  .universes-quick-add__image {
    width: 105px !important;

    height: 190px !important;

    min-height: 190px !important;
    max-height: 190px !important;
  }

  .universes-quick-add__image-img {
    height: 190px !important;

    min-height: 190px !important;
    max-height: 190px !important;
  }

  .universes-quick-add__options {
    height: 190px !important;

    padding: 14px 11px !important;
  }

}

</style>


<script>
(function () {

  const productInfo = document.querySelector(
    '#MainProduct-quick-add-{{ section.id }}'
  );

  if (!productInfo) return;


  const form = productInfo.querySelector(
    '.universes-quick-add__form'
  );

  if (!form) return;


  const variantInput = form.querySelector(
    '.universes-quick-add__variant-id'
  );


  const radios = Array.from(
    form.querySelectorAll(
      '.universes-quick-add__radio'
    )
  );


  const submitButton = form.querySelector(
    '.universes-quick-add__submit'
  );


  const submitText = form.querySelector(
    '.universes-quick-add__submit-text'
  );


  const variants =
    {{ quick_product.variants | json }};


  function getSelectedOptions() {

    const options = {};

    radios.forEach(function (radio) {

      if (radio.checked) {

        options[
          'option' +
          radio.dataset.optionPosition
        ] = radio.value;

      }

    });

    return options;

  }


  function findVariant() {

    const selected =
      getSelectedOptions();


    return variants.find(
      function (variant) {

        return (

          (!selected.option1 ||
            variant.option1 === selected.option1)

          &&

          (!selected.option2 ||
            variant.option2 === selected.option2)

          &&

          (!selected.option3 ||
            variant.option3 === selected.option3)

        );

      }
    );

  }


  function updateVariant() {

    const variant =
      findVariant();


    if (!variant) {

      if (variantInput) {
        variantInput.value = '';
      }

      if (submitButton) {
        submitButton.disabled = true;
      }

      return;

    }


    if (variantInput) {

      variantInput.value =
        variant.id;

    }


    if (submitButton) {

      submitButton.disabled =
        !variant.available;

      if (submitText) {

        submitText.textContent =
          variant.available
            ? 'ADD TO CART'
            : 'SOLD OUT';

      }

    }

  }


  radios.forEach(function (radio) {

    radio.addEventListener(
      'change',
      updateVariant
    );

  });


  updateVariant();

})();
</script>


{% schema %}
{
  "name": "Quick add product",
  "blocks": [],
  "settings": [],
  "presets": []
}
{% endschema %}