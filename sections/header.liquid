<script>
  (() => {
    'use strict';

    const MOBILE_MAX = 989;

    const lockPage = (locked) => {
      document.documentElement.classList.toggle('ur-mobile-open', locked);
      document.body.classList.toggle('ur-mobile-open', locked);
    };

    const initMobileHeader = (root) => {
      if (!root || root.dataset.urMobileReady === 'true') return;

      const drawer = root.querySelector('[data-ur-mobile-drawer]');
      const openButton = root.querySelector('[data-ur-mobile-open]');
      const closeButtons = root.querySelectorAll('[data-ur-mobile-close]');

      if (!drawer || !openButton) return;
      root.dataset.urMobileReady = 'true';

      let lastFocused = null;

      const openMenu = () => {
        if (window.innerWidth > MOBILE_MAX) return;

        lastFocused = document.activeElement;
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        openButton.setAttribute('aria-expanded', 'true');
        lockPage(true);
      };

      const closeMenu = () => {
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        openButton.setAttribute('aria-expanded', 'false');
        lockPage(false);

        if (lastFocused && typeof lastFocused.focus === 'function') {
          requestAnimationFrame(() => lastFocused.focus({ preventScroll: true }));
        }
      };

      openButton.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        openMenu();
      }, { passive: false });

      closeButtons.forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          closeMenu();
        }, { passive: false });
      });

      drawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMenu, { passive: true });
      });

      drawer.querySelectorAll('details').forEach((details) => {
        details.addEventListener('toggle', () => {
          const icon = details.querySelector(':scope > summary .ur-mobile-shell__chevron');
          if (icon) icon.textContent = details.open ? '−' : '+';
        });
      });

      root.__urCloseMenu = closeMenu;
    };

    const keepMobileHeaderVisible = () => {
      const header = document.getElementById('header-component');
      if (!header || window.innerWidth > MOBILE_MAX) return;

      /*
       * The theme setting may be "scroll-up". On mobile that behaviour is
       * intentionally disabled: the compact header must stay available while
       * the customer scrolls, so the menu is always reachable.
       */
      if (header.dataset.stickyType === 'scroll-up') {
        header.dataset.stickyType = 'always';
      }
    };

    const boot = () => {
      document.querySelectorAll('[data-ur-mobile-shell]').forEach(initMobileHeader);
      keepMobileHeaderVisible();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }

    document.addEventListener('shopify:section:load', boot);

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;

      const drawer = document.querySelector('[data-ur-mobile-drawer].is-open');
      if (!drawer) return;

      event.preventDefault();
      drawer.closest('[data-ur-mobile-shell]')?.__urCloseMenu?.();
    }, { passive: false });

    window.addEventListener('resize', boot, { passive: true });
  })();
</script>

