    justify-content: flex-start !important;
  }

  html body .ur-mobile-shell[style*="--ur-mobile-logo-position: right"] .ur-mobile-shell__brand {
    justify-content: flex-end !important;
  }

  html body .ur-mobile-shell[style*="--ur-mobile-logo-position: center"] .ur-mobile-shell__brand {
    justify-content: center !important;
  }

  html body .ur-mobile-shell__actions {
    min-width: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 0 !important;
  }

  html body .ur-mobile-shell__icon {
    width: 38px !important;
    height: 42px !important;
    min-width: 38px !important;
    min-height: 42px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: var(--ur-mobile-fg, #211e1a) !important;
    text-decoration: none !important;
    position: relative !important;
    touch-action: manipulation !important;
  }

  html body .ur-mobile-shell__icon svg {
    width: 18px !important;
    height: 18px !important;
  }

  html body .ur-mobile-shell__cart-count {
    top: 3px !important;
    right: 1px !important;
    min-width: 14px !important;
    height: 14px !important;
    font-size: 7px !important;
    border: 2px solid var(--ur-mobile-bg, #faf8f4) !important;
  }

  /* Full-screen menu stays above everything, including product cards. */
  html body .ur-mobile-shell__drawer {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100dvh !important;
    z-index: 2147483647 !important;
  }

  html body .ur-mobile-shell__panel {
    height: 100dvh !important;
    width: min(90vw, 410px) !important;
    max-width: 410px !important;
    transform: translate3d(-102%,0,0) !important;
    transition: transform .20s cubic-bezier(.22,.61,.36,1) !important;
    will-change: transform !important;
    backface-visibility: hidden !important;
  }

  html body .ur-mobile-shell__drawer.is-open .ur-mobile-shell__panel {
    transform: translate3d(0,0,0) !important;
  }

  /* Remove the old forced sticky-height rules that made the header
     visually large after Shopify changed state. */
  .header-wrapper[data-sticky-type],
  .header-wrapper.is-sticky,
  .header-wrapper.sticky,
  .header-wrapper.header--sticky {
    min-height: var(--ur-mobile-header-height) !important;
    height: var(--ur-mobile-header-height) !important;
    max-height: var(--ur-mobile-header-height) !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  html body .ur-mobile-shell__panel,
  html body .ur-mobile-shell__drawer {
    transition: none !important;
  }
}
</style>

