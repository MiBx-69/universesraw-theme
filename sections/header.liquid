{%- liquid
  assign sec_stts = section.settings

  assign has_menu_tab = false
  assign check_menu_tab = section.blocks | where: 'type', 'menu_tab'
  if check_menu_tab.size > 0
    assign has_menu_tab = true
    assign mobile_menu_block = check_menu_tab | first
    assign mobile_menu_icon_style = mobile_menu_block.settings.menu_icon | default: 'style_1'
    assign mobile_menu_icon_custom = mobile_menu_block.settings.custom_menu_icon_size
    assign mobile_menu_icon_size = mobile_menu_block.settings.menu_icon_size | default: 22
  else
    assign mobile_menu_icon_style = 'style_1'
    assign mobile_menu_icon_icon_custom = false
    assign mobile_menu_icon_size = 22
  endif

  assign mobile_logo_width = sec_stts.logo_width_mobile | default: 100
  assign mobile_logo_position = sec_stts.logo_position | default: 'center'
  assign mobile_logo_spacing_left = sec_stts.logo_spacing_left | default: 0
  assign mobile_logo_spacing_right = sec_stts.logo_spacing_right | default: 0

  assign mobile_bg = sec_stts.color_scheme_top_mb.settings.background
  assign mobile_fg = sec_stts.color_scheme_top_mb.settings.foreground

  if mobile_bg == blank
    assign mobile_bg = '#faf8f4'
  endif
  if mobile_fg == blank
    assign mobile_fg = '#211e1a'
  endif

  assign order = 'multi_tab_menu,logo,mobile_logo,menu,message,account,search,localization,mobile_search,actions'

  if shop.customer_accounts_enabled
    assign order = 'multi_tab_menu,mobile_search,logo,mobile_logo,menu,message,account,search,localization,actions'
  endif

  assign rows = 'top,bottom' | split: ','
  assign search_style = 'none'

  if section.settings.show_search
    assign search_style = 'modal'
  endif

  if sec_stts.enable_transparent_header_home and template.name == 'index'
    assign transparent = 'always'
    assign transparent_color_scheme = sec_stts.home_color_scheme
  elsif sec_stts.enable_transparent_header_product and template.name == 'product'
    assign transparent = 'always'
    assign transparent_color_scheme = sec_stts.product_color_scheme
  elsif sec_stts.enable_transparent_header_collection and template.name == 'collection'
    assign transparent = 'always'
    assign transparent_color_scheme = sec_stts.collection_color_scheme
  endif

  if sec_stts.enable_sticky_header == 'always'
    assign sticky = 'always'
  elsif sec_stts.enable_sticky_header == 'scroll-up'
    assign sticky = 'scroll-up'
  endif

  if transparent and sticky
    assign transparent = 'not-sticky'
  endif

  assign header_wrapper = 'header-component'

  if transparent
    if transparent_color_scheme == 'inverse'
      assign transparent_color_scheme = 'color-' | append: section.settings.color_scheme_transparent
    else
      assign transparent_color_scheme = 'color-' | append: section.settings.color_scheme_top
    endif
  endif

  capture logo
    render 'header-logo', header_settings: sec_stts, blocks: section.blocks, has_menu_tab: has_menu_tab
  endcapture

  capture menu
    render 'header-menu-snippet', header_settings: sec_stts, blocks: section.blocks, menu_gap: sec_stts.menu_gap
  endcapture

  assign mobile_menu = blank
  -%}

{% assign mobile_menu = blank %}

{%- liquid
  capture account
    render 'header-account', sec_stts: sec_stts, custom_header_utility: sec_stts.custom_header_utility, header_utility_size: sec_stts.header_utility_size, header_utility_font: sec_stts.header_utility_font, header_utility_weight: sec_stts.header_utility_weight, header_utility_line_height: sec_stts.header_utility_line_height, header_utility_letter_spacing: sec_stts.header_utility_letter_spacing, header_utility_case: sec_stts.header_utility_case, header_utility_wrap: sec_stts.header_utility_wrap
  endcapture

  capture account_mobile
    render 'header-account', sec_stts: sec_stts, custom_header_utility: sec_stts.custom_header_utility, header_utility_size: sec_stts.header_utility_size, header_utility_font: sec_stts.header_utility_font, header_utility_weight: sec_stts.header_utility_weight, header_utility_line_height: sec_stts.header_utility_line_height, header_utility_letter_spacing: sec_stts.header_utility_letter_spacing, header_utility_case: sec_stts.header_utility_case, header_utility_wrap: sec_stts.header_utility_wrap, extra_class: 'lg:none'
  endcapture

  capture actions
    render 'header-functions', sec_stts: sec_stts, blocks: section.blocks, enable_cart: true, enable_wishlist: false, custom_header_utility: sec_stts.custom_header_utility, header_utility_size: sec_stts.header_utility_size, header_utility_font: sec_stts.header_utility_font, header_utility_weight: sec_stts.header_utility_weight, header_utility_line_height: sec_stts.header_utility_line_height, header_utility_letter_spacing: sec_stts.header_utility_letter_spacing, header_utility_case: sec_stts.header_utility_case, header_utility_wrap: sec_stts.header_utility_wrap
  endcapture

  capture actions_mobile
    render 'header-functions', sec_stts: sec_stts, blocks: section.blocks, enable_cart: true, enable_wishlist: false, custom_header_utility: sec_stts.custom_header_utility, header_utility_size: sec_stts.header_utility_size, header_utility_font: sec_stts.header_utility_font, header_utility_weight: sec_stts.header_utility_weight, header_utility_line_height: sec_stts.header_utility_line_height, header_utility_letter_spacing: sec_stts.header_utility_letter_spacing, header_utility_case: sec_stts.header_utility_case, header_utility_wrap: sec_stts.header_utility_wrap, extra_class: 'lg:none'
  endcapture

  if shop.customer_accounts_enabled
    assign search_class = 'max-md:hidden'
  endif

  capture search
    render 'header-search', style: search_style, input_id: 'Search-In-Modal', class: search_class, display_type: sec_stts.search_display_type, sec_stts: sec_stts, custom_header_utility: sec_stts.custom_header_utility, header_utility_size: sec_stts.header_utility_size, header_utility_font: sec_stts.header_utility_font, header_utility_weight: sec_stts.header_utility_weight, header_utility_line_height: sec_stts.header_utility_line_height, header_utility_letter_spacing: sec_stts.header_utility_letter_spacing, header_utility_case: sec_stts.header_utility_case, header_utility_wrap: sec_stts.header_utility_wrap
  endcapture

  capture multi_tab_menu
    render 'header-multi-site', settings: sec_stts, blocks: section.blocks, menu_gap: sec_stts.menu_gap
  endcapture

  capture message
    render 'header-message', settings: sec_stts, blocks: section.blocks
  endcapture

  if shop.customer_accounts_enabled
    render 'account-drawer'
  endif

  # Handle localization positioning
  if sec_stts.localization_position == 'left'
    if sec_stts.search_position == 'left'
      if shop.customer_accounts_enabled
        assign order = 'multi_tab_menu,mobile_search,logo,mobile_logo,menu,message,account,search,localization,actions'
      else
        assign order = 'multi_tab_menu,logo,mobile_logo,menu,message,account,search,localization,mobile_search,actions'
      endif
    else
      if shop.customer_accounts_enabled
        assign order = 'multi_tab_menu,mobile_search,logo,mobile_logo,menu,message,account,search,localization,actions'
      else
        assign order = 'multi_tab_menu,logo,mobile_logo,menu,message,account,search,localization,mobile_search,actions'
      endif
    endif
  else
    if sec_stts.search_position == 'left'
      if shop.customer_accounts_enabled
        assign order = 'multi_tab_menu,mobile_search,logo,mobile_logo,menu,message,account,search,localization,actions'
      else
        assign order = 'multi_tab_menu,logo,mobile_logo,menu,message,account,search,localization,mobile_search,actions'
      endif
    endif
  endif

  assign header_actions_order = sec_stts.header_actions_order | default: 'account,search,localization,actions'
  assign order = order | replace: 'account,search,localization,actions', header_actions_order

  # Handle logo row
  if sec_stts.logo_row == 'bottom'
    capture mobile_logo
      render 'header-logo', header_settings: sec_stts, blocks: section.blocks, class: 'lg:none'
    endcapture
  endif

  # Skip mobile search under specific conditions:
  # Always render if search_row is bottom
  # Don't render when shop.customer_accounts_enabled is false and search_position is left
  assign skip_mobile_search = false
  if shop.customer_accounts_enabled == false and sec_stts.search_position == 'left' and search_style != 'none'
    assign skip_mobile_search = true
  endif

  if sec_stts.search_row == 'bottom' or search_style != 'none' and skip_mobile_search == false
    # Mobile search duplicate for when search is not in the right order for mobile layout
    capture mobile_search
      render 'header-search', class: 'lg:none', input_id: 'Search-In-Modal-Mobile', style: search_style, variant: 'mobile'
    endcapture
  endif

  
  assign show_language = sec_stts.show_language
  if localization.available_languages.size <= 1
    assign show_language = false
  endif

  assign show_country = sec_stts.show_country
  if localization.available_countries.size <= 1
    assign show_country = false
  endif
  
  if show_country or show_language
    assign show_flag = false
    if sec_stts.country_selector_style == true
      assign show_flag = true
    endif
    capture localization_markup
      render 'dropdown-localization', show_country: show_country, show_language: show_language, country_style: show_flag, localization_position: sec_stts.localization_position, localization_type: sec_stts.localization_type, hide_mobile: true, section_id: section.id, show_localization_shortcode: sec_stts.show_localization_shortcode
    endcapture
  endif

  assign bottom_row_blocks = ''

  if section.settings.menu_row == 'bottom'
    assign bottom_row_blocks = bottom_row_blocks | append: 'menu,'
  endif

  if search_style != 'none'
    if section.settings.search_row == 'bottom'
      assign bottom_row_blocks = bottom_row_blocks | append: 'search,'
    endif
  endif

  if section.settings.show_country or section.settings.show_language
    if section.settings.localization_row == 'bottom'
      assign bottom_row_blocks = bottom_row_blocks | append: 'localization,'
    endif
  endif

  assign bottom_row_blocks = bottom_row_blocks | split: ',' | compact

  if section.settings.section_height == 'compact'
    assign header_height_class = ' header--compact'
  endif

  if bottom_row_blocks.size > 0 and section.settings.color_scheme_top.settings.background.rgb == section.settings.color_scheme_bottom.settings.background.rgb and section.settings.divider_width == 0
    assign collapse_header_paddings_class = 'header--collapse-row-paddings'
  endif

  assign class = 'header'

  if transparent_color_scheme
    assign class = class | append: ' ' | append: transparent_color_scheme
  endif

  if sec_stts.color_scheme_top.settings.background.alpha != 1
    assign class = class | append: ' ' | append: 'header--inherit-color-scheme-on-menu-open'
  endif

  if header_height_class
    assign class = class | append: ' ' | append: header_height_class
  endif

  if collapse_header_paddings_class
    assign class = class | append: ' ' | append: collapse_header_paddings_class
  endif

  if sec_stts.reveal_logo_on_sticky
    assign class = class | append: ' ' | append: 'header--reveal-logo-on-sticky'
  endif
-%}


<{{ header_wrapper }}
  class="
    header-wrapper
    {{ class }}
    {% if sec_stts.show_line_separator %} header-wrapper--border-bottom{% endif %}
    {% if has_menu_tab %} has-menu-tab{% endif %}
    {% if sec_stts.custom_bubble_transparent_header %} custom-bubble-transparent-header{% endif %}
  "
  {% if sticky %}
    data-sticky-type="{{ sticky }}"
  {% endif %}
  {% if transparent %}
    transparent="{{ transparent }}"
  {% endif %}
  id="header-component"
>
  <div
    class="ur-mobile-shell"
    data-ur-mobile-shell
    style="
      --ur-mobile-bg: {{ mobile_bg }};
      --ur-mobile-fg: {{ mobile_fg }};
      --ur-mobile-logo-width: {{ mobile_logo_width }}px;
      --ur-mobile-logo-position: {{ mobile_logo_position }};
      --ur-mobile-logo-spacing-left: {{ mobile_logo_spacing_left }}px;
      --ur-mobile-logo-spacing-right: {{ mobile_logo_spacing_right }}px;
      --ur-mobile-menu-icon-size: {% if mobile_menu_icon_custom %}{{ mobile_menu_icon_size }}px{% else %}20px{% endif %};
    "
  >
    <div class="ur-mobile-shell__bar">
      {% if has_menu_tab or sec_stts.menu != blank %}
        <button
          class="ur-mobile-shell__menu ur-mobile-shell__menu--{{ mobile_menu_icon_style }}"
          type="button"
          data-ur-mobile-open
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="UR-Mobile-Luxury-Drawer"
        >
          <span class="ur-mobile-shell__menu-lines" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
        </button>
      {% else %}
        <span class="ur-mobile-shell__menu-spacer" aria-hidden="true"></span>
      {% endif %}
      <a
        class="ur-mobile-shell__brand"
        href="{{ routes.root_url }}"
        aria-label="{{ shop.name | escape }}"
      >
        {%- comment -%}
          Use the actual Shopify Theme Settings logo.
          IMPORTANT: this is `settings.logo`, not `section.settings.logo`.
          The uploaded Default Logo lives in Theme Settings.
        {%- endcomment -%}
        {% if settings.logo != blank %}
          {{
            settings.logo
            | image_url: width: 900
            | image_tag:
              class: 'ur-mobile-shell__logo-image',
              widths: '180,240,320,420,600,750,900',
              sizes: '(max-width: 989px) var(--ur-mobile-logo-width)',
              loading: 'eager',
              fetchpriority: 'high',
              alt: shop.name
          }}
        {% elsif settings.logo_svg != blank %}
          <span class="ur-mobile-shell__logo-svg" aria-hidden="true">
            {{ settings.logo_svg }}
          </span>
        {% endif %}
      </a>
      <div class="ur-mobile-shell__actions">
        {% if sec_stts.show_search %}
          <a class="ur-mobile-shell__icon" href="{{ routes.search_url }}" aria-label="Search">
            {{- 'icon-search.svg' | inline_asset_content -}}
          </a>
        {% endif %}
        {% if shop.customer_accounts_enabled and sec_stts.show_account %}
          <a class="ur-mobile-shell__icon" href="{{ routes.account_url }}" aria-label="Account">
            {{- 'icon-account.svg' | inline_asset_content -}}
          </a>
        {% endif %}
        <a class="ur-mobile-shell__icon ur-mobile-shell__icon--cart" href="{{ routes.cart_url }}" aria-label="Cart">
          {{- 'icon-cart.svg' | inline_asset_content -}}
          {% if cart.item_count > 0 %}<span class="ur-mobile-shell__cart-count">{{ cart.item_count }}</span>{% endif %}
        </a>
      </div>
    </div>

    <div id="UR-Mobile-Luxury-Drawer" class="ur-mobile-shell__drawer" data-ur-mobile-drawer aria-hidden="true">
      <div class="ur-mobile-shell__backdrop" data-ur-mobile-close></div>
      <aside class="ur-mobile-shell__panel" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.menu' | t }}">
        <div class="ur-mobile-shell__drawer-head">
          <div>
            <span class="ur-mobile-shell__drawer-kicker">{{ shop.name | escape }}</span>
            <div class="ur-mobile-shell__drawer-title">Explore</div>
          </div>
          <button class="ur-mobile-shell__close" type="button" data-ur-mobile-close aria-label="Close menu"><span></span><span></span></button>
        </div>
        <nav class="ur-mobile-shell__nav" aria-label="Mobile navigation">
          <ul class="ur-mobile-shell__list">
            {% for link in section.settings.menu.links %}
              <li class="ur-mobile-shell__item">
                {% if link.links != blank %}
                  <details>
                    <summary>
                      <span class="ur-mobile-shell__item-title">
                        <span class="ur-mobile-shell__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                        <span>{{ link.title | escape }}</span>
                      </span>
                      <span class="ur-mobile-shell__chevron">+</span>
                    </summary>
                    <div class="ur-mobile-shell__submenu">
                      <a class="ur-mobile-shell__all" href="{{ link.url }}">VIEW ALL {{ link.title | upcase | escape }}</a>
                      {% for childlink in link.links %}
                        <a class="ur-mobile-shell__subitem" href="{{ childlink.url }}">{{ childlink.title | escape }}</a>
                        {% if childlink.links != blank %}
                          {% for grandchildlink in childlink.links %}
                            <a class="ur-mobile-shell__subitem" style="padding-left:14px;color:#81766a;" href="{{ grandchildlink.url }}">{{ grandchildlink.title | escape }}</a>
                          {% endfor %}
                        {% endif %}
                      {% endfor %}
                    </div>
                  </details>
                {% else %}
                  <a href="{{ link.url }}">
                    <span class="ur-mobile-shell__item-title">
                      <span class="ur-mobile-shell__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                      <span>{{ link.title | escape }}</span>
                    </span>
                    <span class="ur-mobile-shell__chevron">→</span>
                  </a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </nav>
        <div class="ur-mobile-shell__footer"><span>{{ shop.name | escape }}</span><span>Premium Menswear</span></div>
      </aside>
    </div>
  </div>

  <div class="row-group{% if sec_stts.enable_shadow %} row-group--shadow{% endif %}"
  style="
  --padding-block-start-top: {{ sec_stts.padding-block-start-top }}px;
  --padding-block-end-top: {{ sec_stts.padding-block-end-top }}px;
