{% comment %}
  UNIVERSes RAW
  Premium Header Menu Router
{% endcomment %}

{%- case variant -%}

  {%- when 'mobile' -%}

    {% render 'mobile-menu-premium',
      header_settings: header_settings,
      blocks: blocks,
      section_id: section_id
    %}

  {%- else -%}

    {% render 'header-menu',
      header_settings: header_settings,
      blocks: blocks,
      menu_gap: menu_gap
    %}

{%- endcase -%}