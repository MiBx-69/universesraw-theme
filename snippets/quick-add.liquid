<style>

/* ==========================================================
   UNIVERSes RAW — PREMIUM QUICK ADD
   ========================================================== */

#QuickAddStandard {
  position: fixed !important;
  inset: 0 !important;

  width: 100vw !important;
  height: 100dvh !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  padding: 16px !important;
  box-sizing: border-box !important;

  z-index: 2147483000 !important;

  pointer-events: none !important;
}

#QuickAddStandard[open] {
  pointer-events: auto !important;
}


/* ==========================================================
   BACKDROP
   ========================================================== */

#QuickAddStandard #Modal-Overlay {
  position: fixed !important;
  inset: 0 !important;

  width: 100vw !important;
  height: 100dvh !important;

  background: rgba(12,12,12,.55) !important;

  backdrop-filter: blur(5px) !important;
  -webkit-backdrop-filter: blur(5px) !important;

  animation: urqaBackdrop .25s ease both;
}

@keyframes urqaBackdrop {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}


/* ==========================================================
   POPUP — IMPORTANT HEIGHT FIX
   ========================================================== */

#QuickAddStandard .popup__inner {

  position: relative !important;

  inset: auto !important;

  top: auto !important;
  left: auto !important;
  right: auto !important;
  bottom: auto !important;

  transform: none !important;

  width: 440px !important;

  max-width: calc(100vw - 28px) !important;

  height: 230px !important;

  min-height: 230px !important;

  max-height: 230px !important;

  margin: auto !important;

  padding: 0 !important;

  overflow: hidden !important;

  background: #fff !important;

  border: 1px solid rgba(0,0,0,.08) !important;

  border-radius: 16px !important;

  box-shadow:
    0 30px 90px rgba(0,0,0,.30),
    0 8px 25px rgba(0,0,0,.10) !important;

  z-index: 2147483001 !important;

  animation:
    urqaPopupIn
    .32s cubic-bezier(.2,.8,.2,1)
    both !important;
}

@keyframes urqaPopupIn {

  from {
    opacity: 0;

    transform:
      translateY(14px)
      scale(.96) !important;
  }

  to {
    opacity: 1;

    transform:
      translateY(0)
      scale(1) !important;
  }

}


/* ==========================================================
   REMOVE ALL INHERITED HEIGHTS
   ========================================================== */

#QuickStandardModal {

  display: block !important;

  width: 100% !important;

  height: 230px !important;

  min-height: 230px !important;

  max-height: 230px !important;

  overflow: hidden !important;

  padding: 0 !important;

  margin: 0 !important;
}

#QuickStandardModal .section,
#QuickStandardModal .section-background {

  width: 100% !important;

  height: auto !important;

  min-height: 0 !important;

  max-height: none !important;

  padding: 0 !important;

  margin: 0 !important;
}

#QuickStandardModal product-info {

  display: block !important;

  width: 100% !important;

  height: auto !important;

  min-height: 0 !important;

  margin: 0 !important;

  padding: 0 !important;
}


/* ==========================================================
   CLOSE BUTTON
   ========================================================== */

#QuickAddStandard .quick-add-modal__toggle {

  position: absolute !important;

  top: 10px !important;

  right: 10px !important;

  z-index: 100 !important;

  width: 32px !important;

  height: 32px !important;

  min-width: 32px !important;

  min-height: 32px !important;

  padding: 0 !important;

  margin: 0 !important;

  display: flex !important;

  align-items: center !important;

  justify-content: center !important;

  background: rgba(255,255,255,.94) !important;

  color: #111 !important;

  border: 1px solid rgba(0,0,0,.07) !important;

  border-radius: 50% !important;

  box-shadow:
    0 5px 18px rgba(0,0,0,.13) !important;

  transition:
    transform .25s ease,
    background .2s ease,
    color .2s ease !important;
}

#QuickAddStandard .quick-add-modal__toggle:hover {

  transform: rotate(90deg) !important;

  background: #111 !important;

  color: #fff !important;
}

#QuickAddStandard .quick-add-modal__toggle svg {

  width: 15px !important;

  height: 15px !important;
}


/* ==========================================================
   MAIN QUICK ADD
   ========================================================== */

#QuickStandardModal .universes-quick-add {

  display: block !important;

  width: 100% !important;

  height: 230px !important;

  min-height: 230px !important;

  max-height: 230px !important;

  margin: 0 !important;

  padding: 0 !important;

  background: #fff !important;
}


/* ==========================================================
   MAIN GRID
   ========================================================== */

#QuickStandardModal
.universes-quick-add__inner {

  display: grid !important;

  grid-template-columns:
    180px
    minmax(0,1fr) !important;

  width: 100% !important;

  height: 230px !important;

  min-height: 230px !important;

  max-height: 230px !important;

  margin: 0 !important;

  padding: 0 !important;
}


/* ==========================================================
   PRODUCT IMAGE
   ========================================================== */

#QuickStandardModal
.universes-quick-add__image {

  width: 180px !important;

  height: 230px !important;

  min-height: 230px !important;

  max-height: 230px !important;

  overflow: hidden !important;

  background: #f3f3f1 !important;
}

#QuickStandardModal
.universes-quick-add__image-img {

  display: block !important;

  width: 100% !important;

  height: 100% !important;

  min-height: 230px !important;

  max-height: 230px !important;

  object-fit: cover !important;

  object-position: center !important;

  transition:
    transform .6s cubic-bezier(.2,.8,.2,1) !important;
}

#QuickStandardModal
.universes-quick-add__image:hover
.universes-quick-add__image-img {

  transform: scale(1.035) !important;
}


/* ==========================================================
   RIGHT SIDE
   ========================================================== */

#QuickStandardModal
.universes-quick-add__options {

  display: flex !important;

  align-items: center !important;

  justify-content: center !important;

  width: 100% !important;

  height: 230px !important;

  min-width: 0 !important;

  padding: 22px 22px 20px !important;

  box-sizing: border-box !important;
}

#QuickStandardModal
.universes-quick-add__product-form-wrapper {

  display: block !important;

  width: 100% !important;

  max-width: 220px !important;
}

#QuickStandardModal
.universes-quick-add__form {

  display: block !important;

  width: 100% !important;

  margin: 0 !important;

  padding: 0 !important;
}


/* ==========================================================
   VARIANT AREA
   ========================================================== */

#QuickStandardModal
.universes-quick-add__variants {

  display: block !important;

  width: 100% !important;

  margin: 0 !important;

  padding: 0 !important;
}

#QuickStandardModal
.universes-quick-add__option {

  display: block !important;

  width: 100% !important;

  margin: 0 !important;

  padding: 0 !important;

  border: 0 !important;

  outline: 0 !important;
}


/* ==========================================================
   SIZE LABEL
   ========================================================== */

#QuickStandardModal
.universes-quick-add__label {

  display: block !important;

  width: 100% !important;

  margin: 0 0 9px !important;

  padding: 0 !important;

  border: 0 !important;

  font-size: 8px !important;

  line-height: 1 !important;

  font-weight: 700 !important;

  letter-spacing: .20em !important;

  text-transform: uppercase !important;

  color: #161616 !important;
}


/* ==========================================================
   SIZE BUTTONS
   ========================================================== */

#QuickStandardModal
.universes-quick-add__values {

  display: flex !important;

  align-items: center !important;

  flex-wrap: wrap !important;

  gap: 6px !important;

  width: 100% !important;
}

#QuickStandardModal
.universes-quick-add__radio {

  position: absolute !important;

  width: 1px !important;

  height: 1px !important;

  opacity: 0 !important;

  pointer-events: none !important;
}

#QuickStandardModal
.universes-quick-add__value {

  position: relative !important;

  display: inline-flex !important;

  align-items: center !important;

  justify-content: center !important;

  min-width: 37px !important;

  height: 34px !important;

  padding: 0 9px !important;

  margin: 0 !important;

  box-sizing: border-box !important;

  border: 1px solid #dededc !important;

  border-radius: 5px !important;

  background: #fff !important;

  color: #222 !important;

  font-size: 9px !important;

  font-weight: 500 !important;

  letter-spacing: .03em !important;

  cursor: pointer !important;

  transition:
    all .18s cubic-bezier(.2,.8,.2,1) !important;
}

#QuickStandardModal
.universes-quick-add__value:hover {

  border-color: #111 !important;

  transform: translateY(-1px) !important;
}

#QuickStandardModal
.universes-quick-add__radio:checked
+ .universes-quick-add__value {

  background: #111 !important;

  color: #fff !important;

  border-color: #111 !important;

  box-shadow:
    0 5px 14px rgba(0,0,0,.18) !important;

  animation:
    urqaSizePop
    .22s cubic-bezier(.2,.8,.2,1)
    both;
}

@keyframes urqaSizePop {

  0% {
    transform: scale(.90);
  }

  65% {
    transform: scale(1.07);
  }

  100% {
    transform: scale(1);
  }

}

#QuickStandardModal
.universes-quick-add__value.is-disabled {

  opacity: .30 !important;

  background: #f7f7f7 !important;

  text-decoration: line-through !important;

  cursor: not-allowed !important;

  transform: none !important;
}


/* ==========================================================
   CTA
   ========================================================== */

#QuickStandardModal
.universes-quick-add__submit {

  position: relative !important;

  display: flex !important;

  align-items: center !important;

  justify-content: center !important;

  width: 100% !important;

  height: 43px !important;

  min-height: 43px !important;

  margin: 18px 0 0 !important;

  padding: 0 15px !important;

  overflow: hidden !important;

  border: 0 !important;

  border-radius: 5px !important;

  background: #111 !important;

  color: #fff !important;

  font-size: 8px !important;

  line-height: 1 !important;

  font-weight: 700 !important;

  letter-spacing: .19em !important;

  text-transform: uppercase !important;

  cursor: pointer !important;

  box-shadow:
    0 8px 18px rgba(0,0,0,.17) !important;

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    background .2s ease !important;
}


/* SHINE */

#QuickStandardModal
.universes-quick-add__submit::before {

  content: "";

  position: absolute;

  top: 0;

  left: -120%;

  width: 65%;

  height: 100%;

  background:
    linear-gradient(
      100deg,
      transparent,
      rgba(255,255,255,.20),
      transparent
    );

  transform: skewX(-20deg);

  transition: left .55s ease;
}

#QuickStandardModal
.universes-quick-add__submit:hover {

  background: #1b1b1b !important;

  transform: translateY(-2px) !important;

  box-shadow:
    0 12px 25px rgba(0,0,0,.22) !important;
}

#QuickStandardModal
.universes-quick-add__submit:hover::before {

  left: 150%;
}

#QuickStandardModal
.universes-quick-add__submit:active {

  transform: scale(.98) !important;
}

#QuickStandardModal
.universes-quick-add__submit:disabled {

  opacity: .40 !important;

  cursor: not-allowed !important;

  transform: none !important;
}


/* ==========================================================
   MOBILE
   ========================================================== */

@media screen and (max-width: 749px) {

  #QuickAddStandard {

    padding: 10px !important;
  }

  #QuickAddStandard .popup__inner {

    width: 360px !important;

    max-width: calc(100vw - 20px) !important;

    height: 210px !important;

    min-height: 210px !important;

    max-height: 210px !important;

    border-radius: 14px !important;
  }

  #QuickStandardModal {

    height: 210px !important;

    min-height: 210px !important;

    max-height: 210px !important;
  }

  #QuickStandardModal
  .universes-quick-add {

    height: 210px !important;

    min-height: 210px !important;

    max-height: 210px !important;
  }

  #QuickStandardModal
  .universes-quick-add__inner {

    grid-template-columns:
      135px
      minmax(0,1fr) !important;

    height: 210px !important;

    min-height: 210px !important;

    max-height: 210px !important;
  }

  #QuickStandardModal
  .universes-quick-add__image {

    width: 135px !important;

    height: 210px !important;

    min-height: 210px !important;

    max-height: 210px !important;
  }

  #QuickStandardModal
  .universes-quick-add__image-img {

    height: 210px !important;

    min-height: 210px !important;

    max-height: 210px !important;
  }

  #QuickStandardModal
  .universes-quick-add__options {

    height: 210px !important;

    padding: 18px 13px !important;
  }

  #QuickStandardModal
  .universes-quick-add__product-form-wrapper {

    max-width: none !important;
  }

  #QuickStandardModal
  .universes-quick-add__label {

    margin-bottom: 8px !important;

    font-size: 7px !important;
  }

  #QuickStandardModal
  .universes-quick-add__values {

    gap: 4px !important;
  }

  #QuickStandardModal
  .universes-quick-add__value {

    min-width: 32px !important;

    height: 30px !important;

    padding: 0 7px !important;

    font-size: 8px !important;
  }

  #QuickStandardModal
  .universes-quick-add__submit {

    height: 39px !important;

    min-height: 39px !important;

    margin-top: 14px !important;

    font-size: 7px !important;

    letter-spacing: .16em !important;
  }

  #QuickAddStandard
  .quick-add-modal__toggle {

    top: 8px !important;

    right: 8px !important;

    width: 30px !important;

    height: 30px !important;

    min-width: 30px !important;

    min-height: 30px !important;
  }
}


/* ==========================================================
   VERY SMALL PHONE
   ========================================================== */

@media screen and (max-width: 380px) {

  #QuickAddStandard .popup__inner {

    max-width: calc(100vw - 14px) !important;

    height: 195px !important;

    min-height: 195px !important;

    max-height: 195px !important;
  }

  #QuickStandardModal,
  #QuickStandardModal .universes-quick-add {

    height: 195px !important;

    min-height: 195px !important;

    max-height: 195px !important;
  }

  #QuickStandardModal
  .universes-quick-add__inner {

    grid-template-columns:
      120px
      minmax(0,1fr) !important;

    height: 195px !important;

    min-height: 195px !important;

    max-height: 195px !important;
  }

  #QuickStandardModal
  .universes-quick-add__image {

    width: 120px !important;

    height: 195px !important;

    min-height: 195px !important;

    max-height: 195px !important;
  }

  #QuickStandardModal
  .universes-quick-add__image-img {

    height: 195px !important;

    min-height: 195px !important;

    max-height: 195px !important;
  }

}


/* ==========================================================
   UNIVERSes RAW — CLEAR ADD-TO-CART ACTION
   Keeps the existing Quick Add functionality but makes the
   primary action instantly recognizable.
   ========================================================== */

#QuickStandardModal .universes-quick-add__submit {
  gap: 9px !important;
  white-space: nowrap !important;
}

#QuickStandardModal .universes-quick-add__submit::after {
  content: "＋" !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 18px !important;
  height: 18px !important;
  flex: 0 0 18px !important;
  border: 1px solid rgba(255,255,255,.55) !important;
  border-radius: 50% !important;
  font-size: 13px !important;
  font-weight: 400 !important;
  line-height: 1 !important;
  transition:
    transform .2s ease,
    background .2s ease !important;
}

#QuickStandardModal .universes-quick-add__submit:hover::after {
  transform: translateX(2px) scale(1.05) !important;
  background: rgba(255,255,255,.10) !important;
}

/*
 * If the existing button text is "ADD TO CART", preserve it.
 * If the theme supplies another text, this styling still works.
 */
#QuickStandardModal .universes-quick-add__submit .button__text,
#QuickStandardModal .universes-quick-add__submit .btn-text {
  display: inline-flex !important;
  align-items: center !important;
}

/* Mobile: keep the action compact but highly recognizable. */
@media screen and (max-width: 749px) {
  #QuickStandardModal .universes-quick-add__submit {
    gap: 7px !important;
  }

  #QuickStandardModal .universes-quick-add__submit::after {
    width: 16px !important;
    height: 16px !important;
    flex-basis: 16px !important;
    font-size: 12px !important;
  }
}

</style>


<quick-add-modal
  class="quick-add-modal modal--popup fixed top-0 left-0 z-9 w-screen h-full flex justify-center no-js-hidden"
  element-s-popup
  id="QuickAddStandard"
>

  <div
    id="Modal-Overlay"
    class="drawer__overlay fixed inset-0 cursor-pointer"
  ></div>

  <div
    class="popup__inner quick-add-modal__content global-settings-popup"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'products.product.choose_product_options' | t }}"
    tabindex="-1"
  >

    <button
      class="quick-add-modal__toggle drawer__close t-button bor-none rounded-full cursor-pointer"
      type="button"
      onclick="this.closest('quick-add-modal').hide()"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>

    <div
      id="QuickStandardModal"
      class="quick-add-modal__content-info cus-scrollbar"
    ></div>

  </div>

</quick-add-modal>


<bulk-modal
  class="quick-add-modal quick-add-modal--bulk modal--popup fixed top-0 left-0 z-9 w-screen h-full flex justify-center no-js-hidden"
  element-s-popup
  id="QuickAddBulk"
>

  <div
    id="Modal-Overlay-Bulk"
    class="drawer__overlay fixed inset-0 cursor-pointer"
  ></div>

  <div
    class="popup__inner quick-add-modal__content quick-add-modal__content--bulk global-settings-popup"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'products.product.choose_product_options' | t }}"
    tabindex="-1"
  >

    <button
      class="quick-add-modal__toggle drawer__close t-button bor-none rounded-full cursor-pointer"
      type="button"
      onclick="this.closest('bulk-modal').hide()"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>

    <div
      id="QuickBulkModal"
      class="quick-add-modal__content-info quick-add-modal__content-info--bulk cus-scrollbar"
    ></div>

  </div>

</bulk-modal>