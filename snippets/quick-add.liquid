<style>

/* ==========================================================
   UNIVERSes RAW — PREMIUM QUICK ADD
   ========================================================== */

#QuickAddStandard {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100dvh !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  padding: 16px !important;
  box-sizing: border-box !important;

  z-index: 999999 !important;
  pointer-events: none !important;
}

#QuickAddStandard[open] {
  pointer-events: auto !important;
}


/* ==========================================================
   BACKDROP
   ========================================================== */

#QuickAddStandard #Modal-Overlay {
  position: fixed !important;
  inset: 0 !important;

  width: 100vw !important;
  height: 100dvh !important;

  background: rgba(0,0,0,.48) !important;

  backdrop-filter: blur(3px) !important;
  -webkit-backdrop-filter: blur(3px) !important;

  opacity: 0;
  animation: universesOverlayIn .22s ease forwards;
}

@keyframes universesOverlayIn {
  to {
    opacity: 1;
  }
}


/* ==========================================================
   POPUP
   ========================================================== */

#QuickAddStandard .popup__inner {

  position: relative !important;

  inset: auto !important;
  top: auto !important;
  left: auto !important;
  right: auto !important;
  bottom: auto !important;

  transform: none !important;

  width: 520px !important;
  max-width: calc(100vw - 28px) !important;

  height: auto !important;
  max-height: none !important;

  margin: auto !important;
  padding: 0 !important;

  overflow: hidden !important;

  background: #fff !important;

  border: 1px solid rgba(0,0,0,.07) !important;

  border-radius: 18px !important;

  box-shadow:
    0 30px 90px rgba(0,0,0,.25),
    0 8px 30px rgba(0,0,0,.08) !important;

  z-index: 2 !important;

  animation:
    universesQuickAddIn
    .28s cubic-bezier(.2,.8,.2,1)
    both;
}

@keyframes universesQuickAddIn {

  from {
    opacity: 0;
    transform: translateY(16px) scale(.97) !important;
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1) !important;
  }

}


/* ==========================================================
   CONTENT
   ========================================================== */

#QuickStandardModal {

  width: 100% !important;

  height: auto !important;

  max-height: none !important;

  overflow: visible !important;

  padding: 0 !important;
  margin: 0 !important;
}


/* ==========================================================
   CLOSE BUTTON
   ========================================================== */

#QuickAddStandard .quick-add-modal__toggle {

  position: absolute !important;

  top: 12px !important;
  right: 12px !important;

  z-index: 50 !important;

  width: 34px !important;
  height: 34px !important;

  min-width: 34px !important;
  min-height: 34px !important;

  padding: 0 !important;
  margin: 0 !important;

  display: flex !important;

  align-items: center !important;
  justify-content: center !important;

  background: rgba(255,255,255,.94) !important;

  color: #111 !important;

  border: 1px solid rgba(0,0,0,.06) !important;

  border-radius: 50% !important;

  box-shadow:
    0 5px 20px rgba(0,0,0,.12) !important;

  transition:
    transform .2s ease,
    background .2s ease !important;
}

#QuickAddStandard .quick-add-modal__toggle:hover {

  transform: rotate(90deg) !important;

  background: #111 !important;

  color: #fff !important;
}

#QuickAddStandard .quick-add-modal__toggle svg {

  width: 16px !important;
  height: 16px !important;
}


/* ==========================================================
   REMOVE ELLA DEFAULT QUICK ADD SPACING
   ========================================================== */

#QuickStandardModal .section,
#QuickStandardModal .section-background {

  margin: 0 !important;
  padding: 0 !important;
}

#QuickStandardModal product-info {

  display: block !important;

  width: 100% !important;

  margin: 0 !important;
  padding: 0 !important;
}


/* ==========================================================
   QUICK ADD PRODUCT
   ========================================================== */

#QuickStandardModal .universes-quick-add {

  width: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  background: #fff !important;
}


/* ==========================================================
   COMPACT LAYOUT
   ========================================================== */

#QuickStandardModal
.universes-quick-add__inner {

  display: grid !important;

  grid-template-columns:
    190px
    minmax(0,1fr) !important;

  width: 100% !important;

  height: 260px !important;

  min-height: 260px !important;
  max-height: 260px !important;

  margin: 0 !important;
  padding: 0 !important;
}


/* ==========================================================
   IMAGE
   ========================================================== */

#QuickStandardModal
.universes-quick-add__image {

  width: 190px !important;

  height: 260px !important;

  min-height: 260px !important;
  max-height: 260px !important;

  overflow: hidden !important;

  background: #f3f3f1 !important;
}

#QuickStandardModal
.universes-quick-add__image-img {

  display: block !important;

  width: 100% !important;

  height: 100% !important;

  min-height: 260px !important;
  max-height: 260px !important;

  object-fit: cover !important;

  object-position: center !important;

  transition: transform .5s cubic-bezier(.2,.8,.2,1) !important;
}

#QuickStandardModal:hover
.universes-quick-add__image-img {

  transform: scale(1.025) !important;
}


/* ==========================================================
   OPTIONS
   ========================================================== */

#QuickStandardModal
.universes-quick-add__options {

  display: flex !important;

  align-items: center !important;

  justify-content: center !important;

  width: 100% !important;

  height: 260px !important;

  min-width: 0 !important;

  padding: 24px !important;

  box-sizing: border-box !important;
}


#QuickStandardModal
.universes-quick-add__product-form-wrapper {

  display: block !important;

  width: 100% !important;

  max-width: 260px !important;
}


/* ==========================================================
   REMOVE FIELDSET BORDER
   ========================================================== */

#QuickStandardModal
.universes-quick-add__option {

  display: block !important;

  width: 100% !important;

  margin: 0 0 20px !important;

  padding: 0 !important;

  border: 0 !important;

  outline: 0 !important;
}

#QuickStandardModal
.universes-quick-add__option:last-child {

  margin-bottom: 0 !important;
}


/* ==========================================================
   SIZE LABEL
   ========================================================== */

#QuickStandardModal
.universes-quick-add__label {

  display: block !important;

  margin: 0 0 10px !important;

  padding: 0 !important;

  border: 0 !important;

  font-size: 9px !important;

  line-height: 1 !important;

  font-weight: 600 !important;

  letter-spacing: .18em !important;

  text-transform: uppercase !important;

  color: #111 !important;
}


/* ==========================================================
   SIZE OPTIONS
   ========================================================== */

#QuickStandardModal
.universes-quick-add__values {

  display: flex !important;

  align-items: center !important;

  flex-wrap: wrap !important;

  gap: 7px !important;

  width: 100% !important;
}


/* HIDE RADIO */

#QuickStandardModal
.universes-quick-add__radio {

  position: absolute !important;

  width: 1px !important;
  height: 1px !important;

  opacity: 0 !important;

  pointer-events: none !important;
}


/* SIZE BUTTON */

#QuickStandardModal
.universes-quick-add__value {

  position: relative !important;

  display: inline-flex !important;

  align-items: center !important;
  justify-content: center !important;

  min-width: 42px !important;

  height: 36px !important;

  padding: 0 12px !important;

  margin: 0 !important;

  border: 1px solid #dededc !important;

  border-radius: 5px !important;

  background: #fff !important;

  color: #111 !important;

  font-size: 10px !important;

  line-height: 1 !important;

  font-weight: 500 !important;

  letter-spacing: .03em !important;

  cursor: pointer !important;

  transition:
    color .18s ease,
    background .18s ease,
    border-color .18s ease,
    transform .18s ease,
    box-shadow .18s ease !important;
}


/* HOVER */

#QuickStandardModal
.universes-quick-add__value:hover {

  border-color: #111 !important;

  transform: translateY(-1px) !important;

}


/* SELECTED */

#QuickStandardModal
.universes-quick-add__radio:checked
+ .universes-quick-add__value {

  background: #111 !important;

  color: #fff !important;

  border-color: #111 !important;

  box-shadow:
    0 5px 14px rgba(0,0,0,.16) !important;

  animation:
    universesSizeSelect
    .2s ease both;
}


@keyframes universesSizeSelect {

  0% {
    transform: scale(.94);
  }

  70% {
    transform: scale(1.04);
  }

  100% {
    transform: scale(1);
  }

}


/* DISABLED */

#QuickStandardModal
.universes-quick-add__value.is-disabled {

  opacity: .28 !important;

  text-decoration: line-through !important;

  cursor: not-allowed !important;

  background: #f7f7f7 !important;
}


/* ==========================================================
   ADD TO CART
   ========================================================== */

#QuickStandardModal
.universes-quick-add__submit {

  position: relative !important;

  display: flex !important;

  align-items: center !important;

  justify-content: center !important;

  width: 100% !important;

  height: 45px !important;

  min-height: 45px !important;

  margin: 20px 0 0 !important;

  padding: 0 18px !important;

  border: 0 !important;

  border-radius: 5px !important;

  background: #111 !important;

  color: #fff !important;

  font-size: 9px !important;

  line-height: 1 !important;

  font-weight: 600 !important;

  letter-spacing: .18em !important;

  text-transform: uppercase !important;

  cursor: pointer !important;

  overflow: hidden !important;

  box-shadow:
    0 8px 20px rgba(0,0,0,.16) !important;

  transition:
    transform .2s ease,
    background .2s ease,
    box-shadow .2s ease !important;
}


#QuickStandardModal
.universes-quick-add__submit::before {

  content: "";

  position: absolute;

  top: 0;
  left: -120%;

  width: 70%;
  height: 100%;

  background:
    linear-gradient(
      100deg,
      transparent,
      rgba(255,255,255,.22),
      transparent
    );

  transform: skewX(-20deg);

  transition: left .55s ease;
}


#QuickStandardModal
.universes-quick-add__submit:hover {

  background: #1d1d1d !important;

  transform: translateY(-2px) !important;

  box-shadow:
    0 12px 26px rgba(0,0,0,.2) !important;
}


#QuickStandardModal
.universes-quick-add__submit:hover::before {

  left: 150%;
}


#QuickStandardModal
.universes-quick-add__submit:active {

  transform: translateY(0) scale(.98) !important;
}


#QuickStandardModal
.universes-quick-add__submit:disabled {

  opacity: .4 !important;

  cursor: not-allowed !important;

  transform: none !important;
}


/* ==========================================================
   MOBILE
   ========================================================== */

@media screen and (max-width: 749px) {

  #QuickAddStandard {

    padding: 12px !important;

  }


  #QuickAddStandard .popup__inner {

    width: 380px !important;

    max-width: calc(100vw - 24px) !important;

    border-radius: 15px !important;

  }


  #QuickStandardModal
  .universes-quick-add__inner {

    grid-template-columns:
      145px
      minmax(0,1fr) !important;

    height: 220px !important;

    min-height: 220px !important;

    max-height: 220px !important;

  }


  #QuickStandardModal
  .universes-quick-add__image {

    width: 145px !important;

    height: 220px !important;

    min-height: 220px !important;

    max-height: 220px !important;

  }


  #QuickStandardModal
  .universes-quick-add__image-img {

    height: 220px !important;

    min-height: 220px !important;

    max-height: 220px !important;

  }


  #QuickStandardModal
  .universes-quick-add__options {

    height: 220px !important;

    padding: 18px 14px !important;

  }


  #QuickStandardModal
  .universes-quick-add__product-form-wrapper {

    max-width: none !important;

  }


  #QuickStandardModal
  .universes-quick-add__option {

    margin-bottom: 12px !important;

  }


  #QuickStandardModal
  .universes-quick-add__label {

    margin-bottom: 8px !important;

    font-size: 8px !important;

  }


  #QuickStandardModal
  .universes-quick-add__values {

    gap: 5px !important;

  }


  #QuickStandardModal
  .universes-quick-add__value {

    min-width: 34px !important;

    height: 31px !important;

    padding: 0 8px !important;

    font-size: 9px !important;

    border-radius: 4px !important;

  }


  #QuickStandardModal
  .universes-quick-add__submit {

    height: 40px !important;

    min-height: 40px !important;

    margin-top: 13px !important;

    font-size: 8px !important;

    letter-spacing: .15em !important;

  }


  #QuickAddStandard
  .quick-add-modal__toggle {

    top: 9px !important;

    right: 9px !important;

    width: 32px !important;

    height: 32px !important;

    min-width: 32px !important;

    min-height: 32px !important;

  }

}


/* ==========================================================
   SMALL PHONES
   ========================================================== */

@media screen and (max-width: 380px) {

  #QuickAddStandard .popup__inner {

    max-width: calc(100vw - 18px) !important;

  }


  #QuickStandardModal
  .universes-quick-add__inner {

    grid-template-columns:
      120px
      minmax(0,1fr) !important;

    height: 195px !important;

    min-height: 195px !important;

    max-height: 195px !important;

  }


  #QuickStandardModal
  .universes-quick-add__image {

    width: 120px !important;

    height: 195px !important;

    min-height: 195px !important;

    max-height: 195px !important;

  }


  #QuickStandardModal
  .universes-quick-add__image-img {

    height: 195px !important;

    min-height: 195px !important;

    max-height: 195px !important;

  }


  #QuickStandardModal
  .universes-quick-add__options {

    height: 195px !important;

    padding: 15px 11px !important;

  }

}

</style>


<quick-add-modal
  class="quick-add-modal modal--popup fixed top-0 left-0 z-9 w-screen h-full flex justify-center no-js-hidden"
  element-s-popup
  id="QuickAddStandard"
>

  <div
    id="Modal-Overlay"
    class="drawer__overlay fixed inset-0 cursor-pointer"
  ></div>

  <div
    class="popup__inner quick-add-modal__content global-settings-popup"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'products.product.choose_product_options' | t }}"
    tabindex="-1"
  >

    <button
      class="quick-add-modal__toggle drawer__close t-button bor-none rounded-full cursor-pointer"
      type="button"
      onclick="this.closest('quick-add-modal').hide()"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>

    <div
      id="QuickStandardModal"
      class="quick-add-modal__content-info cus-scrollbar"
    ></div>

  </div>

</quick-add-modal>


<bulk-modal
  class="quick-add-modal quick-add-modal--bulk modal--popup fixed top-0 left-0 z-9 w-screen h-full flex justify-center no-js-hidden"
  element-s-popup
  id="QuickAddBulk"
>

  <div
    id="Modal-Overlay-Bulk"
    class="drawer__overlay fixed inset-0 cursor-pointer"
  ></div>

  <div
    class="popup__inner quick-add-modal__content quick-add-modal__content--bulk global-settings-popup"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'products.product.choose_product_options' | t }}"
    tabindex="-1"
  >

    <button
      class="quick-add-modal__toggle drawer__close t-button bor-none rounded-full cursor-pointer"
      type="button"
      onclick="this.closest('bulk-modal').hide()"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>

    <div
      id="QuickBulkModal"
      class="quick-add-modal__content-info quick-add-modal__content-info--bulk cus-scrollbar"
    ></div>

  </div>

</bulk-modal>