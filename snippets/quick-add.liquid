{% comment %}
  ============================================================
  UNIVERSes RAW — QUICK ADD MODAL
  Compact / Minimal / Centered
  ============================================================
{% endcomment %}

<style>
  /* ==========================================================
     QUICK ADD MODAL — BASE
     ========================================================== */

  #QuickAddStandard {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100dvh !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    z-index: 999999 !important;
    pointer-events: none !important;
  }

  #QuickAddStandard[open] {
    pointer-events: auto !important;
  }

  #QuickAddStandard #Modal-Overlay {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100dvh !important;
    background: rgba(0, 0, 0, 0.48) !important;
    z-index: 0 !important;
  }


  /* ==========================================================
     POPUP
     ========================================================== */

  #QuickAddStandard .popup__inner {
    position: relative !important;
    inset: auto !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    bottom: auto !important;
    transform: none !important;

    width: 680px !important;
    max-width: calc(100vw - 32px) !important;

    height: auto !important;
    max-height: 520px !important;

    margin: auto !important;

    display: block !important;

    overflow: hidden !important;

    background: #ffffff !important;

    border-radius: 14px !important;

    border: 1px solid rgba(0, 0, 0, 0.08) !important;

    box-shadow:
      0 25px 80px rgba(0, 0, 0, 0.28) !important;

    z-index: 2 !important;
  }


  /* ==========================================================
     CONTENT
     ========================================================== */

  #QuickStandardModal {
    width: 100% !important;

    height: auto !important;

    max-height: 520px !important;

    overflow-x: hidden !important;
    overflow-y: auto !important;

    padding: 0 !important;
    margin: 0 !important;

    scrollbar-width: thin !important;
  }


  #QuickStandardModal::-webkit-scrollbar {
    width: 5px;
  }

  #QuickStandardModal::-webkit-scrollbar-track {
    background: transparent;
  }

  #QuickStandardModal::-webkit-scrollbar-thumb {
    background: rgba(0,0,0,.18);
    border-radius: 20px;
  }


  /* ==========================================================
     SECTION RESET
     ========================================================== */

  #QuickStandardModal .section,
  #QuickStandardModal .section-background {
    margin: 0 !important;
  }

  #QuickStandardModal .section {
    padding: 0 !important;
  }

  #QuickStandardModal .section-background {
    display: none !important;
  }


  /* ==========================================================
     PRODUCT INFORMATION
     ========================================================== */

  #QuickStandardModal product-info {
    display: block !important;

    width: 100% !important;

    margin: 0 !important;
    padding: 0 !important;

    min-height: 0 !important;
  }


  /* ==========================================================
     MAIN GRID
     ========================================================== */

  #QuickStandardModal
  .product-quick-add__grid,
  #QuickStandardModal
  .product-information__grid {

    display: grid !important;

    grid-template-columns: 46% 54% !important;

    align-items: stretch !important;

    gap: 0 !important;

    width: 100% !important;

    margin: 0 !important;

    padding: 0 !important;
  }


  /* ==========================================================
     MEDIA COLUMN
     ========================================================== */

  #QuickStandardModal
  .product-information__media {

    width: 100% !important;

    min-width: 0 !important;

    margin: 0 !important;

    padding: 0 !important;

    display: flex !important;

    align-items: stretch !important;

    overflow: hidden !important;
  }


  #QuickStandardModal
  .product-quick-add__media {

    width: 100% !important;

    height: 100% !important;

    margin: 0 !important;

    padding: 0 !important;

    overflow: hidden !important;
  }


  /* ==========================================================
     IMAGE / GALLERY
     ========================================================== */

  #QuickStandardModal
  .product-information__media
  media-gallery {

    display: block !important;

    width: 100% !important;

    height: 100% !important;

    margin: 0 !important;

    padding: 0 !important;
  }


  #QuickStandardModal
  .product-information__media
  .product__media-list {

    width: 100% !important;

    height: 100% !important;

    margin: 0 !important;

    padding: 0 !important;
  }


  #QuickStandardModal
  .product-information__media
  .product__media-item {

    width: 100% !important;

    margin: 0 !important;

    padding: 0 !important;
  }


  #QuickStandardModal
  .product-information__media
  img {

    display: block !important;

    width: 100% !important;

    height: 100% !important;

    min-height: 380px !important;

    max-height: 500px !important;

    object-fit: cover !important;

    object-position: center !important;

    margin: 0 !important;
  }


  #QuickStandardModal
  .product-information__media
  .product-media-container {

    width: 100% !important;

    height: 100% !important;

    margin: 0 !important;

    padding: 0 !important;
  }


  /* ==========================================================
     DETAILS COLUMN
     ========================================================== */

  #QuickStandardModal
  .product-information__grid
  > .product-information__media
  + * {

    min-width: 0 !important;
  }


  #QuickStandardModal
  .product-information__grid
  .product-details {

    width: 100% !important;

    min-width: 0 !important;

    margin: 0 !important;

    padding: 30px 28px !important;

    display: flex !important;

    flex-direction: column !important;

    justify-content: center !important;

    box-sizing: border-box !important;
  }


  /* ==========================================================
     PRODUCT TEXT
     ========================================================== */

  #QuickStandardModal
  .product-details
  .product-title,
  #QuickStandardModal
  .product-details h1,
  #QuickStandardModal
  .product-details h2 {

    margin-top: 0 !important;

    margin-bottom: 10px !important;

    line-height: 1.2 !important;
  }


  #QuickStandardModal
  .product-details h1,
  #QuickStandardModal
  .product-details h2 {

    font-size: 20px !important;

    font-weight: 500 !important;

    letter-spacing: -0.02em !important;
  }


  /* ==========================================================
     VENDOR
     ========================================================== */

  #QuickStandardModal
  .product-details
  > p:first-child {

    margin-top: 0 !important;

    margin-bottom: 8px !important;

    font-size: 9px !important;

    line-height: 1 !important;

    letter-spacing: .16em !important;

    text-transform: uppercase !important;

    color: rgba(0,0,0,.5) !important;
  }


  /* ==========================================================
     PRICE
     ========================================================== */

  #QuickStandardModal
  .price {

    display: flex !important;

    align-items: center !important;

    gap: 8px !important;

    margin: 0 0 18px !important;
  }


  #QuickStandardModal
  .price-item {

    font-size: 17px !important;

    line-height: 1.2 !important;
  }


  #QuickStandardModal
  .price-item--regular {

    font-weight: 600 !important;
  }


  /* ==========================================================
     VARIANT PICKER
     ========================================================== */

  #QuickStandardModal
  variant-picker {

    display: block !important;

    width: 100% !important;

    margin: 0 0 14px !important;

    padding: 0 !important;
  }


  #QuickStandardModal
  variant-picker fieldset {

    margin: 0 0 12px !important;

    padding: 0 !important;

    border: 0 !important;
  }


  #QuickStandardModal
  variant-picker legend {

    margin: 0 0 7px !important;

    padding: 0 !important;

    font-size: 9px !important;

    font-weight: 600 !important;

    line-height: 1 !important;

    letter-spacing: .12em !important;

    text-transform: uppercase !important;
  }


  /* ==========================================================
     SIZE / VARIANT BUTTONS
     ========================================================== */

  #QuickStandardModal
  variant-picker
  input[type="radio"] + label {

    display: inline-flex !important;

    align-items: center !important;

    justify-content: center !important;

    min-width: 40px !important;

    height: 34px !important;

    margin: 0 5px 5px 0 !important;

    padding: 0 11px !important;

    border-radius: 4px !important;

    font-size: 11px !important;

    line-height: 1 !important;

    cursor: pointer !important;

    box-sizing: border-box !important;
  }


  #QuickStandardModal
  variant-picker
  input[type="radio"]:checked + label {

    background: #111111 !important;

    color: #ffffff !important;

    border-color: #111111 !important;
  }


  /* ==========================================================
     QUANTITY
     ========================================================== */

  #QuickStandardModal
  quantity-input,
  #QuickStandardModal
  quantity-selector {

    display: inline-flex !important;

    align-items: center !important;

    width: fit-content !important;

    margin: 2px 0 16px !important;
  }


  #QuickStandardModal
  quantity-input input,
  #QuickStandardModal
  quantity-selector input {

    width: 44px !important;

    min-width: 44px !important;

    height: 38px !important;

    text-align: center !important;

    padding: 0 !important;

    border: 0 !important;
  }


  #QuickStandardModal
  quantity-input button,
  #QuickStandardModal
  quantity-selector button {

    width: 38px !important;

    height: 38px !important;

    min-width: 38px !important;

    padding: 0 !important;
  }


  /* ==========================================================
     BUY BUTTONS
     ========================================================== */

  #QuickStandardModal
  buy-buttons {

    display: block !important;

    width: 100% !important;

    margin: 0 !important;

    padding: 0 !important;
  }


  #QuickStandardModal
  buy-buttons
  button[name="add"],
  #QuickStandardModal
  button[type="submit"][name="add"] {

    width: 100% !important;

    min-height: 44px !important;

    height: 44px !important;

    margin: 0 !important;

    padding: 0 16px !important;

    border: 0 !important;

    border-radius: 5px !important;

    background: #111111 !important;

    color: #ffffff !important;

    font-size: 10px !important;

    font-weight: 600 !important;

    letter-spacing: .14em !important;

    text-transform: uppercase !important;
  }


  #QuickStandardModal
  buy-buttons
  button[name="add"]:hover {

    background: #c3192e !important;
  }


  /* ==========================================================
     REMOVE UNNECESSARY INFORMATION
     ========================================================== */

  #QuickStandardModal
  pickup-availability,

  #QuickStandardModal
  share-button,

  #QuickStandardModal
  product-modal,

  #QuickStandardModal
  product-popup-modal,

  #QuickStandardModal
  product__description,

  #QuickStandardModal
  .product__description,

  #QuickStandardModal
  .product-description,

  #QuickStandardModal
  .product__sku,

  #QuickStandardModal
  .product__inventory {

    display: none !important;
  }


  /* ==========================================================
     CLOSE BUTTON
     ========================================================== */

  #QuickAddStandard
  .quick-add-modal__toggle {

    position: absolute !important;

    top: 10px !important;

    right: 10px !important;

    z-index: 100 !important;

    width: 36px !important;

    height: 36px !important;

    min-width: 36px !important;

    min-height: 36px !important;

    padding: 0 !important;

    margin: 0 !important;

    display: flex !important;

    align-items: center !important;

    justify-content: center !important;

    background: rgba(255,255,255,.96) !important;

    color: #111111 !important;

    border: 0 !important;

    border-radius: 50% !important;

    box-shadow: 0 4px 18px rgba(0,0,0,.12) !important;
  }


  #QuickAddStandard
  .quick-add-modal__toggle svg {

    width: 18px !important;

    height: 18px !important;
  }


  /* ==========================================================
     WHATSAPP MUST STAY BEHIND QUICK ADD
     ========================================================== */

  #QuickAddStandard,
  #QuickAddBulk {

    z-index: 999999 !important;
  }


  .whatsapp-float,
  .whatsapp-button,
  .whatsapp-widget,
  .whatsapp-chat,
  [class*="whatsapp"] {

    z-index: 999 !important;
  }


  /* ==========================================================
     BULK MODAL
     ========================================================== */

  #QuickAddBulk {

    z-index: 999999 !important;
  }


  #QuickAddBulk .popup__inner {

    max-width: 900px !important;

    max-height: 80dvh !important;

    border-radius: 14px !important;

    overflow: hidden !important;
  }


  #QuickBulkModal {

    max-height: 80dvh !important;

    overflow-y: auto !important;

    overflow-x: hidden !important;
  }


  /* ==========================================================
     MOBILE
     ========================================================== */

  @media screen and (max-width: 749px) {

    #QuickAddStandard {

      align-items: center !important;

      justify-content: center !important;
    }


    #QuickAddStandard
    .popup__inner {

      width: calc(100vw - 24px) !important;

      max-width: calc(100vw - 24px) !important;

      max-height: 82dvh !important;

      border-radius: 12px !important;
    }


    #QuickStandardModal {

      max-height: 82dvh !important;
    }


    #QuickStandardModal
    .product-quick-add__grid,
    #QuickStandardModal
    .product-information__grid {

      display: flex !important;

      flex-direction: column !important;

      width: 100% !important;
    }


    /* Mobile image */

    #QuickStandardModal
    .product-information__media {

      width: 100% !important;

      height: 240px !important;

      min-height: 240px !important;

      max-height: 240px !important;
    }


    #QuickStandardModal
    .product-information__media img {

      width: 100% !important;

      height: 240px !important;

      min-height: 240px !important;

      max-height: 240px !important;

      object-fit: cover !important;
    }


    /* Mobile details */

    #QuickStandardModal
    .product-details {

      padding: 20px !important;

      display: block !important;
    }


    #QuickStandardModal
    .product-details h1,
    #QuickStandardModal
    .product-details h2 {

      font-size: 18px !important;

      margin-bottom: 8px !important;
    }


    #QuickAddStandard
    .quick-add-modal__toggle {

      top: 8px !important;

      right: 8px !important;

      width: 34px !important;

      height: 34px !important;

      min-width: 34px !important;

      min-height: 34px !important;
    }


    #QuickStandardModal
    variant-picker
    input[type="radio"] + label {

      min-width: 42px !important;

      height: 36px !important;
    }
  }


  /* ==========================================================
     VERY SMALL PHONES
     ========================================================== */

  @media screen and (max-width: 380px) {

    #QuickAddStandard
    .popup__inner {

      width: calc(100vw - 16px) !important;

      max-width: calc(100vw - 16px) !important;
    }


    #QuickStandardModal
    .product-information__media {

      height: 210px !important;

      min-height: 210px !important;
    }


    #QuickStandardModal
    .product-information__media img {

      height: 210px !important;

      min-height: 210px !important;
    }


    #QuickStandardModal
    .product-details {

      padding: 16px !important;
    }
  }
</style>


<!-- ==========================================================
     STANDARD QUICK ADD
     ========================================================== -->

<quick-add-modal
  class="quick-add-modal modal--popup fixed top-0 left-0 z-9 w-screen h-full flex justify-center no-js-hidden"
  element-s-popup
  id="QuickAddStandard"
>

  <div
    id="Modal-Overlay"
    class="drawer__overlay fixed inset-0 cursor-pointer"
  ></div>


  <div
    class="popup__inner quick-add-modal__content global-settings-popup"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'products.product.choose_product_options' | t }}"
    tabindex="-1"
  >

    <button
      class="quick-add-modal__toggle drawer__close t-button bor-none rounded-full cursor-pointer"
      type="button"
      onclick="this.closest('quick-add-modal').hide()"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>


    <div
      id="QuickStandardModal"
      class="quick-add-modal__content-info cus-scrollbar"
    ></div>

  </div>

</quick-add-modal>


<!-- ==========================================================
     BULK QUICK ADD
     ========================================================== -->

<bulk-modal
  class="quick-add-modal quick-add-modal--bulk modal--popup fixed top-0 left-0 z-9 w-screen h-full flex justify-center no-js-hidden"
  element-s-popup
  id="QuickAddBulk"
>

  <div
    id="Modal-Overlay-Bulk"
    class="drawer__overlay fixed inset-0 cursor-pointer"
  ></div>


  <div
    class="popup__inner quick-add-modal__content quick-add-modal__content--bulk global-settings-popup"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'products.product.choose_product_options' | t }}"
    tabindex="-1"
  >

    <button
      class="quick-add-modal__toggle drawer__close t-button bor-none rounded-full cursor-pointer"
      type="button"
      onclick="this.closest('bulk-modal').hide()"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>


    <div
      id="QuickBulkModal"
      class="quick-add-modal__content-info quick-add-modal__content-info--bulk cus-scrollbar"
    ></div>

  </div>

</bulk-modal>