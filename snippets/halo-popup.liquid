<template id="HaloQuickAddTemplate">
  {%- render 'quick-add' -%}
</template>

{%- if settings.enable_quick_view -%}
  <link
    rel="stylesheet"
    href="{{ 'quick-view.css' | asset_url }}"
    media="print"
    fetchpriority="low"
    onload="this.media='all'"
  >
  <noscript>
    <link
      rel="stylesheet"
      href="{{ 'quick-view.css' | asset_url }}"
    >
  </noscript>

  {%- render 'quick-view' -%}

  <script
    src="{{ 'quick-view.js' | asset_url }}"
    defer="defer"
  ></script>
{%- endif -%}


{%- if settings.enable_compare -%}

  {% render 'compare-popup' %}

  <script
    src="{{ 'product-compare.js' | asset_url }}"
    defer="defer"
  ></script>

{%- endif -%}


{%- if settings.show_quick_edit_cart -%}

  {% render 'edit-cart-popup' %}

{%- endif -%}


<script>
(function () {

  'use strict';


  /* ==========================================================
     UNIVERSES RAW
     ULTRA FAST QUICK ADD
     ========================================================== */


  const urls = {

    quickAddModalCss:
      "{{ 'quick-add-modal.css' | asset_url }}",

    quantityPopoverCss:
      "{{ 'quantity-popover.css' | asset_url }}",

    quickOrderListCss:
      "{{ 'quick-order-list.css' | asset_url }}",

    productForm:
      "{{ 'product-form.js' | asset_url }}",

    quickAdd:
      "{{ 'quick-add.js' | asset_url }}",

    quickAddBulk:
      "{{ 'quick-add-bulk.js' | asset_url }}",

    quantityPopover:
      "{{ 'quantity-popover.js' | asset_url }}",

    pricePerItem:
      "{{ 'price-per-item.js' | asset_url }}",

    quickOrderList:
      "{{ 'quick-order-list.js' | asset_url }}",

    editCartPopup:
      "{{ 'edit-cart.js' | asset_url }}"

  };


  /* ==========================================================
     GLOBAL CACHE
     ========================================================== */

  window.__haloLoadedScripts =
    window.__haloLoadedScripts || {};

  window.__haloLoadedStyles =
    window.__haloLoadedStyles || {};

  window.__haloQuickAddReady =
    window.__haloQuickAddReady || {};

  window.__haloQuickAddPreloading =
    window.__haloQuickAddPreloading || {};


  /* ==========================================================
     CUSTOM ELEMENT CHECK
     ========================================================== */

  function isDefined(name) {

    return (
      typeof customElements !== 'undefined' &&
      customElements.get(name)
    );

  }


  /* ==========================================================
     LOAD SCRIPT ONCE
     ========================================================== */

  function loadScriptOnce(src) {

    if (!src) {
      return Promise.resolve();
    }


    /*
     * Already loaded / loading.
     */
    if (window.__haloLoadedScripts[src]) {

      return window.__haloLoadedScripts[src];

    }


    /*
     * Load asynchronously and cache the Promise.
     */
    window.__haloLoadedScripts[src] = new Promise(
      function (resolve, reject) {

        const script =
          document.createElement('script');

        script.src = src;

        /*
         * Async prevents one script from blocking
         * the loading of another.
         */
        script.async = true;

        script.onload = function () {

          resolve();

        };

        script.onerror = function () {

          reject(
            new Error(
              'Failed to load: ' + src
            )
          );

        };

        document.head.appendChild(script);

      }
    );


    return window.__haloLoadedScripts[src];

  }


  /* ==========================================================
     LOAD CSS ONCE
     ========================================================== */

  function loadStyleOnce(href) {

    if (!href) {
      return;
    }


    if (
      window.__haloLoadedStyles[href]
    ) {

      return;

    }


    window.__haloLoadedStyles[href] = true;


    /*
     * Check whether stylesheet already exists.
     */
    const existing =
      document.querySelector(
        'link[href="' + href + '"]'
      );


    if (existing) {

      return;

    }


    const link =
      document.createElement('link');

    link.rel = 'stylesheet';

    link.href = href;

    document.head.appendChild(link);

  }


  /* ==========================================================
     MOUNT QUICK ADD TEMPLATE IMMEDIATELY
     ========================================================== */

  function mountQuickAddMarkup() {

    /*
     * Already mounted.
     */
    if (
      document.getElementById(
        'QuickAddStandard'
      ) ||
      document.getElementById(
        'QuickAddBulk'
      )
    ) {

      return true;

    }


    const template =
      document.getElementById(
        'HaloQuickAddTemplate'
      );


    if (
      !template ||
      !template.content
    ) {

      return false;

    }


    /*
     * Clone the Quick Add modal into body
     * immediately during page initialization.
     */
    document.body.appendChild(
      template.content.cloneNode(true)
    );


    return true;

  }


  /* ==========================================================
     QUICK ADD STYLES
     ========================================================== */

  function preloadQuickAddStyles(type) {

    /*
     * Standard Quick Add
     */
    loadStyleOnce(
      urls.quickAddModalCss
    );

    loadStyleOnce(
      urls.quantityPopoverCss
    );


    /*
     * Bulk Quick Add
     */
    if (type === 'bulk') {

      loadStyleOnce(
        urls.quickOrderListCss
      );

    }

  }


  /* ==========================================================
     BUILD STANDARD QUICK ADD SCRIPT QUEUE
     ========================================================== */

  function getStandardQuickAddScripts() {

    const scripts = [];


    /*
     * Product form.
     */
    if (
      !isDefined(
        'product-form-component'
      )
    ) {

      scripts.push(
        urls.productForm
      );

    }


    /*
     * Quantity popover.
     */
    if (
      !isDefined(
        'quantity-popover'
      )
    ) {

      scripts.push(
        urls.quantityPopover
      );

    }


    /*
     * Price per item.
     */
    if (
      !isDefined(
        'price-per-item'
      )
    ) {

      scripts.push(
        urls.pricePerItem
      );

    }


    /*
     * Main Quick Add modal.
     */
    if (
      !isDefined(
        'quick-add-modal'
      )
    ) {

      scripts.push(
        urls.quickAdd
      );

    }


    return scripts;

  }


  /* ==========================================================
     BUILD BULK QUICK ADD SCRIPT QUEUE
     ========================================================== */

  function getBulkQuickAddScripts() {

    const scripts = [];


    if (
      !isDefined(
        'product-form-component'
      )
    ) {

      scripts.push(
        urls.productForm
      );

    }


    if (
      !isDefined(
        'quantity-popover'
      )
    ) {

      scripts.push(
        urls.quantityPopover
      );

    }


    if (
      !isDefined(
        'price-per-item'
      )
    ) {

      scripts.push(
        urls.pricePerItem
      );

    }


    if (
      !isDefined(
        'quick-add-bulk'
      )
    ) {

      scripts.push(
        urls.quickAddBulk
      );

    }


    if (
      !isDefined(
        'quick-order-list'
      )
    ) {

      scripts.push(
        urls.quickOrderList
      );

    }


    return scripts;

  }


  /* ==========================================================
     PRELOAD STANDARD QUICK ADD
     ========================================================== */

  function preloadStandardQuickAdd() {

    /*
     * Prevent duplicate preload operations.
     */
    if (
      window.__haloQuickAddPreloading.standard
    ) {

      return (
        window.__haloQuickAddPreloading
          .standard
      );

    }


    window.__haloQuickAddPreloading
      .standard = (async function () {

        /*
         * Load CSS immediately.
         */
        preloadQuickAddStyles(
          'standard'
        );


        /*
         * ModalDialog must exist before
         * quick-add-modal is registered.
         *
         * If it is already available,
         * continue immediately.
         */
        try {

          if (
            typeof customElements !==
            'undefined' &&
            customElements.whenDefined
          ) {

            await customElements
              .whenDefined(
                'modal-dialog'
              );

          }

        } catch (error) {

          /*
           * Continue even if the browser
           * doesn't support whenDefined.
           */

        }


        /*
         * Get every required script.
         */
        const scripts =
          getStandardQuickAddScripts();


        /*
         * IMPORTANT:
         *
         * Load ALL scripts in parallel.
         *
         * The old code loaded them one
         * after another.
         */
        await Promise.all(
          scripts.map(
            function (src) {

              return loadScriptOnce(
                src
              );

            }
          )
        );


        /*
         * Make sure modal markup exists.
         */
        mountQuickAddMarkup();


        window.__haloQuickAddReady
          .standard = true;


      })().catch(
        function (error) {

          console.warn(
            '[Universes RAW] Quick Add preload failed:',
            error
          );

        }
      );


    return (
      window.__haloQuickAddPreloading
        .standard
    );

  }


  /* ==========================================================
     PRELOAD BULK QUICK ADD
     ========================================================== */

  function preloadBulkQuickAdd() {

    if (
      window.__haloQuickAddPreloading.bulk
    ) {

      return (
        window.__haloQuickAddPreloading
          .bulk
      );

    }


    window.__haloQuickAddPreloading
      .bulk = (async function () {

        preloadQuickAddStyles(
          'bulk'
        );


        try {

          if (
            typeof customElements !==
            'undefined' &&
            customElements.whenDefined
          ) {

            await customElements
              .whenDefined(
                'modal-dialog'
              );

          }

        } catch (error) {}


        const scripts =
          getBulkQuickAddScripts();


        /*
         * Parallel loading.
         */
        await Promise.all(
          scripts.map(
            function (src) {

              return loadScriptOnce(
                src
              );

            }
          )
        );


        mountQuickAddMarkup();


        window.__haloQuickAddReady
          .bulk = true;


      })().catch(
        function (error) {

          console.warn(
            '[Universes RAW] Bulk Quick Add preload failed:',
            error
          );

        }
      );


    return (
      window.__haloQuickAddPreloading
        .bulk
    );

  }


  /* ==========================================================
     CHECK FOR QUICK ADD OPENERS
     ========================================================== */

  function hasStandardQuickAddOpeners() {

    return Boolean(
      document.querySelector(
        'modal-opener[data-modal="#QuickAddStandard"]'
      )
    );

  }


  function hasBulkQuickAddOpeners() {

    return Boolean(
      document.querySelector(
        'modal-opener[data-modal="#QuickAddBulk"]'
      )
    );

  }


  /* ==========================================================
     INITIALIZE QUICK ADD IMMEDIATELY
     ========================================================== */

  function initializeQuickAdd() {

    /*
     * Mount modal BEFORE the customer clicks.
     */
    mountQuickAddMarkup();


    /*
     * If standard Quick Add exists,
     * start preloading immediately.
     */
    if (
      hasStandardQuickAddOpeners()
    ) {

      preloadStandardQuickAdd();

    }


    /*
     * Bulk Quick Add.
     */
    if (
      hasBulkQuickAddOpeners()
    ) {

      preloadBulkQuickAdd();

    }

  }


  /* ==========================================================
     FAST INITIALIZATION
     ========================================================== */

  /*
   * Don't wait for requestIdleCallback.
   *
   * Start immediately.
   */
  initializeQuickAdd();


  /* ==========================================================
     SHOPIFY DYNAMIC SECTION SUPPORT
     * ========================================================== */

  document.addEventListener(
    'shopify:section:load',
    function () {

      /*
       * Newly loaded collection/product
       * sections may contain Quick Add.
       */
      initializeQuickAdd();

    }
  );


  document.addEventListener(
    'shopify:section:reorder',
    function () {

      initializeQuickAdd();

    }
  );


  document.addEventListener(
    'shopify:section:select',
    function () {

      initializeQuickAdd();

    }
  );


  /* ==========================================================
     ULTRA FAST CLICK FALLBACK
     ========================================================== */

  document.addEventListener(
    'click',
    function (event) {

      const button =
        event.target.closest(
          'modal-opener[data-modal="#QuickAddStandard"] button, ' +
          'modal-opener[data-modal="#QuickAddBulk"] button'
        );


      if (!button) {

        return;

      }


      const opener =
        button.closest(
          'modal-opener'
        );


      if (!opener) {

        return;

      }


      const modalSelector =
        opener.getAttribute(
          'data-modal'
        );


      if (!modalSelector) {

        return;

      }


      const type =
        modalSelector ===
        '#QuickAddBulk'
          ? 'bulk'
          : 'standard';


      /*
       * Modal should already exist because
       * we mounted it during initialization.
       */
      const modal =
        document.querySelector(
          modalSelector
        );


      /*
       * If everything is already ready,
       * DO NOTHING.
       *
       * Shopify's native modal-opener
       * will handle the click instantly.
       */
      if (
        modal &&
        (
          type === 'standard'
            ? isDefined('quick-add-modal')
            : isDefined('quick-add-bulk')
        )
      ) {

        return;

      }


      /*
       * Extremely fast first-click fallback.
       *
       * If the user clicked before the
       * component finished loading, wait
       * only for the component and open it.
       */
      event.preventDefault();
      event.stopImmediatePropagation();


      const readyPromise =
        type === 'standard'
          ? preloadStandardQuickAdd()
          : preloadBulkQuickAdd();


      readyPromise.then(
        function () {

          const readyModal =
            document.querySelector(
              modalSelector
            );


          if (
            !readyModal
          ) {

            return;

          }


          /*
           * Wait for custom element upgrade.
           */
          const elementName =
            type === 'standard'
              ? 'quick-add-modal'
              : 'quick-add-bulk';


          if (
            typeof customElements !==
            'undefined' &&
            customElements.whenDefined
          ) {

            customElements
              .whenDefined(
                elementName
              )
              .then(
                function () {

                  if (
                    typeof readyModal.show ===
                    'function'
                  ) {

                    readyModal.show(
                      button
                    );

                  }

                }
              );

          } else {

            if (
              typeof readyModal.show ===
              'function'
            ) {

              readyModal.show(
                button
              );

            }

          }

        }
      );

    },
    true
  );


})();
</script>